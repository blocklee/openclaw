      "enabled": true,
      "createdAtMs": 1775556661709,
      "updatedAtMs": 1775700690013,
      "schedule": {
        "kind": "every",
        "everyMs": 7200000,
        "anchorMs": 1775556661709
      },
      "sessionTarget": "isolated",
      "wakeMode": "now",
      "payload": {
        "kind": "agentTurn",
        "message": "运行节点监控脚本 /home/node/.openclaw/workspace-lucus/scripts/node-monitor.js。如果检测到任何异常（Valid=false 或 高度落后 >10 块），立即输出完整报告并发送汇报。如果所有节点正常，直接静默，不发送任何消息。",
        "timeoutSeconds": 30
      },
      "delivery": {
        "mode": "announce",
        "channel": "feishu",

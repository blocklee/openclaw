{
  "version": 1,
  "jobs": [
    {
      "id": "1c3a7bd5-d835-41d8-a14a-d2970f13d503",
      "name": "daily-backup",
      "enabled": true,
      "createdAtMs": 1774507489594,
      "updatedAtMs": 1775554339655,
      "schedule": {
        "kind": "cron",
        "expr": "0 0 * * *",
        "staggerMs": 0
      },
      "sessionTarget": "isolated",
      "wakeMode": "now",
      "payload": {
        "kind": "agentTurn",
        "message": "执行备份：cd ~/.openclaw && git add -A && git commit -m \"auto backup $(date +\\%Y-\\%m-\\%d)\" && git push && echo \"备份完成\""
      },
      "delivery": {
        "mode": "announce",
        "channel": "feishu",
        "to": "user:ou_cb5c7afa7e77cafdeaeae1620a2a383a",
        "accountId": "lucus"
      },
      "state": {
        "nextRunAtMs": 1775606400000,
        "lastRunAtMs": 1775554231479,
        "lastRunStatus": "ok",
        "lastStatus": "ok",
        "lastDurationMs": 108176,
        "lastDeliveryStatus": "delivered",
        "consecutiveErrors": 0,
        "lastDelivered": true
      }
    },
    {
      "id": "config-backup-8am",
      "name": "config-backup-8am",
      "enabled": true,
      "createdAtMs": 1774843680000,
      "updatedAtMs": 1775548814508,
      "schedule": {
        "kind": "cron",
        "expr": "0 8 * * *",
        "staggerMs": 0
      },
      "sessionTarget": "isolated",
      "wakeMode": "now",
      "payload": {
        "kind": "agentTurn",
        "message": "备份 openclaw.json：cp ~/.openclaw/openclaw.json ~/.openclaw/openclaw.json.backup-$(date +%Y%m%d) && echo \"openclaw.json 备份完成 $(date)\""
      },
      "delivery": {
        "mode": "announce",
        "channel": "feishu",
        "to": "user:ou_cb5c7afa7e77cafdeaeae1620a2a383a",
        "accountId": "lucus"
      },
      "state": {

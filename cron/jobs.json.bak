        "message": "请运行节点监控脚本 /home/node/.openclaw/workspace-lucus/scripts/node-monitor.js 并报告结果。如果有异常节点请详细说明。",
        "timeoutSeconds": 60
      },
      "delivery": {
        "mode": "announce",

{"type":"message","id":"8f10a7d9","parentId":"93cdd09f","timestamp":"2026-03-31T17:04:40.978Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"Bindings only route feishu to specific agents. For WeChat, there's no binding so it probably uses the main agent. But the model should still be the default which I set to minimax/MiniMax-M2.7.\n\nWait - maybe the issue is the config wasn't saved correctly or there's a cache. Let me double check the agents.defaults section.","thinkingSignature":"2caa6bff553cb9a89b938e4b797b159df9192eef702eadd2ebf54bae1d13cb9a"},{"type":"toolCall","id":"call_function_nip9wvsal7kb_1","name":"exec","arguments":{"command":"grep -A15 '\"agents\"' /home/node/.openclaw/openclaw.json | head -20"}}],"api":"anthropic-messages","provider":"minimax","model":"MiniMax-M2.7","usage":{"input":65939,"output":118,"cacheRead":11957,"cacheWrite":0,"totalTokens":78014,"cost":{"input":0.0197817,"output":0.0001416,"cacheRead":0.00071742,"cacheWrite":0,"total":0.020640719999999998}},"stopReason":"toolUse","timestamp":1774976675586,"responseId":"061b31a4017674d8a53faf73120a834b"}}

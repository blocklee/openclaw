{"type":"message","id":"b7b762b1","parentId":"5069cb18","timestamp":"2026-03-31T01:37:37.244Z","message":{"role":"toolResult","toolCallId":"call_080c247c6d1e4494b1cb352f","toolName":"exec","content":[{"type":"text","text":"- Searching\nmemos-search  Memos Search  (3.541)\nmemos-cloud-skill  Memos Cloud Server  (3.441)\nmemos-memory-guide  memos-memory-guide  (3.332)\nhuamu668-memos-cloud  MemOS Cloud Integration  (3.301)\nmemos-cli  Memos Cli  (3.285)\nmemos-memory-guide-local  Memos Memory Guide Local  (3.190)\nmemos-memory-guide-andy27725  Memos Memory Guide Andy27725  (3.160)\nmemos  Memos  (3.110)\nusememos  Memos  (2.040)\nusememos-api  UseMemos  (0.810)"}],"details":{"status":"completed","exitCode":0,"durationMs":4581,"aggregated":"- Searching\nmemos-search  Memos Search  (3.541)\nmemos-cloud-skill  Memos Cloud Server  (3.441)\nmemos-memory-guide  memos-memory-guide  (3.332)\nhuamu668-memos-cloud  MemOS Cloud Integration  (3.301)\nmemos-cli  Memos Cli  (3.285)\nmemos-memory-guide-local  Memos Memory Guide Local  (3.190)\nmemos-memory-guide-andy27725  Memos Memory Guide Andy27725  (3.160)\nmemos  Memos  (3.110)\nusememos  Memos  (2.040)\nusememos-api  UseMemos  (0.810)","cwd":"/home/node/.openclaw/workspace-lucus"},"isError":false,"timestamp":1774921057239}}

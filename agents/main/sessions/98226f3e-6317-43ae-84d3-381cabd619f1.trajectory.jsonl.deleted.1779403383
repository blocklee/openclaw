l, or any EVM/blockchain development question.</description>\n    <location>~/.openclaw/workspace/skills/web3-docs/SKILL.md</location>\n  </skill>\n</available_skills>","systemPromptReport":{"source":"run","generatedAt":1779148826073,"sessionId":"98226f3e-6317-43ae-84d3-381cabd619f1","sessionKey":"agent:main:cron:1c3a7bd5-d835-41d8-a14a-d2970f13d503","provider":"nvidia","model":"minimaxai/minimax-m2.7","workspaceDir":"/home/node/.openclaw/workspace","bootstrapMaxChars":12000,"bootstrapTotalMaxChars":60000,"bootstrapTruncation":{"warningMode":"once","warningShown":false,"truncatedFiles":0,"nearLimitFiles":0,"totalNearLimit":false},"sandbox":{"mode":"off","sandboxed":false},"systemPrompt":{"chars":23072,"projectContextChars":4469,"nonProjectContextChars":18603},"injectedWorkspaceFiles":[{"name":"AGENTS.md","path":"/home/node/.openclaw/workspace/AGENTS.md","missing":false,"rawChars":1940,"injectedChars":1940,"truncated":false},{"name":"SOUL.md","path":"/home/node/.openclaw/workspace/SOUL.md","missing":false,"rawChars":461,"injectedChars":461,"truncated":false},{"name":"TOOLS.md","path":"/home/node/.openclaw/workspace/TOOLS.md","missing":false,"rawChars":850,"injectedChars":850,"truncated":false},{"name":"IDENTITY.md","path":"/home/node/.openclaw/workspace/IDENTITY.md","missing":false,"rawChars":200,"injectedChars":200,"truncated":false},{"name":"USER.md","path":"/home/node/.openclaw/workspace/USER.md","missing":false,"rawChars":170,"injectedChars":170,"truncated":false}],"skills":{"promptChars":12407,"entries":[{"name":"Agent Browser","blockChars":312},{"name":"automation-workflows","blockChars":744},{"name":"binance-hunter","blockChars":286},{"name":"Blockchain","blockChars":275},{"name":"EnvGuard Secret &amp; Credential Scanner","blockChars":306},{"name":"explain-code","blockChars":197},{"name":"feishu-doc","blockChars":264},{"name":"feishu-drive","blockChars":256},{"name":"feishu-perm","blockChars":278},{"name":"feishu-wiki","blockChars":258},{"name":"find-skills","
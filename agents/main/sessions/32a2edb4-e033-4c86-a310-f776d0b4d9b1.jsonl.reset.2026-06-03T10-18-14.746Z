nst result = JSON.parse(data);\n        // Find block IDs with many children (likely section headers)\n        const items = result.data.items;\n        const sections = items.filter(b => b.block_type === 4 || b.block_type === 5);\n        sections.forEach(s => {\n          const title = s.heading2?.elements?.map(e=>e.text_run?.content).join('') || s.heading3?.elements?.map(e=>e.text_run?.content).join('') || '';\n          console.log(s.block_id, s.block_type, title, 'children:', (s.children||[]).length);\n        });\n        console.log('---');\n        // Get last few block IDs for pagination hint\n        const lastFew = items.slice(-10);\n        lastFew.forEach(b => {\n          if (b.block_type === 2) {\n            const txt = b.text?.elements?.map(e=>e.text_run?.content).join('') || '';\n            console.log(b.block_id, txt.substring(0,80));\n          }\n        });\n        console.log('HAS_MORE:', result.data.has_more);\n        console.log('NEXT_TOKEN:', result.data.next_page_token);\n      });\n    });\n    docReq.end();\n  });\n});\nreq.write(body);\nreq.end();\n\" 2>/dev/null"}}],"api":"anthropic-messages","provider":"minimax-portal","model":"MiniMax-M2.7-highspeed","usage":{"input":26686,"output":729,"cacheRead":27587,"cacheWrite":0,"totalTokens":55002,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1780416350080,"responseId":"066e325e5ffb745a287bcb602ed81b67"}}

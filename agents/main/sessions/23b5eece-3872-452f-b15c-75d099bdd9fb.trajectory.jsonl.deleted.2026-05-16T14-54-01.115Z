disableModelInvocation":false,"available":true},{"id":"self-improvement","name":"self-improvement","description":"Captures learnings, errors, and corrections to enable continuous improvement. Use when: (1) A command or operation fails unexpectedly, (2) User corrects Claude ('No, that's wrong...', 'Actually...'), (3) User requests a capability that doesn't exist, (4) An external API or tool fails, (5) Claude realizes its knowledge is outdated or incorrect, (6) A better approach is discovered for a recurring task. Also review learnings before major tasks.","filePath":"$OPENCLAW_STATE_DIR/skills/self-improving-agent/SKILL.md","baseDir":"$OPENCLAW_STATE_DIR/skills/self-improving-agent","source":"openclaw-managed","sourceInfo":{"baseDir":"$OPENCLAW_STATE_DIR/skills/self-improving-agent","origin":"top-level","path":"$OPENCLAW_STATE_DIR/skills/self-improving-agent/SKILL.md","scope":"project","source":"openclaw-managed"},"disableModelInvocation":false,"available":true},{"id":"skill-creator","name":"skill-creator","description":"Create, edit, improve, tidy, review, audit, or restructure AgentSkills and SKILL.md files.","filePath":"/app/skills/skill-creator/SKILL.md","baseDir":"/app/skills/skill-creator","source":"openclaw-bundled","sourceInfo":{"baseDir":"/app/skills/skill-creator","origin":"top-level","path":"/app/skills/skill-creator/SKILL.md","scope":"project","source":"openclaw-bundled"},"disableModelInvocation":false,"available":true},{"id":"skill-vetter","name":"skill-vetter","description":"Security-first skill vetting for AI agents. Use before installing any skill from ClawdHub, GitHub, or other sources. Checks for red flags, permission scope, and suspicious patterns.","filePath":"$OPENCLAW_STATE_DIR/skills/skill-vetter/SKILL.md","baseDir":"$OPENCLAW_STATE_DIR/skills/skill-vetter","source":"openclaw-managed","sourceInfo":{"baseDir":"$OPENCLAW_STATE_DIR/skills/skill-vetter","origin":"top-level","path":"$OPENCLAW_STATE_DIR/skills/skill-vetter/SKILL.md","scope":"project"
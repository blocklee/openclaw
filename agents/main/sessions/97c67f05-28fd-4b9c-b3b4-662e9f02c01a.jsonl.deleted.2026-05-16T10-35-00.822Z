namic_dimension_weight_reassessment + gradient_transition\\\", \\\"thread\\\": \\\"arbitration\\\", \\\"description\\\": \\\"动态维度权重重评估 + 梯度过渡期处理\\\", \\\"formula\\\": \\\"weights reassessed at TTU boundary; gradient_transition in WARNING\\\", \\\"status\\\": \\\"verified\\\"},\\n      {\\\"id\\\": 4, \\\"name\\\": \\\"bayesian_convergence_ttu_alignment\\\", \\\"thread\\\": \\\"arbitration\\\", \\\"description\\\": \\\"贝叶斯收敛与 TTU 边界对齐\\\", \\\"formula\\\": \\\"instant_pre_update on emergency confirmation (no TTU wait)\\\", \\\"status\\\": \\\"verified\\\"},\\n      {\\\"id\\\": 5, \\\"name\\\": \\\"warning_prior_strength_correction\\\", \\\"thread\\\": \\\"general\\\", \\\"description\\\": \\\"WARNING 先验强度修正\\\", \\\"formula\\\": \\\"WARNING prior = Beta(1,15) — weakest among three layers\\\", \\\"status\\\": \\\"verified\\\"},\\n      {\\\"id\\\": 6, \\\"name\\\": \\\"dimension_announcement_embedded_in_warning + gradient_warning_format\\\", \\\"thread\\\": \\\"general\\\", \\\"description\\\": \\\"维度公告嵌入 WARNING + 梯度过渡期格式\\\", \\\"formula\\\": \\\"每次 WARNING 内嵌主导维度 + 建议质疑策略 + 过渡期旧/新权重比\\\", \\\"status\\\": \\\"verified\\\"},\\n      {\\\"id\\\": 7, \\\"name\\\": \\\"warning_critical_decoupling\\\", \\\"thread\\\": \\\"general\\\", \\\"description\\\": \\\"WARNING 与 EMERGENCY-CRITICAL 解耦\\\", \\\"formula\\\": \\\"WARNING does not leak EMERGENCY-CRITICAL epoch timing\\\", \\\"status\\\": \\\"verified\\\"},\\n      {\\\"id\\\": 8, \\\"name\\\": \\\"freeze_emergency_independent_layering\\\", \\\"thread\\\": \\\"general\\\", \\\"description\\\": \\\"freeze/emergency 维度独立分层\\\", \\\"formula\\\": \\\"freeze_anchored and emergency_anchored reported independently\\\", \\\"status\\\": \\\"verified\\\"},\\n      {\\\"id\\\": 9, \\\"name\\\": \\\"warning_bayesian_instant_pre_update\\\", \\\"thread\\\": \\\"general\\\", \\\"description\\\": \\\"WARNING 贝叶斯即时预更新\\\", \\\"formula\\\": \\\"prior updated instantly upon emergency confirmation\\\", \\\"status\\\": \\\"verified\\\"},\\
 # fallback: 从 openclaw.json 读取\n        config_path = os.path.expanduser(\"~/.openclaw/openclaw.json\")\n        if os.path.exists(config_path):\n            with open(config_path) as f:\n                config = json.load(f)\n            accounts = config.get(\"channels\", {}).get(\"feishu\", {}).get(\"accounts\", {})\n            main = accounts.get(\"main\", {})\n            app_id = app_id or main.get(\"appId\")\n            app_secret = app_secret or main.get(\"appSecret\")\n    \n    if not app_id or not app_secret:\n        logger.error(\"缺少飞书凭证: 请设置 FEISHU_APP_ID/FEISHU_APP_SECRET 环境变量或在 openclaw.json 中配置\")\n        sys.exit(1)\n    \n    return app_id, app_secret"}],"path":"/home/node/.openclaw/workspace/scripts/send_feishu_mention.py"},"partialArgs":"{\"edits\": [{\"oldText\": \"def getenv_or_fail(key: str) -> str:\\n    \\\"\\\"\\\"获取环境变量，不存在则退出\\\"\\\"\\\"\\n    value = os.environ.get(key)\\n    if not value:\\n        logger.error(f\\\"缺少环境变量: {key}\\\")\\n        sys.exit(1)\\n    return value\\n\\n\\ndef get_app_credentials() -> tuple:\\n    \\\"\\\"\\\"获取飞书应用凭证\\\"\\\"\\\"\\n    app_id = getenv_or_fail(\\\"FEISHU_APP_ID\\\")\\n    app_secret = getenv_or_fail(\\\"FEISHU_APP_SECRET\\\")\\n    return app_id, app_secret\", \"newText\": \"def get_app_credentials() -> tuple:\\n    \\\"\\\"\\\"获取飞书应用凭证（优先环境变量，fallback openclaw.json）\\\"\\\"\\\"\\n    app_id = os.environ.get(\\\"FEISHU_APP_ID\\\")\\n    app_secret = os.environ.get(\\\"FEISHU_APP_SECRET\\\")\\n    \\n    if not app_id or not app_secret:\\n        # fallback: 从 openclaw.json 读取\\n        config_path = os.path.expanduser(\\\"~/.openclaw/openclaw.json\\\")\\n        if os.path.exists(config_path):\\n            with open(config_path) as f:\\n                config = json.load(f)\\n            accounts = config.get(\\\"channels\\\", {}).get(\\\"feishu\\\", {}).get(\\\"accounts\\\", {})\\n            main = accounts.get(\\\"main\\\", {})\\n            app_id = app_id or main.get(\\\"appId\\\")\\
{"type":"message","id":"c4acc636","parentId":"ad2f9f7e","timestamp":"2026-05-23T05:19:32.197Z","message":{"role":"toolResult","toolCallId":"call-b2b39985-622d-4243-8671-51e458aefcd7","toolName":"sessions_list","content":[{"type":"text","text":"{\n  \"count\": 6,\n  \"sessions\": [\n    {\n      \"key\": \"agent:main:feishu:group:oc_76f7651cb976ad84d66158beb2f29be2\",\n      \"agentId\": \"main\",\n      \"kind\": \"group\",\n      \"channel\": \"feishu\",\n      \"origin\": {\n        \"provider\": \"feishu\",\n        \"accountId\": \"main\"\n      },\n      \"displayName\": \"feishu:g-robot-space-多agnet-群聊空间\",\n      \"deliveryContext\": {\n        \"channel\": \"feishu\",\n        \"to\": \"chat:oc_76f7651cb976ad84d66158beb2f29be2\",\n        \"accountId\": \"main\"\n      },\n      \"updatedAt\": 1779513543069,\n      \"sessionId\": \"f5f0ce29-5796-4b43-956f-0c0392e698a1\",\n      \"model\": \"minimaxai/minimax-m2.7\",\n      \"contextTokens\": 200000,\n      \"totalTokens\": 19777,\n      \"status\": \"running\",\n      \"startedAt\": 1779513543064,\n      \"systemSent\": true,\n      \"abortedLastRun\": false,\n      \"lastChannel\": \"feishu\",\n      \"lastTo\": \"chat:oc_76f7651cb976ad84d66158beb2f29be2\",\n      \"lastAccountId\": \"main\",\n      \"transcriptPath\": \"/home/node/.openclaw/agents/main/sessions/f5f0ce29-5796-4b43-956f-0c0392e698a1.jsonl\"\n    },\n    {\n      \"key\": \"agent:wxlee:feishu:xiaoye:direct:ou_9e18438fb941decf11a0b88d78fe2b50\",\n      \"agentId\": \"wxlee\",\n      \"kind\": \"other\",\n      \"channel\": \"feishu\",\n      \"origin\": {\n        \"provider\": \"feishu\",\n        \"accountId\": \"xiaoye\"\n      },\n      \"displayName\": \"ou_9e18438fb941decf11a0b88d78fe2b50\",\n      \"deliveryContext\": {\n        \"channel\": \"feishu\",\n        \"to\": \"user:ou_9e18438fb941decf11a0b88d78fe2b50\",\n        \"accountId\": \"xiaoye\"\n      },\n      \"updatedAt\": 1779513386445,\n      \"sessionId\": \"b7135e7d-495a-42e
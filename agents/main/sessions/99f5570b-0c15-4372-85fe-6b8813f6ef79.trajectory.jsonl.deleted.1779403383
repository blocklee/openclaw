rring task. Also review learnings before major tasks.","filePath":"$OPENCLAW_STATE_DIR/skills/self-improving-agent/SKILL.md","baseDir":"$OPENCLAW_STATE_DIR/skills/self-improving-agent","source":"openclaw-managed","sourceInfo":{"baseDir":"$OPENCLAW_STATE_DIR/skills/self-improving-agent","origin":"top-level","path":"$OPENCLAW_STATE_DIR/skills/self-improving-agent/SKILL.md","scope":"project","source":"openclaw-managed"},"disableModelInvocation":false,"available":true},{"id":"skill-creator","name":"skill-creator","description":"Create, edit, audit, tidy, validate, or restructure AgentSkills and SKILL.md files.","filePath":"/app/skills/skill-creator/SKILL.md","baseDir":"/app/skills/skill-creator","source":"openclaw-bundled","sourceInfo":{"baseDir":"/app/skills/skill-creator","origin":"top-level","path":"/app/skills/skill-creator/SKILL.md","scope":"project","source":"openclaw-bundled"},"disableModelInvocation":false,"available":true},{"id":"skill-vetter","name":"skill-vetter","description":"Security-first skill vetting for AI agents. Use before installing any skill from ClawdHub, GitHub, or other sources. Checks for red flags, permission scope, and suspicious patterns.","filePath":"$OPENCLAW_STATE_DIR/skills/skill-vetter/SKILL.md","baseDir":"$OPENCLAW_STATE_DIR/skills/skill-vetter","source":"openclaw-managed","sourceInfo":{"baseDir":"$OPENCLAW_STATE_DIR/skills/skill-vetter","origin":"top-level","path":"$OPENCLAW_STATE_DIR/skills/skill-vetter/SKILL.md","scope":"project","source":"openclaw-managed"},"disableModelInvocation":false,"available":true},{"id":"Solidity","name":"Solidity","description":"Avoid common Solidity mistakes — reentrancy, gas traps, storage collisions, and security pitfalls.","filePath":"$OPENCLAW_STATE_DIR/workspace/skills/solidity/SKILL.md","baseDir":"$OPENCLAW_STATE_DIR/workspace/skills/solidity","source":"openclaw-workspace","sourceInfo":{"baseDir":"$OPENCLAW_STATE_DIR/workspace/skills/solidity","origin":"top-level","path":"$OPENCLAW_STATE_DIR/workspa
s\"] }` pattern. But looking at the schema, there's no `allowlist` at the top level of `tools`. There's `allow`, `alsoAllow`, `deny`, etc.\n\nWait - let me re-read what the user said: \"升级到新版本5.19后需要为每个agent添加这个嘛：请添加一下 `\"tools\": { \"allowlist\": [\"message\", \"channels\"] }`\"\n\nMaybe they mean something specific to their setup or a specific agent type? Let me check if there's something in the agent config that uses `allowlist`.\n\nActually looking at the schema output I see in `properties.agents.properties.list.items` there's a `tools` section with `allow`, `alsoAllow`, `deny` etc. But no `allowlist` directly.\n\nWait - could they be referring to the `message` tool's action allowlist? Looking at the schema:\n\nIn tools section:\n```\n\"message\": {\n  \"type\": \"object\",\n  \"properties\": {\n    ...\n    \"allowlist\": {\n      \"type\": \"array\",\n      \"items\": { \"type\": \"string\" },\n      \"title\": \"Message Action Allowlist\",\n      \"description\": \"Global message action allowlist for the message tool. Use only when the whole runtime should expose and accept a reduced action set; prefer per-agent allowlists for public or sandboxed agents.\"\n```\n\nAh! So there's a `message` tool with an `allowlist` for actions!\n\nAnd for per-agent:\n```\n\"messageActionAllowlist\": {\n  \"type\": \"array\",\n  \"items\": { \"type\": \"string\" },\n  \"title\": \"Agent Message Action Allowlist\",\n  \"description\": \"Per-agent message action allowlist for the message tool. Set to a minimal list such as [\\\"send\\\"] for public sandbox agents so read, edit, delete, reaction, and other provider-specific message actions stay hidden and blocked.\"\n```\n\nSo the pattern `\"tools\": { \"allowlist\": [\"message\", \"channels\"] }` might be user's shorthand for configuring something like the message tool's action allowlist, or maybe a misunderstanding of the actual schema structure.\n\nLet me look at the full message tool schema to understand what `allowlist` actually controls there.\n","thinkingSignature":"reasoning_content"},{"type":"toolCall","id":"call3762eaf8b6ae4bc1a20fcc885b2c2c92","name":"exec","arguments":{"command":"openclaw config schema 2>/dev/null | python3 -c \"\nimport json,sys\nd=json.load(sys.stdin)\ndef find_message_tool(obj, path=''):\n    if isinstance(obj, dict):\n        if 'message' in obj.get('properties', {}):\n            print(f'Found message at {path}')\n            print(json.dumps(obj['properties']['message'], indent=2)[:3000])\n        for k,v in obj.items():\n            find_message_tool(v, path+'.'+k if path else k)\n    elif isinstance(obj, list) and obj:\n        find_message_tool(obj[0], path)\nfind_message_tool(d)\n\" 2>/dev/null"},"partialArgs":"{\"command\":\"openclaw config schema 2>/dev/null | python3 -c \\\"\\nimport json,sys\\nd=json.load(sys.stdin)\\ndef find_message_tool(obj, path=''):\\n    if isinstance(obj, dict):\\n        if 'message' in obj.get('properties', {}):\\n            print(f'Found message at {path}')\\n            print(json.dumps(obj['properties']['message'], indent=2)[:3000])\\n        for k,v in obj.items():\\n            find_message_tool(v, path+'.'+k if path else k)\\n    elif isinstance(obj, list) and obj:\\n        find_message_tool(obj[0], path)\\nfind_message_tool(d)\\n\\\" 2>/dev/null\"}"}],"api":"openai-completions","provider":"nvidia","model":"minimaxai/minimax-m2.7","usage":{"input":39063,"output":652,"cacheRead":320,"cacheWrite":0,"totalTokens":40035,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1779340642976,"errorMessage":"429 status code (no body)"},{"role":"toolResult","toolCallId":"call3762eaf8b6ae4bc1a20fcc885b2c2c92","toolName":"exec","content":[{"type":"text","text":"Found message at properties.agents.properties.list.items.properties.tools\n{\n  \"type\": \"object\",\n  \"properties\": {\n    \"allowCrossContextSend\": {\n      \"type\": \"boolean\"\n    },\n    \"crossContext\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"allowWithinProvider\": {\n          \"type\": \"boolean\",\n          \"title\": \"Agent Cross-Context Messaging (Same Provider)\",\n          \"description\": \"Per-agent message guard for sending to other conversations on the same provider. Set false for current-conversation-only public agents.\"\n        },\n        \"allowAcrossProviders\": {\n          \"type\": \"boolean\",\n          \"title\": \"Agent Cross-Context Messaging (Across Providers)\",\n          \"description\": \"Per-agent message guard for sending across providers. Keep false for public or sandboxed agents.\"\n        },\n        \"marker\": {\n          \"type\": \"object\",\n          \"properties\": {\n            \"enabled\": {\n              \"type\": \"boolean\"\n            },\n            \"prefix\": {\n              \"type\": \"string\"\n            },\n            \"suffix\": {\n              \"type\": \"string\"\n            }\n          },\n          \"additionalProperties\": false\n        }\n      },\n      \"additionalProperties\": false\n    },\n    \"actions\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"allow\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Agent Message Action Allowlist\",\n          \"description\": \"Per-agent message action allowlist for the message tool. Set to a minimal list such as [\\\"send\\\"] for public sandbox agents so read, edit, delete, reaction, and other provider-specific message actions stay hidden and blocked.\"\n        }\n      },\n      \"additionalProperties\": false\n    },\n    \"broadcast\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"enabled\": {\n          \"type\": \"boolean\"\n        }\n      },\n      \"additionalProperties\": false\n    }\n  },\n  \"additionalProperties\": false\n}\nFound message at properties.tools\n{\n  \"type\": \"object\",\n  \"properties\": {\n    \"allowCrossContextSend\": {\n      \"type\": \"boolean\",\n      \"title\": \"Allow Cross-Context Messaging\",\n      \"description\": \"Legacy override: allow cross-context sends across all providers.\"\n    },\n    \"crossContext\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"allowWithinProvider\": {\n          \"type\": \"boolean\",\n          \"title\": \"Allow Cross-Context (Same Provider)\",\n          \"description\": \"Allow sends to other channels within the same provider (default: true).\"\n        },\n        \"allowAcrossProviders\": {\n          \"type\": \"boolean\",\n          \"title\": \"Allow Cross-Context (Across Providers)\",\n          \"description\": \"Allow sends across different providers (default: false).\"\n        },\n        \"marker\": {\n          \"type\": \"object\",\n          \"properties\": {\n            \"enabled\": {\n              \"type\": \"boolean\",\n              \"title\": \"Cross-Context Marker\",\n              \"description\": \"Add a visible origin marker when sending cross-context (default: true).\"\n            },\n            \"prefix\": {\n              \"type\": \"string\",\n              \"title\": \"Cross-Context Marker Prefix\",\n              \"description\": \"Text prefix for cross-context markers (supports \\\"{channel}\\\").\"\n            },\n            \"suffix\": {\n              \"type\": \"string\",\n              \"title\": \"Cross-Context Marker Suffix\",\n              \"description\": \"Text suffix for cross-context markers (supports \\\"{channel}\\\").\"\n            }\n          },\n          \"additionalProperties\": false\n        }\n      },\n      \"additionalProperties\": false\n    },\n    \"actions\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"allow\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Message Action Allowlist\",\n          \"description\": \"Global message action allowlist for the message tool. Use only when the whole runtime should expose and accept a reduced action set; prefer per-agent allowlists for public or sandboxed agents.\"\n        }\n      },\n      \"additionalProperties\": false\n    },\n    \"broadcast\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"enabled\": {\n          \"type\": \"boolean\",\n          \"title\": \"Enable Message Broadcast\",\n          \"description\": \"Enable broadcast action (default: true).\"\n        }\n      },\n      \"additionalProperties\": false\n    }\n  },\n  \"additionalProperties\": false\n}"}],"isError":false,"timestamp":1779340687571},{"role":"assistant","content":[{"type":"thinking","thinking":"I now have a complete picture. Let me analyze the user's question:\n\nThe user says after upgrading to 5.19, they need to add for each agent:\n```json\n\"tools\": {\n  \"allowlist\": [\"message\", \"channels\"]\n}\n```\n\nBut looking at the schema, there is NO `allowlist` field under `tools` at the agent level. The schema shows:\n- `tools.allow` - Tool Allowlist (replaces profile-derived defaults)\n- `tools.alsoAllow` - Tool Allowlist Additions (additive)\n- `tools.deny` - Tool Denylist\n\nThe user's example uses `allowlist` which doesn't exist. They might be confused with:\n1. `tools.actions.allow` - which is for message actions (like \"send\", \"read\", etc.)\n2. The per-agent `tools` structure has `actions.allow` for message action allowlisting\n\nOr they might be thinking of a different structure entirely. Let me re-read their question. They said:\n\"请添加一下\" (please add this) - `\"tools\": { \"allowlist\": [\"message\", \"channels\"] }`\n\nThis is confusing because `message` and `channels` are not tool names - they're more like groups or action categories. Looking at the schema more carefully:\n\n- `group:messaging` is a tool group that contains `message`\n- There is no `channels` tool or group\n\nActually wait - maybe they're talking about something else entirely. Let me think about what \"channels\" could be... In some contexts, \"channels\" might refer to the messaging channels concept.\n\nBut actually I think the user might have received some guidance or documentation that mentioned adding something specific, and they're asking me if this is correct. Since I don't have context about where this recommendation came from, I should:\n\n1. Clarify that the schema doesn't have an `allowlist` field directly under `tools`\n2. Show what the actual structure looks like\n3. Ask for clarification on what they're trying to achieve\n\n\n4. The schema simply doesn't support a direct `allowlist` field within `tools` at the agent level, so either this is a misunderstanding or referring to something else entirely\n","thinkingSignature":"reasoning_content"},{"type":"text","text":"\n\n根据我对 OpenClaw 5.19 配置 schema 的检查，**每个 agent 添加 `tools.allowlist` 这种写法在当前版本不是有效配置**。\n\n让我解释一下实际情况：\n\n## 5.19 的 Agent Tools 配置结构\n\n每个 agent 的 `tools` 配置支持以下字段（来自 schema）：\n\n```json5\n{\n  // Agent 级别 tools 配置\n  \"profile\": \"coding\",           // minimal | coding | messaging | full\n  \"allow\": [\"message\"],           // 绝对允许列表（替换 profile 默认）\n  \"alsoAllow\": [\"message\"],       // 在 profile 基础上额外允许\n  \"deny\": [],                    // 禁用列表\n  \"actions\": {                   // message 工具的操作白名单\n    \"allow\": [\"send\"]             // 如 [\"send\"] 表示只允许发消息\n  },\n  \"crossContext\": { ... }         // 跨会话发消息控制\n}\n```\n\n## 关键点\n\n1. **没有 `allowlist` 字段** — 正确字段名是 `allow`（绝对允许）或 `alsoAllow`（附加允许）\n2. **`message` 是工具名**，`channels` 不是有效的工具或组名\n3. **如果你想让 agent 使用 `message` 工具**，正确写法是：\n   ```json5\n   {\n     \"agents\": {\n       \"list\": [{\n         \"id\": \"your-agent\",\n         \"tools\": {\n           \"alsoAllow\": [\"message\"]\n         }\n       }]\n     }\n   }\n   ```\n\n## 你遇到的情况\n\n你提到需要为每个 agent 添加：\n```json\n\"tools\": {\n  \"allowlist\": [\"message\", \"channels\"]\n}\n```\n\n这个 `allowlist` 写法**不是 5.19 的有效配置**。可能来源：\n- 旧版本的写法（如果有的话）\n- 第三方文档或 AI 生成的错误建议\n- 或者你记错了具体内容？\n\n**你能否确认这个配置是来自哪里（文档/升级指南/AI建议）？** 这样我可以帮你判断是否需要替代方案，或者这是一个需要报告的问题。"}],"api":"openai-completions","provider":"nvidia","model":"minimaxai/minimax-m2.7","usage":{"input":40413,"output":884,"cacheRead":96,"cacheWrite":0,"totalTokens":41393,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"stop","timestamp":1779340687578,"responseId":"chatcmpl-9ab9b0c0-0ba4-469a-9340-52e36df175cf"},{"role":"user","content":[{"type":"text","text":"Conversation info (untrusted metadata):\n```json\n{\n  \"chat_id\": \"user:ou_f786171f9e21bf5a09c3116b2e77aaff\",\n  \"message_id\": \"om_x100b6fdd2aa164a8c27f9b6594d921b\",\n  \"sender_id\": \"ou_f786171f9e21bf5a09c3116b2e77aaff\",\n  \"sender\": \"ou_f786171f9e21bf5a09c3116b2e77aaff\",\n  \"timestamp\": \"Thu 2026-05-21 05:21 UTC\"\n}\n```\n\nSender (untrusted metadata):\n```json\n{\n  \"label\": \"ou_f786171f9e21bf5a09c3116b2e77aaff\",\n  \"id\": \"ou_f786171f9e21bf5a09c3116b2e77aaff\",\n  \"name\": \"ou_f786171f9e21bf5a09c3116b2e77aaff\"\n}\n```\n\n[message_id: om_x100b6fdd2aa164a8c27f9b6594d921b]\nou_f786171f9e21bf5a09c3116b2e77aaff: 升级到新版本5.19后需要为每个agent添加这个嘛：\n\"tools\": {\n \"allowlist\": [\"message\", \"channels\"]\n }"}],"timestamp":1779340873721},{"role":"assistant","content":[{"type":"text","text":"I've analyzed the OpenClaw 5.19 configuration schema and can confirm that **the configuration format you mentioned is not valid**.\n\n## What's Wrong with Your Example\n\n```json\n\"tools\": {\n  \"allowlist\": [\"message\", \"channels\"]\n}\n```\n\nThis syntax doesn't match the 5.19 schema because:\n\n1. ❌ **No `allowlist` field** — The correct field names are:\n   - `allow` - absolute allowlist (replaces profile defaults)\n   - `alsoAllow` - additive allowlist (adds to profile defaults)\n   - `deny` - denylist\n\n2. ❌ **`channels` is not a valid tool** — There's no tool called \"channels\". The tool you probably want is `message`.\n\n## Correct Configuration\n\nIf you want to allow the `message` tool for an agent:\n\n```json5\n{\n  \"agents\": {\n    \"list\": [\n      {\n        \"id\": \"your-agent-id\",\n        \"tools\": {\n          \"alsoAllow\": [\"message\"]\n        }\n      }\n    ]\n  }\n}\n```\n\nOr if you want to restrict to ONLY the `message` tool (using `allow` instead of `alsoAllow`):\n\n```json5\n{\n  \"agents\": {\n    \"list\": [\n      {\n        \"id\": \"your-agent-id\",\n        \"tools\": {\n          \"profile\": \"minimal\",  // optional: base profile\n          \"allow\": [\"message\"]\n        }\n      }\n    ]\n  }\n}\n```\n\n## If You're Seeing This in Documentation\n\nThis configuration pattern might be:\n- From an older version (before 5.19)\n- From a third-party guide or AI-generated suggestion\n- A misunderstanding of the field names\n\n**Could you share where you saw this configuration?** I can then help verify if it's outdated or if there's a specific use case I'm missing."}],"api":"openai-completions","provider":"zai","model":"glm-4.7-flash","usage":{"input":38175,"output":396,"cacheRead":4058,"cacheWrite":0,"totalTokens":42629,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"stop","timestamp":1779340873781,"responseId":"2026052113211446a118c5605c4d2a"},{"role":"user","content":[{"type":"text","text":"Conversation info (untrusted metadata):\n```json\n{\n  \"chat_id\": \"user:ou_f786171f9e21bf5a09c3116b2e77aaff\",\n  \"message_id\": \"om_x100b6fdd253cf4acc2e90535772b97f\",\n  \"sender_id\": \"ou_f786171f9e21bf5a09c3116b2e77aaff\",\n  \"sender\": \"ou_f786171f9e21bf5a09c3116b2e77aaff\",\n  \"timestamp\": \"Thu 2026-05-21 05:23 UTC\"\n}\n```\n\nSender (untrusted metadata):\n```json\n{\n  \"label\": \"ou_f786171f9e21bf5a09c3116b2e77aaff\",\n  \"id\": \"ou_f786171f9e21bf5a09c3116b2e77aaff\",\n  \"name\": \"ou_f786171f9e21bf5a09c3116b2e77aaff\"\n}\n```\n\n[message_id: om_x100b6fdd253cf4acc2e90535772b97f]\nou_f786171f9e21bf5a09c3116b2e77aaff: 那你给我修正一下，然后中文回复"}],"timestamp":1779340993625},{"role":"assistant","content":[{"type":"text","text":"好的，我来帮你修正这个配置。\n\n## 问题分析\n\n你提到的配置：\n```json\n\"tools\": {\n  \"allowlist\": [\"message\", \"channels\"]\n}\n```\n\n**错误原因：**\n1. ❌ 字段名是 `allowlist`，但正确字段名是 `allow` 或 `alsoAllow`\n2. ❌ `channels` 不是有效的工具名\n3. ❌ 应该是 `message` 工具\n\n## 正确的配置方式\n\n### 方式 1：添加 message 工具（推荐）\n```json5\n{\n  \"agents\": {\n    \"list\": [\n      {\n        \"id\": \"your-agent-id\",\n        \"tools\": {\n          \"alsoAllow\": [\"message\"]\n        }\n      }\n    ]\n  }\n}\n```\n\n### 方式 2：只允许 message 工具（严格模式）\n```json5\n{\n  \"agents\": {\n    \"list\": [\n      {\n        \"id\": \"your-agent-id\",\n        \"tools\": {\n          \"profile\": \"minimal\",\n          \"allow\": [\"message\"]\n        }\n      }\n    ]\n  }\n}\n```\n\n### 方式 3：如果需要 message 的特定操作（如只允许发送）\n```json5\n{\n  \"agents\": {\n    \"list\": [\n      {\n        \"id\": \"your-agent-id\",\n        \"tools\": {\n          \"alsoAllow\": [\"message\"],\n          \"actions\": {\n            \"allow\": [\"send\"]  // 只允许发送操作\n          }\n        }\n      }\n    ]\n  }\n}\n```\n\n## 完整示例\n\n如果你有多个 agent，可以这样配置：\n\n```json5\n{\n  \"agents\": {\n    \"list\": [\n      {\n        \"id\": \"assistant\",\n        \"tools\": {\n          \"alsoAllow\": [\"message\"]\n        }\n      },\n      {\n        \"id\": \"coder\",\n        \"tools\": {\n          \"profile\": \"coding\",\n          \"allow\": [\"message\"]\n        }\n      },\n      {\n        \"id\": \"messenger\",\n        \"tools\": {\n          \"profile\": \"messaging\",\n          \"alsoAllow\": [\"message\"]\n        }\n      }\n    ]\n  }\n}\n```\n\n**需要我帮你直接修改 `~/.openclaw/openclaw.json` 文件吗？** 如果是的话，请告诉我：\n1. 你要修改哪个 agent 的配置\n2. 你希望这个 agent 有什么权限（只是允许 message，还是需要 coding、fs 等工具）"}],"api":"openai-completions","provider":"zai","model":"glm-4.7-flash","usage":{"input":42618,"output":519,"cacheRead":42,"cacheWrite":0,"totalTokens":43179,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"stop","timestamp":1779340993679,"responseId":"202605211323146a65f58125a14a65"},{"role":"user","content":[{"type":"text","text":"Conversation info (untrusted metadata):\n```json\n{\n  \"chat_id\": \"user:ou_f786171f9e21bf5a09c3116b2e77aaff\",\n  \"message_id\": \"om_x100b6fddf559d0a8c211a9854afe815\",\n  \"sender_id\": \"ou_f786171f9e21bf5a09c3116b2e77aaff\",\n  \"sender\": \"ou_f786171f9e21bf5a09c3116b2e77aaff\",\n  \"timestamp\": \"Thu 2026-05-21 05:44 UTC\"\n}\n```\n\nSender (untrusted metadata):\n```json\n{\n  \"label\": \"ou_f786171f9e21bf5a09c3116b2e77aaff\",\n  \"id\": \"ou_f786171f9e21bf5a09c3116b2e77aaff\",\n  \"name\": \"ou_f786171f9e21bf5a09c3116b2e77aaff\"\n}\n```\n\n[message_id: om_x100b6fddf559d0a8c211a9854afe815]\nou_f786171f9e21bf5a09c3116b2e77aaff: 为什么需要这么配置呢"}],"timestamp":1779342268141},{"role":"assistant","content":[{"type":"text","text":"好问题！让我解释一下为什么需要这么配置，以及它的作用。\n\n## 为什么需要配置 tools？\n\n### 1. **安全隔离（沙箱机制）**\n\nOpenClaw 默认会限制 agent 能使用的工具，防止 agent 执行危险操作：\n\n```json5\n{\n  \"agents\": {\n    \"list\": [\n      {\n        \"id\": \"messenger\",\n        \"tools\": {\n          \"profile\": \"messaging\"  // 只允许 messaging 相关工具\n        }\n      },\n      {\n        \"id\": \"coder\",\n        \"tools\": {\n          \"profile\": \"coding\"     // 允许 coding 相关工具（fs、exec、web 等）\n        }\n      }\n    ]\n  }\n}\n```\n\n### 2. **不同 agent 有不同权限**\n\n想象一下你有很多不同的 agent：\n\n| Agent 类型 | 需要的权限 | tools 配置示例 |\n|-----------|-----------|----------------|\n| **消息助手** | 发送/读取消息 | `profile: \"messaging\"` |\n| **代码助手** | 读写文件、执行命令、搜索网络 | `profile: \"coding\"` |\n| **查询助手** | 只能搜索、读取内存 | `profile: \"minimal\"` |\n| **管理助手** | 所有权限（需要谨慎） | `profile: \"full\"` 或不配置 |\n\n### 3. **细粒度控制**\n\n你可以更精确地控制工具使用：\n\n```json5\n{\n  \"agents\": {\n    \"list\": [\n      {\n        \"id\": \"strict-coder\",\n        \"tools\": {\n          \"allow\": [\"read\", \"write\", \"edit\"],  // 只允许读写文件\n          \"deny\": [\"exec\", \"process\", \"web_search\"]  // 禁用危险操作\n        }\n      }\n    ]\n  }\n}\n```\n\n### 4. **按 provider 限制**\n\n不同渠道的 agent 可以有不同的权限：\n\n```json5\n{\n  \"tools\": {\n    \"byProvider\": {\n      \"feishu\": {\n        \"allow\": [\"message\"]  // 飞书渠道的 agent 只能发消息\n      },\n      \"discord\": {\n        \"allow\": [\"message\", \"web_search\"]  // Discord 的 agent 可以搜索\n      }\n    }\n  }\n}\n```\n\n## 如果不配置会怎样？\n\n### 默认行为\n\n如果你不配置 `tools`，agent 会使用**默认策略**：\n\n```json5\n{\n  \"agents\": {\n    \"defaults\": {\n      \"tools\": {\n        \"profile\": \"coding\"  // 默认是 coding profile\n      }\n    }\n  }\n}\n```\n\n### 默认 profile 包含的工具\n\n| Profile | 包含的工具 |\n|---------|-----------|\n| `minimal` | 只有 `session_status` |\n| `coding` | `group:fs`, `group:runtime`, `group:web`, `group:sessions`, `group:memory`, `cron`, `image`, `image_generate`, `video_generate` |\n| `messaging` | `group:messaging`, `sessions_list`, `sessions_history`, `sessions_send`, `session_status` |\n| `full` | 无限制（所有工具） |\n\n## 实际场景举例\n\n### 场景 1：公共群聊机器人\n```json5\n{\n  \"id\": \"public-bot\",\n  \"tools\": {\n    \"alsoAllow\": [\"message\"]  // 只能发消息，不能改文件或执行命令\n  }\n}\n```\n\n### 场景 2：本地开发助手\n```json5\n{\n  \"id\": \"dev-assistant\",\n  \"tools\": {\n    \"profile\": \"coding\"  // 完整的 coding 能力\n  }\n}\n```\n\n### 场景 3：只读查询助手\n```json5\n{\n  \"id\": \"query-bot\",\n  \"tools\": {\n    \"allow\": [\"web_search\", \"memory_search\", \"memory_get\"]  // 只能查询\n  }\n}\n```\n\n## 总结\n\n**为什么需要配置？**\n\n1. ✅ **安全**：防止 agent 误操作危险工具（如 `exec`、`process`）\n2. ✅ **权限隔离**：不同 agent 有不同能力\n3. ✅ **灵活性**：可以精细控制每个工具的权限\n4. ✅ **合规性**：符合最小权限原则\n\n**如果你有多个 agent，建议：**\n- 公共/消息类 agent → `profile: \"messaging\"` 或 `allow: [\"message\"]`\n- 开发类 agent → `profile: \"coding\"`\n- 查询类 agent → `profile: \"minimal\"`\n- 管理/管理员 agent → `profile: \"full\"` 或自定义\n\n**需要我帮你根据你的具体需求设计配置吗？**"}],"api":"openai-completions","provider":"zai","model":"glm-4.7-flash","usage":{"input":43193,"output":1002,"cacheRead":42,"cacheWrite":0,"totalTokens":44237,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"stop","timestamp":1779342268204,"responseId":"202605211344294246887744c74c94"},{"role":"user","content":[{"type":"text","text":"Conversation info (untrusted metadata):\n```json\n{\n  \"chat_id\": \"user:ou_f786171f9e21bf5a09c3116b2e77aaff\",\n  \"message_id\": \"om_x100b6fdd9fb56ca0c42d100f8d7c16c\",\n  \"sender_id\": \"ou_f786171f9e21bf5a09c3116b2e77aaff\",\n  \"sender\": \"ou_f786171f9e21bf5a09c3116b2e77aaff\",\n  \"timestamp\": \"Thu 2026-05-21 05:50 UTC\"\n}\n```\n\nSender (untrusted metadata):\n```json\n{\n  \"label\": \"ou_f786171f9e21bf5a09c3116b2e77aaff\",\n  \"id\": \"ou_f786171f9e21bf5a09c3116b2e77aaff\",\n  \"name\": \"ou_f786171f9e21bf5a09c3116b2e77aaff\"\n}\n```\n\n[message_id: om_x100b6fdd9fb56ca0c42d100f8d7c16c]\nou_f786171f9e21bf5a09c3116b2e77aaff: \"tools\": {\n \"profile\": \"coding\",\n \"agentToAgent\": {\n \"enabled\": true,\n \"allow\": [\n \"main\",\n \"lucus\",\n \"codus\",\n \"wxlee\"\n ]\n },\n \"sessions\": {\n \"visibility\": \"all\"\n },\n \"web\": {\n \"search\": {\n \"enabled\": true,\n \"provider\": \"duckduckgo\"\n }\n },\n \"subagents\": {\n \"tools\": {\n \"allow\": [\n \"read\",\n \"write\",\n \"exec\",\n \"process\"\n ]\n }\n }\n },\n原来的老版本中这个配置还有效吧，"}],"timestamp":1779342619255},{"truncated":true,"reason":"trajectory-array-size-limit","originalLength":69,"limitItems":64}],"tools":[{"name":"cron","description":"Manage Gateway cron jobs and wake events: reminders, check-back-later, delayed follow-ups, recurring work. Do not emulate scheduling with exec sleep/process polling.\n\nMain cron => system events for heartbeat. Isolated cron => background task in `openclaw tasks`.\n\nACTIONS:\n- status: scheduler status\n- list: jobs; includeDisabled true includes disabled; agentId filter auto-filled from session\n- get: one job; needs jobId\n- add: create job; needs job object\n- update: patch job; needs jobId + patch\n- remove: delete job; needs jobId\n- run: trigger now; needs jobId\n- runs: run history; needs jobId\n- wake: send wake event; needs text, optional mode\n\nJOB SCHEMA (for add action):\n{\n  \"name\": \"string\",\n  \"schedule\": { ... },      // required\n  \"payload\": { ... },       // required\n  \"delivery\": { ... },      // optional announce for isolated/current/session, webhook for any target\n  \"sessionTarget\": \"main\" | \"isolated\" | \"current\" | \"session:<id>\",\n  \"enabled\": true | false   // default true\n}\n\nSESSION TARGET OPTIONS:\n- \"main\": main session; requires payload.kind=\"systemEvent\"\n- \"isolated\": ephemeral isolated session; requires payload.kind=\"agentTurn\"\n- \"current\": bind current session at creation\n- \"session:<id>\": persistent named session\n\nDEFAULTS:\n- payload.kind=\"systemEvent\" → defaults to \"main\"\n- payload.kind=\"agentTurn\" → defaults to \"isolated\"\nCurrent binding needs sessionTarget=\"current\".\n\nSCHEDULE TYPES (schedule.kind):\n- \"at\": one-shot absolute time\n  { \"kind\": \"at\", \"at\": \"<ISO-8601 timestamp>\" }\n- \"every\": recurring interval\n  { \"kind\": \"every\", \"everyMs\": <ms>, \"anchorMs\": <optional-ms> }\n- \"cron\": expr in supplied timezone, or Gateway host local timezone when tz omitted\n  { \"kind\": \"cron\", \"expr\": \"<cron-expression>\", \"tz\": \"<optional-IANA-timezone>\" }\n  Write expr in local wall-clock time; do not convert the requested local time to UTC first.\n  tz omitted => Gateway host local timezone, not UTC.\n  Example 6pm Shanghai daily: { \"kind\": \"cron\", \"expr\": \"0 18 * * *\", \"tz\": \"Asia/Shanghai\" }\n\nFor \"at\", ISO timestamps without timezone are UTC.\n\nPAYLOAD TYPES (payload.kind):\n- \"systemEvent\": inject text as system event\n  { \"kind\": \"systemEvent\", \"text\": \"<message>\" }\n- \"agentTurn\": run agent with prompt; isolated/current/session only\n  { \"kind\": \"agentTurn\", \"message\": \"<prompt>\", \"model\": \"<optional>\", \"thinking\": \"<optional>\", \"timeoutSeconds\": <optional, 0=no timeout> }\n\nDELIVERY (top-level):\n  { \"mode\": \"none|announce|webhook\", \"channel\": \"<optional>\", \"to\": \"<optional>\", \"threadId\": \"<optional>\", \"bestEffort\": <optional-bool> }\n  - isolated agentTurn default when omitted: \"announce\"\n  - announce: send to chat channel; isolated/current/session only; optional channel/to\n  - threadId: chat thread/topic id\n  - webhook: POST finished-run event to delivery.to URL\n  - Specific chat/recipient: set announce delivery.channel/to; do not call messaging tools inside run.\n\nCRITICAL CONSTRAINTS:\n- sessionTarget=\"main\" REQUIRES payload.kind=\"systemEvent\"\n- sessionTarget=\"isolated\" | \"current\" | \"session:xxx\" REQUIRES payload.kind=\"agentTurn\"\n- Webhook: delivery.mode=\"webhook\" and delivery.to URL.\nDefault: prefer isolated agentTurn jobs unless the user explicitly wants current-session binding.\n\nRESTRICTED CRON RUNS:\n- Some isolated cron runs get narrow self-cleanup grant: status/list self-only, get/runs current job only, mutation only remove current job.\n\nWAKE MODES (for wake action):\n- \"next-heartbeat\" default: wake next heartbeat\n- \"now\": wake immediately\n\nUse jobId canonical; id accepted compat. contextMessages (0-10) adds previous messages as job context.","parameters":{"type":"object","required":["action"],"properties":{"action":{"type":"string","enum":{"truncated":true,"reason":"trajectory-depth-limit","limitDepth":6}},"gatewayUrl":{"type":"string"},"timeoutMs":{"type":"number"},"includeDisabled":{"type":"boolean"},"job":{"type":"object","properties":{"truncated":true,"reason":"trajectory-depth-limit","limitDepth":6},"additionalProperties":true},"jobId":{"type":"string"},"id":{"type":"string"},"patch":{"type":"object","properties":{"truncated":true,"reason":"trajectory-depth-limit","limitDepth":6},"additionalProperties":true},"text":{"type":"string"},"mode":{"type":"string","enum":{"truncated":true,"reason":"trajectory-depth-limit","limitDepth":6}},"runMode":{"type":"string","enum":{"truncated":true,"reason":"trajectory-depth-limit","limitDepth":6}},"contextMessages":{"type":"number","minimum":0,"maximum":10},"agentId":{"type":"string","description":"List filter: agent id"}},"additionalProperties":true}},{"name":"edit","description":"Edit a single file using exact text replacement. Every edits[].oldText must match a unique, non-overlapping region of the original file. If two changes affect the same block or nearby lines, merge them into one edit instead of emitting overlapping edits. Do not include large unchanged regions just to connect distant changes.","parameters":{"type":"object","required":["path","edits"],"properties":{"path":{"type":"string","description":"Path to the file to edit (relative or absolute)"},"edits":{"type":"array","items":{"truncated":true,"reason":"trajectory-depth-limit","limitDepth":6},"description":"One or more targeted replacements. Each edit is matched against the original file, not incrementally. Do not include overlapping or nested edits. If two changes touch the same block or nearby lines, merge them into one edit instead."}},"additionalProperties":false}},{"name":"exec","description":"Execute shell commands with background continuation for work that starts now. Use yieldMs/background to continue later via process tool. For long-running work started now, rely on automatic completion wake when it is enabled and the command emits output or fails; otherwise use process to confirm completion. Use process whenever you need logs, status, input, or intervention. Do not use exec sleep or delay loops for reminders or deferred follow-ups; use cron instead. Use pty=true for TTY-required commands (terminal UIs, coding agents).","parameters":{"type":"object","required":["command"],"properties":{"command":{"type":"string","description":"Shell command to execute"},"workdir":{"type":"string","description":"Working directory (defaults to cwd)"},"env":{"type":"object","patternProperties":{"truncated":true,"reason":"trajectory-depth-limit","limitDepth":6}},"yieldMs":{"type":"number","description":"Milliseconds to wait before backgrounding (default 10000)"},"background":{"type":"boolean","description":"Run in background immediately"},"timeout":{"type":"number","description":"Timeout in seconds (optional, kills process on expiry)"},"pty":{"type":"boolean","description":"Run in a pseudo-terminal (PTY) when available (TTY-required CLIs, coding agents)"},"elevated":{"type":"boolean","description":"Run on the host with elevated permissions (if allowed)"},"host":{"type":"string","enum":{"truncated":true,"reason":"trajectory-depth-limit","limitDepth":6},"description":"Exec host/target (auto|sandbox|gateway|node)."},"security":{"type":"string","description":"Ignored for normal calls; exec security is set by tools.exec.security and host approvals."},"ask":{"type":"string","description":"Exec ask mode (off|on-miss|always)."},"node":{"type":"string","description":"Node id/name for host=node."}}}},{"name":"image","description":"Analyze images with available vision model. Use image for one path/URL, images for max 20. Prompt says what to inspect.","parameters":{"type":"object","properties":{"prompt":{"type":"string"},"image":{"type":"string","description":"One image path/URL."},"images":{"type":"array","items":{"truncated":true,"reason":"trajectory-depth-limit","limitDepth":6},"description":"Image paths/URLs; maxImages default 20."},"model":{"type":"string"},"maxBytesMb":{"type":"number"},"maxImages":{"type":"number"}}}},{"name":"image_generate","description":"Create/edit images. Session chats: background task; do not call image_generate again for same request; wait completion, then send attachments via message tool. Transparent: outputFormat=\"png\" or \"webp\" + background=\"transparent\"; OpenAI also supports openai.background and routes default model to gpt-image-1.5. Use action=\"list\" for providers/models/readiness/auth, \"status\" for active task.","parameters":{"type":"object","properties":{"action":{"type":"string","description":"\"generate\" default, \"status\" active task, \"list\" providers/models."},"prompt":{"type":"string","description":"Image prompt."},"image":{"type":"string","description":"Reference image path/URL for edit."},"images":{"type":"array","items":{"truncated":true,"reason":"trajectory-depth-limit","limitDepth":6},"description":"Reference images for edit; max 5."},"model":{"type":"string","description":"Provider/model override, e.g. openai/gpt-image-2; transparent OpenAI: openai/gpt-image-1.5."},"filename":{"type":"string","description":"Output filename hint; basename preserved in managed media dir."},"size":{"type":"string","description":"Size hint: 1024x1024, 1536x1024, 1024x1536, 2048x2048, 3840x2160."},"aspectRatio":{"type":"string","description":"Aspect ratio: 1:1, 2:3, 3:2, 3:4, 4:3, 4:5, 5:4, 9:16, 16:9, 21:9."},"resolution":{"type":"string","description":"Resolution: 1K, 2K, 4K; useful for Google."},"quality":{"type":"string","enum":{"truncated":true,"reason":"trajectory-depth-limit","limitDepth":6},"description":"Quality: low, medium, high, auto."},"outputFormat":{"type":"string","enum":{"truncated":true,"reason":"trajectory-depth-limit","limitDepth":6},"description":"Output format: png, jpeg, webp."},"background":{"type":"string","enum":{"truncated":true,"reason":"trajectory-depth-limit","limitDepth":6},"description":"Background: transparent, opaque, auto. Transparent needs png/webp output."},"openai":{"type":"object","properties":{"truncated":true,"reason":"trajectory-depth-limit","limitDepth":6}},"count":{"type":"number","description":"Image count 1-4.","minimum":1,"maximum":4},"timeoutMs":{"type":"number","description":"Provider timeout ms.","minimum":1}}}},{"name":"memory_get","description":"Safe exact excerpt read from MEMORY.md or memory/*.md. Defaults to a bounded excerpt when lines are omitted, includes truncation/continuation info when more content exists, and `corpus=wiki` reads from registered compiled-wiki supplements.","parameters":{"type":"object","properties":{"path":{"type":"string"},"from":{"type":"number"},"lines":{"type":"number"},"corpus":{"type":"string","enum":{"truncated":true,"reason":"trajectory-depth-limit","limitDepth":6}}},"required":["path"],"additionalProperties":false}},{"name":"memory_search","description":"Mandatory recall step: semantically search MEMORY.md + memory/*.md (and optional session transcripts) before answering questions about prior work, decisions, dates, people, preferences, or todos. Optional `corpus=wiki` or `corpus=all` also searches registered compiled-wiki supplements. `corpus=memory` restricts hits to indexed memory files (excludes session transcript chunks from ranking). `corpus=sessions` restricts hits to indexed session transcripts (same visibility rules as session history tools). If response has disabled=true, memory retrieval is unavailable and should be surfaced to the user.","parameters":{"type":"object","properties":{"query":{"type":"string"},"maxResults":{"type":"number"},"minScore":{"type":"number"},"corpus":{"type":"string","enum":{"truncated":true,"reason":"trajectory-depth-limit","limitDepth":6}}},"required":["query"],"additionalProperties":false}},{"name":"music_generate","description":"Create audio/music for song, jingle, beat, loop, soundtrack, anthem, instrumental requests. If user asks make/generate/create song/music, call music_generate; do not just write lyrics unless lyrics/text only. Prompt gets style/genre/mood/tempo/instruments/purpose. lyrics only exact sung words. Session chats: background task; do not call again for same request; wait completion, send attachments via message tool. \"status\" checks active task.","parameters":{"type":"object","properties":{"action":{"type":"string","description":"\"generate\" default, \"status\" active task, \"list\" providers/models."},"prompt":{"type":"string","description":"Music prompt: style, genre, mood, purpose."},"lyrics":{"type":"string","description":"Exact sung lyrics only when the user supplies lyrics or asks for vocal words. For song/style requests, use prompt instead."},"instrumental":{"type":"boolean","description":"Instrumental-only toggle."},"image":{"type":"string","description":"Reference image path/URL."},"images":{"type":"array","items":{"truncated":true,"reason":"trajectory-depth-limit","limitDepth":6},"description":"Reference images; max 10."},"model":{"type":"string","description":"Provider/model override, e.g. google/lyria-3-pro-preview."},"durationSeconds":{"type":"number","description":"Target seconds; provider may clamp.","minimum":1},"format":{"type":"string","description":"Output format: mp3, wav."},"filename":{"type":"string","description":"Output filename hint; basename preserved in managed media dir."}}}},{"name":"process","description":"Manage running exec sessions for commands already started: list, poll, log, write, send-keys, submit, paste, kill. Use poll/log when you need status, logs, quiet-success confirmation, or completion confirmation when automatic completion wake is unavailable. Use poll/log also for input-wait hints. Use write/send-keys/submit/paste/kill for input or intervention. Do not use process polling to emulate timers or reminders; use cron for scheduled follow-ups.","parameters":{"type":"object","required":["action"],"properties":{"action":{"type":"string","description":"Process action (list|poll|log|write|send-keys|submit|paste|kill|clear|remove)"},"sessionId":{"type":"string","description":"Session id for actions other than list"},"data":{"type":"string","description":"Data to write for write"},"keys":{"type":"array","items":{"truncated":true,"reason":"trajectory-depth-limit","limitDepth":6},"description":"Key tokens to send for send-keys"},"hex":{"type":"array","items":{"truncated":true,"reason":"trajectory-depth-limit","limitDepth":6},"description":"Hex bytes to send for send-keys"},"literal":{"type":"string","description":"Literal string for send-keys"},"text":{"type":"string","description":"Text to paste for paste"},"bracketed":{"type":"boolean","description":"Wrap paste in bracketed mode"},"eof":{"type":"boolean","description":"Close stdin after write"},"offset":{"type":"number","description":"Log offset"},"limit":{"type":"number","description":"Log length"},"timeout":{"type":"number","description":"For poll: wait up to this many milliseconds before returning; max 30000 ms, higher values are clamped to 30000","minimum":0}}}},{"name":"read","description":"Read the contents of a file. Supports text files and images (jpg, png, gif, webp). Images are sent as attachments. For text files, output is truncated to 2000 lines or 50KB (whichever is hit first). Use offset/limit for large files. When you need the full file, continue with offset until complete.","parameters":{"type":"object","required":["path"],"properties":{"path":{"type":"string","description":"Path to the file to read (relative or absolute)"},"offset":{"type":"number","description":"Line number to start reading from (1-indexed)"},"limit":{"type":"number","description":"Maximum number of lines to read"}}}},{"name":"session_status","description":"Show /status-like card for current/visible session: model, usage, time, cost, tasks. Use `sessionKey=\"current\"` for current session; UI labels like `openclaw-tui` are not keys. `model` sets session override; `model=default` resets. Use for active model/session config questions.","parameters":{"type":"object","properties":{"sessionKey":{"type":"string"},"model":{"type":"string"}}}},{"name":"sessions_history","description":"Fetch sanitized history for visible session. Use before replying, debugging, resuming; supports limits/tool messages.","parameters":{"type":"object","required":["sessionKey"],"properties":{"sessionKey":{"type":"string"},"limit":{"type":"number","minimum":1},"includeTools":{"type":"boolean"}}}},{"name":"sessions_list","description":"List visible sessions; filter by kind, label, agentId, search, activity. Use before sessions_history or sessions_send target selection.","parameters":{"type":"object","properties":{"kinds":{"type":"array","items":{"truncated":true,"reason":"trajectory-depth-limit","limitDepth":6}},"limit":{"type":"number","minimum":1},"activeMinutes":{"type":"number","minimum":1},"messageLimit":{"type":"number","minimum":0},"label":{"type":"string","minLength":1},"agentId":{"type":"string","minLength":1,"maxLength":64},"search":{"type":"string","minLength":1},"includeDerivedTitles":{"type":"boolean"},"includeLastMessage":{"type":"boolean"}}}},{"name":"sessions_send","description":"Send message to visible session by sessionKey/label, or configured agent by agentId. Thread-scoped chats rejected; target parent channel session. Creates missing configured-agent main session; waits for reply when available.","parameters":{"type":"object","required":["message"],"properties":{"sessionKey":{"type":"string"},"label":{"type":"string","minLength":1,"maxLength":512},"agentId":{"type":"string","minLength":1,"maxLength":64},"message":{"type":"string"},"timeoutSeconds":{"type":"number","minimum":0}}}},{"name":"sessions_spawn","description":"Spawn clean child session; default `runtime=\"subagent\"`. `mode=\"run\"` one-shot background work. Subagents inherit parent workspace. Native subagents get task in first visible `[Subagent Task]` message. Native only: `context=\"fork\"` only when child needs current transcript; else omit or `isolated`. Use for fresh child-session work.","parameters":{"type":"object","required":["task"],"properties":{"task":{"type":"string"},"taskName":{"type":"string","description":"Stable alias for later targeting; lowercase letters/digits/underscores, starts letter."},"label":{"type":"string"},"runtime":{"type":"string","enum":{"truncated":true,"reason":"trajectory-depth-limit","limitDepth":6}},"agentId":{"type":"string"},"model":{"type":"string"},"thinking":{"type":"string"},"cwd":{"type":"string"},"runTimeoutSeconds":{"type":"number","minimum":0},"timeoutSeconds":{"type":"number","minimum":0},"mode":{"type":"string","enum":{"truncated":true,"reason":"trajectory-depth-limit","limitDepth":6}},"cleanup":{"type":"string","enum":{"truncated":true,"reason":"trajectory-depth-limit","limitDepth":6}},"sandbox":{"type":"string","enum":{"truncated":true,"reason":"trajectory-depth-limit","limitDepth":6}},"context":{"type":"string","enum":{"truncated":true,"reason":"trajectory-depth-limit","limitDepth":6},"description":"Native context. Omit/\"isolated\" for clean child; \"fork\" only when child needs requester transcript."},"lightContext":{"type":"boolean","description":"Light bootstrap context; runtime=\"subagent\" only."},"attachments":{"type":"array","items":{"truncated":true,"reason":"trajectory-depth-limit","limitDepth":6},"maxItems":50},"attachAs":{"type":"object","properties":{"truncated":true,"reason":"trajectory-depth-limit","limitDepth":6}}}}},{"name":"sessions_yield","description":"End current turn. Use after spawning subagents; results arrive as next message.","parameters":{"type":"object","properties":{"message":{"type":"string"}}}},{"name":"subagents","description":"List/kill/steer spawned subagents for requester session. If sessions_yield exists, use it for completion; do not poll wait loops.","parameters":{"type":"object","properties":{"action":{"type":"string","enum":{"truncated":true,"reason":"trajectory-depth-limit","limitDepth":6}},"target":{"type":"string"},"message":{"type":"string"},"recentMinutes":{"type":"number","minimum":1}}}},{"name":"update_plan","description":"Update current run plan. Use for non-trivial multi-step work; keep plan current while executing. Short steps; max one `in_progress`; skip for simple one-step work.","parameters":{"type":"object","required":["plan"],"properties":{"explanation":{"type":"string","description":"Short note: what changed."},"plan":{"type":"array","items":{"truncated":true,"reason":"trajectory-depth-limit","limitDepth":6},"minItems":1,"description":"Ordered steps; max one in_progress."}}}},{"name":"video_generate","description":"Create videos. Session chats: background task; do not call video_generate again for same request; wait completion, then send attachments via message tool. \"status\" checks active task. Duration may round to provider-supported value.","parameters":{"type":"object","properties":{"action":{"type":"string","description":"\"generate\" default, \"status\" active task, \"list\" providers/models."},"prompt":{"type":"string","description":"Video prompt."},"image":{"type":"string","description":"One reference image path/URL."},"images":{"type":"array","items":{"truncated":true,"reason":"trajectory-depth-limit","limitDepth":6},"description":"Reference images; max 9."},"imageRoles":{"type":"array","items":{"truncated":true,"reason":"trajectory-depth-limit","limitDepth":6},"description":"`image` + `images` roles by index after de-dupe. Values: first_frame, last_frame, reference_image; empty string leaves unset."},"video":{"type":"string","description":"One reference video path/URL."},"videos":{"type":"array","items":{"truncated":true,"reason":"trajectory-depth-limit","limitDepth":6},"description":"Reference videos; max 4."},"videoRoles":{"type":"array","items":{"truncated":true,"reason":"trajectory-depth-limit","limitDepth":6},"description":"`video` + `videos` roles by index after de-dupe. Value: reference_video; empty string leaves unset."},"model":{"type":"string","description":"Provider/model override, e.g. qwen/wan2.6-t2v."},"filename":{"type":"string","description":"Output filename hint; basename preserved in managed media dir."},"size":{"type":"string","description":"Size hint, e.g. 1280x720, 1920x1080."},"aspectRatio":{"type":"string","description":"Aspect ratio: 1:1, 16:9, 9:16, \"adaptive\", or provider value; unsupported normalized/ignored."},"resolution":{"type":"string","description":"Resolution: 480P, 720P, 768P, 1080P, 4K, or provider value; unsupported normalized/ignored."},"durationSeconds":{"type":"number","description":"Target seconds; may round to nearest supported duration.","minimum":1},"audio":{"type":"boolean","description":"Generated-audio toggle."},"watermark":{"type":"boolean","description":"Watermark toggle."},"providerOptions":{"type":"object","patternProperties":{"truncated":true,"reason":"trajectory-depth-limit","limitDepth":6},"description":"Provider JSON options, e.g. {\"seed\":42}. Keys/types must match provider capabilities; mismatch skips candidate. Use action=list for accepted keys."},"timeoutMs":{"type":"number","description":"Provider timeout ms.","minimum":1}}}},{"name":"web_fetch","description":"Fetch URL and extract readable markdown/text. Lightweight page access; no browser automation.","parameters":{"type":"object","required":["url"],"properties":{"url":{"type":"string","description":"HTTP(S) URL."},"extractMode":{"type":"string","enum":{"truncated":true,"reason":"trajectory-depth-limit","limitDepth":6},"description":"Extract as markdown/text.","default":"markdown"},"maxChars":{"type":"number","description":"Max chars returned; truncates.","minimum":100}}}},{"name":"web_search","description":"Search web for current info; returns normalized provider results.","parameters":{"type":"object","required":["query"],"properties":{"query":{"type":"string","description":"Search query."},"count":{"type":"number","description":"Result count.","minimum":1,"maximum":10},"country":{"type":"string","description":"2-letter country code."},"language":{"type":"string","description":"ISO 639-1 language."},"freshness":{"type":"string","description":"Time filter: day/week/month/year."},"date_after":{"type":"string","description":"Published after YYYY-MM-DD."},"date_before":{"type":"string","description":"Published before YYYY-MM-DD."},"search_lang":{"type":"string","description":"Brave result language."},"ui_lang":{"type":"string","des
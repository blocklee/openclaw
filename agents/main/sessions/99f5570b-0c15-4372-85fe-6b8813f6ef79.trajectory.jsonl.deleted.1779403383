mes\": {\n        \"type\": \"string\"\n      },\n      \"additionalProperties\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"allow\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\"\n            }\n          },\n          \"alsoAllow\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\"\n            }\n          },\n          \"deny\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\"\n            }\n          },\n          \"profile\": {\n            \"anyOf\": [\n              {\n                \"type\": \"string\",\n                \"const\": \"minimal\"\n              },\n              {\n                \"type\": \"string\",\n                \"const\": \"coding\"\n              },\n              {\n                \"type\": \"string\",\n                \"const\": \"messaging\"\n              },\n              {\n                \"type\": \"string\",\n                \"const\": \"full\"\n              }\n            ]\n          }\n        },\n        \"additionalProperties\": false\n      },\n      \"title\": \"Tool Policy by Provider\",\n      \"description\": \"Per-provider tool allow/deny overrides keyed by channel/provider ID to tailor capabilities by surface. Use this when one provider needs stricter controls than global tool policy.\"\n    },\n    \"toolsBySender\": {\n      \"type\": \"object\",\n      \"propertyNames\": {\n        \"type\": \"string\"\n      },\n      \"additionalProperties\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"allow\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\"\n            }\n          },\n          \"alsoAllow\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\"\n            }\n          },\n          \"deny\": {\n        
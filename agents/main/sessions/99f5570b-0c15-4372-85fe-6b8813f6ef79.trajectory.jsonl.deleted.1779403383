{"listChars":0,"schemaChars":20878,"entries":[{"name":"read","summaryChars":298,"schemaChars":304,"propertiesCount":3},{"name":"edit","summaryChars":326,"schemaChars":834,"propertiesCount":2},{"name":"write","summaryChars":127,"schemaChars":225,"propertiesCount":2},{"name":"exec","summaryChars":539,"schemaChars":1187,"propertiesCount":12},{"name":"process","summaryChars":456,"schemaChars":1074,"propertiesCount":12},{"name":"cron","summaryChars":3610,"schemaChars":7191,"propertiesCount":14},{"name":"image_generate","summaryChars":392,"schemaChars":2010,"propertiesCount":15},{"name":"music_generate","summaryChars":443,"schemaChars":1014,"propertiesCount":10},{"name":"video_generate","summaryChars":231,"schemaChars":2028,"propertiesCount":18},{"name":"update_plan","summaryChars":163,"schemaChars":489,"propertiesCount":2},{"name":"sessions_list","summaryChars":135,"schemaChars":432,"propertiesCount":9},{"name":"sessions_history","summaryChars":117,"schemaChars":161,"propertiesCount":3},{"name":"sessions_send","summaryChars":224,"schemaChars":274,"propertiesCount":5},{"name":"sessions_spawn","summaryChars":332,"schemaChars":1240,"propertiesCount":17},{"name":"sessions_yield","summaryChars":79,"schemaChars":60,"propertiesCount":1},{"name":"subagents","summaryChars":129,"schemaChars":191,"propertiesCount":4},{"name":"session_status","summaryChars":278,"schemaChars":89,"propertiesCount":2},{"name":"web_search","summaryChars":65,"schemaChars":991,"propertiesCount":12},{"name":"web_fetch","summaryChars":93,"schemaChars":316,"propertiesCount":3},{"name":"image","summaryChars":119,"schemaChars":316,"propertiesCount":6},{"name":"memory_search","summaryChars":605,"schemaChars":237,"propertiesCount":4},{"name":"memory_get","summaryChars":239,"schemaChars":215,"propertiesCount":4}]}}},"redaction":{"config":{"mode":"redactConfigObject","secretsMasked":true},"payloads":{"mode":"sanitizeDiagnosticPayload","credentialsRemoved":true,"imageDataRedacted":true},"harness":{"mode":"diagnosti
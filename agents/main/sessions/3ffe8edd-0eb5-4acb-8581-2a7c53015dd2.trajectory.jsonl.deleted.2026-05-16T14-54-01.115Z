n    <location>~/.openclaw/workspace/skills/web3-docs/SKILL.md</location>\n  </skill>\n</available_skills>","systemPromptReport":{"source":"run","generatedAt":1778767406938,"sessionId":"3ffe8edd-0eb5-4acb-8581-2a7c53015dd2","sessionKey":"agent:main:feishu:group:oc_4b9190257968cb3e8127176c1a548c98","provider":"nvidia","model":"minimaxai/minimax-m2.7","workspaceDir":"/home/node/.openclaw/workspace","bootstrapMaxChars":12000,"bootstrapTotalMaxChars":60000,"bootstrapTruncation":{"warningMode":"once","warningShown":false,"truncatedFiles":0,"nearLimitFiles":0,"totalNearLimit":false},"sandbox":{"mode":"off","sandboxed":false},"systemPrompt":{"chars":31740,"projectContextChars":7787,"nonProjectContextChars":23953},"injectedWorkspaceFiles":[{"name":"AGENTS.md","path":"/home/node/.openclaw/workspace/AGENTS.md","missing":false,"rawChars":1940,"injectedChars":1940,"truncated":false},{"name":"SOUL.md","path":"/home/node/.openclaw/workspace/SOUL.md","missing":false,"rawChars":461,"injectedChars":461,"truncated":false},{"name":"TOOLS.md","path":"/home/node/.openclaw/workspace/TOOLS.md","missing":false,"rawChars":850,"injectedChars":850,"truncated":false},{"name":"IDENTITY.md","path":"/home/node/.openclaw/workspace/IDENTITY.md","missing":false,"rawChars":200,"injectedChars":200,"truncated":false},{"name":"USER.md","path":"/home/node/.openclaw/workspace/USER.md","missing":false,"rawChars":170,"injectedChars":170,"truncated":false},{"name":"HEARTBEAT.md","path":"/home/node/.openclaw/workspace/HEARTBEAT.md","missing":false,"rawChars":192,"injectedChars":192,"truncated":false},{"name":"BOOTSTRAP.md","path":"/home/node/.openclaw/workspace/BOOTSTRAP.md","missing":true,"rawChars":0,"injectedChars":0,"truncated":false},{"name":"MEMORY.md","path":"/home/node/.openclaw/workspace/MEMORY.md","missing":false,"rawChars":3677,"injectedChars":3677,"truncated":false}],"skills":{"promptChars":12407,"entries":[{"name":"Agent Browser","blockChars":312},{"name":"automation-workflows","blockChars":744},
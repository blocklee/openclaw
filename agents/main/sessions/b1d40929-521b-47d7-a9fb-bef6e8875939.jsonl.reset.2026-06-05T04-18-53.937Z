1-beta.3                | beta   | 2026-05-31\nv2026.5.31-beta.2                | beta   | 2026-05-31\nv2026.5.31-beta.1                | beta   | 2026-05-31\nv2026.5.30-beta.1                | beta   | 2026-05-31\nv2026.5.28                       | STABLE | 2026-05-30\nv2026.5.28-beta.4                | beta   | 2026-05-29\nv2026.5.28-beta.3                | beta   | 2026-05-29\nv2026.5.28-beta.2                | beta   | 2026-05-29\nv2026.5.28-beta.1                | beta   | 2026-05-29\nv2026.5.27                       | STABLE | 2026-05-28\nv2026.5.27-beta.1                | beta   | 2026-05-28\nv2026.5.26                       | STABLE | 2026-05-27\nv2026.5.26-beta.2                | beta   | 2026-05-27\nv2026.5.26-beta.1                | beta   | 2026-05-26","cwd":"/home/node/.openclaw/workspace"},"isError":false,"timestamp":1780616655737}}
{"type":"message","id":"d9ca2bb8","parentId":"7053add5","timestamp":"2026-06-04T23:44:22.369Z","message":{"role":"assistant","content":[{"type":"toolCall","id":"call_function_v8swsziby2kl_1","name":"exec","arguments":{"command":"curl -s --max-time 10 \"https://api.github.com/repos/openclaw/openclaw/releases?per_page=40\" | node -e \"\nlet d=''; process.stdin.on('data',c=>d+=c).on('end',()=>{\n  const arr = JSON.parse(d);\n  const stables = arr.filter(r => !r.prerelease);\n  console.log('All STABLE releases in last 40:');\n  stables.forEach(r => {\n    const tag = r.tag_name;\n    const pub = (r.published_at||'').slice(0,10);\n    const notes = (r.body||'').split('\\n').filter(l=>l.trim().startsWith('#')||l.match(/security|cve|vuln/i)).slice(0,3).join(' | ').slice(0,200);\n    console.log(tag + ' (' + pub + ')');\n  });\n});\""}}],"api":"anthropic-messages","provider":"minimax-portal","model":"MiniMax-M3","usage":{"input":491,"output":216,"cacheRead":104760,"cacheWrite":0,"totalTokens":105467,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1780616655750,"responseId":"067140d09004df4b46d05776affdd1e5"}}

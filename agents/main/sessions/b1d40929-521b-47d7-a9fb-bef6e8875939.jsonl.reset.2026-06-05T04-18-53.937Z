{"type":"message","id":"e06ceae4","parentId":"8744309b","timestamp":"2026-06-04T04:33:07.510Z","message":{"role":"assistant","content":[{"type":"text","text":"现在做 P1-2：抽一个统一的 API 客户端 + 读 env："},{"type":"toolCall","id":"call_function_hsbj2me195bd_1","name":"write","arguments":{"path":"/home/node/.openclaw/workspace/outputs/echo-v2/src/utils/api.js","content":"// ECHO v2 API 客户端 — 统一 base URL、超时、错误处理\n// 所有页面必须通过此模块访问后端，禁止硬编码域名\n\nconst DEFAULT_TIMEOUT_MS = 8000;\n\nfunction getBase() {\n  // vite 会把 import.meta.env.VITE_API_BASE 注入\n  const base = import.meta.env.VITE_API_BASE;\n  if (!base) {\n    console.warn('[api] VITE_API_BASE 未设置，回退到默认值');\n    return 'https://echo-api.meerfans.club';\n  }\n  return base.replace(/\\/+$/, ''); // 去掉末尾斜杠\n}\n\n/**\n * @param {string} path\n * @param {RequestInit & {timeoutMs?: number}} [opts]\n */\nexport async function apiGet(path, opts = {}) {\n  const ctrl = new AbortController();\n  const timeoutMs = opts.timeoutMs ?? DEFAULT_TIMEOUT_MS;\n  const timer = setTimeout(() => ctrl.abort(), timeoutMs);\n\n  const url = getBase() + (path.startsWith('/') ? path : '/' + path);\n\n  try {\n    const res = await fetch(url, {\n      ...opts,\n      signal: ctrl.signal,\n      headers: { Accept: 'application/json', ...(opts.headers || {}) },\n    });\n    clearTimeout(timer);\n    if (!res.ok) {\n      const text = await res.text().catch(() => '');\n      throw new Error(`HTTP ${res.status}${text ? `: ${text.slice(0, 200)}` : ''}`);\n    }\n    return res.json();\n  } catch (err) {\n    clearTimeout(timer);\n    if (err.name === 'AbortError') {\n      throw new Error(`请求超时（${timeoutMs}ms）：${path}`);\n    }\n    throw err;\n  }\n}\n\nexport const API_BASE = getBase();\n\n// ============================================================\n// 端点封装 — 每个函数对应一个后端 endpoint，返回归一化后的数据\n// ============================================================\n\nimport { normalizeNode, normalizeEdges, normalizeRound } from '../contracts/types';\n\n/** GET /api/potential — 势位场快照（含节点+历史） */\nexport async function fetchPotential(timeoutMs) {\n  const data = await apiGet('/api/potential', { timeoutMs });\n  const nodes = Array.isArray(data?.nodes) ? data.nodes.map(normalizeNode).filter(Boolean) : [];\n  return { nodes, updatedAt: data?.updatedAt || Date.now() };\n}\n\n/** GET /api/nodes — 节点列表 */\nexport async function fetchNodes(timeoutMs) {\n  const data = await apiGet('/api/nodes', { timeoutMs });\n  const nodes = Array.isArray(data?.nodes) ? data.nodes.map(normalizeNode).filter(Boolean) : [];\n  return { nodes, total: data?.total ?? nodes.length, updatedAt: data?.updatedAt };\n}\n\n/** GET /api/edges — 边列表 */\nexport async function fetchEdges(timeoutMs) {\n  const data = await apiGet('/api/edges', { timeoutMs });\n  const edges = normalizeEdges(data?.edges);\n  return { edges, total: data?.total ?? edges.length, updatedAt: data?.updatedAt };\n}\n\n/** GET /api/game/rounds — 对战回合列表（势位榜从 rounds 聚合更真实） */\nexport async function fetchRounds(timeoutMs) {\n  const data = await apiGet('/api/game/rounds', { timeoutMs });\n  const rounds = Array.isArray(data?.rounds) ? data.rounds.map(normalizeRound).filter(Boolean) : [];\n  return { rounds, total: data?.total ?? rounds.length, updatedAt: data?.updatedAt };\n}\n\n/** GET /api/game/round/:id — 单个回合详情 */\nexport async function fetchRound(id, timeoutMs) {\n  const data = await apiGet(`/api/game/round/${id}`, { timeoutMs });\n  return { round: normalizeRound(data?.round), bets: data?.bets || [], betCount: data?.betCount || 0 };\n}\n\n/** GET /api/game/stats — 战斗统计 */\nexport async function fetchGameStats(timeoutMs) {\n  const data = await apiGet('/api/game/stats', { timeoutMs });\n  return data?.stats || {};\n}\n\n/** GET /api/health — 健康检查 */\nexport async function fetchHealth(timeoutMs = 4000) {\n  return apiGet('/api/health', { timeoutMs });\n}\n"}}],"api":"anthropic-messages","provider":"minimax-portal","model":"MiniMax-M3","usage":{"input":57,"output":987,"cacheRead":57734,"cacheWrite":0,"totalTokens":58778,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1780547570191,"responseId":"067032f32edf421fe37af55177ff185d"}}
{"type":"message","id":"c9931158","parentId":"e06ceae4","timestamp":"2026-06-04T04:33:08.288Z","message":{"role":"toolResult","toolCallId":"call_function_hsbj2me195bd_1","toolName":"write","content":[{"type":"text","text":"Successfully wrote 3401 bytes to /home/node/.openclaw/workspace/outputs/echo-v2/src/utils/api.js"}],"isError":false,"timestamp":1780547588266}}
{"type":"message","id":"40d4bde5","parentId":"c9931158","timestamp":"2026-06-04T04:33:14.787Z","message":{"role":"assistant","content":[{"type":"toolCall","id":"call_function_1xru0j78yyn4_1","name":"write","arguments":{"path":"/home/node/.openclaw/workspace/outputs/echo-v2/src/utils/runtimeConfig.js","content":"// 运行时配置 — 读 vite 环境变量\n// 任何硬编码常量、地址都从这里取\n\nexport const ECHO_VERSION = import.meta.env.VITE_ECHO_VERSION || '1.1.0';\nexport const CHAIN_ID = Number(import.meta.env.VITE_CHAIN_ID) || 813;\nexport const CHAIN_NAME = import.meta.env.VITE_CHAIN_NAME || 'Qitmeer Mainnet';\n\nexport const RPC_URLS = (import.meta.env.VITE_RPC_URLS || 'https://qng.rpc.qitmeer.io')\n  .split(',')\n  .map(s => s.trim())\n  .filter(Boolean);\n"}}],"api":"anthropic-messages","provider":"minimax-portal","model":"MiniMax-M3","usage":{"input":56,"output":186,"cacheRead":58764,"cacheWrite":0,"totalTokens":59006,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1780547588294,"responseId":"06703305d746503c241a7cc0ab545ef0"}}
{"type":"message","id":"db2e8b6b","parentId":"40d4bde5","timestamp":"2026-06-04T04:33:14.898Z","message":{"role":"toolResult","toolCallId":"call_function_1xru0j78yyn4_1","toolName":"write","content":[{"type":"text","text":"Successfully wrote 412 bytes to /home/node/.openclaw/workspace/outputs/echo-v2/src/utils/runtimeConfig.js"}],"isError":false,"timestamp":1780547594895}}
{"type":"message","id":"d6798be7","parentId":"db2e8b6b","timestamp":"2026-06-04T04:33:39.086Z","message":{"role":"assistant","content":[{"type":"text","text":"现在 P1-1：useWallet 切链 bug。"},{"type":"toolCall","id":"call_function_gxpvehtjx6ax_1","name":"write","arguments":{"path":"/home/node/.openclaw/workspace/outputs/echo-v2/src/hooks/useWallet.js","content":"import { useState, useCallback, useEffect, useRef } from 'react';\nimport { BrowserProvider } from 'ethers';\nimport { CONTRACTS } from '../contracts/config';\nimport { CHAIN_ID, CHAIN_NAME, RPC_URLS } from '../utils/runtimeConfig';\nimport { apiGet } from '../utils/api';\n\nexport function useWallet() {\n  const [provider, setProvider] = useState(null);\n  const [signer, setSigner] = useState(null);\n  const [address, setAddress] = useState(null);\n  const [balance, setBalance] = useState(null);\n  const [connecting, setConnecting] = useState(false);\n  const [error, setError] = useState(null);\n\n  // 用 ref 跟踪最新值，监听器闭包才不拿到旧 address\n  const providerRef = useRef(null);\n  const addressRef = useRef(null);\n  useEffect(() => { providerRef.current = provider; }, [provider]);\n  useEffect(() => { addressRef.current = address; }, [address]);\n\n  const refreshBalance = useCallback(async (web3Provider, addr) => {\n    if (!web3Provider || !addr) return;\n    try {\n      const balanceWei = await web3Provider.getBalance(addr);\n      setBalance(Number(balanceWei) / 1e18);\n    } catch (e) {\n      console.error('refreshBalance failed:', e);\n    }\n  }, []);\n\n  const connect = useCallback(async () => {\n    setConnecting(true);\n    setError(null);\n    try {\n      if (!window.ethereum) {\n        throw new Error('No wallet detected. Please install MetaMask or a Qitmeer-compatible wallet.');\n      }\n      const accounts = await window.ethereum.request({ method: 'eth_requestAccounts' });\n      if (!accounts || accounts.length === 0) {\n        throw new Error('No accounts found. Please unlock your wallet.');\n      }\n      const addr = accounts[0];\n      const web3Provider = new BrowserProvider(window.ethereum);\n      const web3Signer = await web3Provider.getSigner();\n      const network = await web3Provider.getNetwork();\n      if (Number(network.chainId) !== CHAIN_ID) {\n        console.warn(`Connected to chain ${Number(network.chainId)}, expected ${CHAIN_ID} (${CHAIN_NAME})`);\n      }\n      await refreshBalance(web3Provider, addr);\n      setProvider(web3Provider);\n      setSigner(web3Signer);\n      setAddress(addr);\n      console.log('Wallet connected:', addr);\n    } catch (err) {\n      console.error('Wallet connection error:', err);\n      setError(err.message || 'Failed to connect wallet');\n    } finally {\n      setConnecting(false);\n    }\n  }, [refreshBalance]);\n\n  const disconnect = useCallback(() => {\n    if (window.ethereum?.removeAllListeners) {\n      try { window.ethereum.removeAllListeners(); } catch (e) {}\n    }\n    setProvider(null);\n    setSigner(null);\n    setAddress(null);\n    setBalance(null);\n    setError(null);\n  }, []);\n\n  const switchToQitmeer = useCallback(async () => {\n    if (!window.ethereum) return;\n    const chainIdHex = '0x' + CHAIN_ID.toString(16);\n    try {\n      await window.ethereum.request({ method: 'wallet_switchEthereumChain', params: [{ chainId: chainIdHex }] });\n    } catch (switchError) {\n      if (switchError.code === 4902) {\n        try {\n          await window.ethereum.request({\n            method: 'wallet_addEthereumChain',\n            params: [{\n              chainId: chainIdHex,\n              chainName: CHAIN_NAME,\n              rpcUrls: RPC_URLS,\n              blockExplorerUrls: ['https://qng.meerscan.io'],\n              nativeCurrency: { name: 'MEER', symbol: 'MEER', decimals: 18 },\n            }],\n          });\n        } catch (addError) {\n          console.error('Failed to add Qitmeer chain:', addError);\n        }\n      }\n    }\n  }, []);\n\n  // 监听账户/链变化\n  useEffect(() => {\n    if (!window.ethereum) return;\n\n    const handleAccountsChanged = (accounts) => {\n      if (!accounts || accounts.length === 0) {\n        disconnect();\n      } else {\n        // 直接用最新值，不要拿闭包旧 address\n        setAddress(accounts[0]);\n        if (providerRef.current) refreshBalance(providerRef.current, accounts[0]);\n      }\n    };\n\n    const handleChainChanged = async (_chainIdHex) => {\n      // 链变了：旧 provider/signer 都失效，必须重建\n      console.log('[wallet] chain changed, reinitializing provider/signer');\n      const currentAddr = addressRef.current;\n      if (!window.ethereum) {\n        disconnect();\n        return;\n      }\n      try {\n        const newProvider = new BrowserProvider(window.ethereum);\n        const newSigner = currentAddr ? await newProvider.getSigner() : null;\n        setProvider(newProvider);\n        setSigner(newSigner);\n        if (currentAddr) await refreshBalance(newProvider, currentAddr);\n      } catch (e) {\n        console.error('[wallet] reinit on chain change failed:', e);\n        disconnect();\n      }\n    };\n\n    const handleDisconnect = () => disconnect();\n\n    window.ethereum.on('accountsChanged', handleAccountsChanged);\n    window.ethereum.on('chainChanged', handleChainChanged);\n    window.ethereum.on('disconnect', handleDisconnect);\n    return () => {\n      window.ethereum.removeListener('accountsChanged', handleAccountsChanged);\n      window.ethereum.removeListener('chainChanged', handleChainChanged);\n      window.ethereum.removeListener('disconnect', handleDisconnect);\n    };\n  }, [disconnect, refreshBalance]);\n\n  return {\n    provider, signer, address, balance, connecting, error,\n    connect, disconnect, switchToQitmeer, isConnected: !!address,\n  };\n}\n"}}],"api":"anthropic-messages","provider":"minimax-portal","model":"MiniMax-M3","usage":{"input":56,"output":1316,"cacheRead":58992,"cacheWrite":0,"totalTokens":60364,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1780547594899,"responseId":"0670330b79fad646d568ee48c2c29e60"}}
{"type":"message","id":"84cbda48","parentId":"d6798be7","timestamp":"2026-06-04T04:33:39.167Z","message":{"role":"toolResult","toolCallId":"call_function_gxpvehtjx6ax_1","toolName":"write","content":[{"type":"text","text":"Successfully wrote 5254 bytes to /home/node/.openclaw/workspace/outputs/echo-v2/src/hooks/useWallet.js"}],"isError":false,"timestamp":1780547619164}}
{"type":"message","id":"5a3aa845","parentId":"84cbda48","timestamp":"2026-06-04T04:33:48.417Z","message":{"role":"assistant","content":[{"type":"text","text":"WalletBar 改成消费 context 里的 balance："},{"type":"toolCall","id":"call_function_zxtw8sprvdfl_1","name":"write","arguments":{"path":"/home/node/.openclaw/workspace/outputs/echo-v2/src/components/WalletBar.jsx","content":"import { useState } from 'react';\nimport { useWalletContext } from '../contexts/WalletContext';\n\nexport default function WalletBar() {\n  const { address, balance, connect, disconnect, isConnected } = useWalletContext();\n  const [exiting, setExiting] = useState(false);\n\n  const handleDisconnect = () => {\n    setExiting(true);\n    setTimeout(() => { setExiting(false); disconnect(); }, 250);\n  };\n\n  if (isConnected) {\n    return (\n      <div className={`flex items-center gap-3 transition-all duration-300 ${exiting ? 'opacity-0 translate-y-1' : 'opacity-100 translate-y-0'}`}>\n        <span className=\"text-sm text-[#6B665C]\">{typeof balance === 'number' ? balance.toFixed(4) : '—'} MEER</span>\n        <span className=\"font-mono text-sm text-[#2D2A26]\">{address.slice(0,6)}...{address.slice(-4)}</span>\n        <button onClick={handleDisconnect} className=\"text-xs border border-[#E5E2DC] px-2 py-1 rounded hover:border-[#2D2A26] transition-colors text-[#6B665C] hover:text-[#2D2A26]\">断开</button>\n      </div>\n    );\n  }\n  return <button onClick={connect} className=\"text-xs bg-[#6B9E87] text-white px-3 py-1.5 rounded hover:bg-[#5a8a76] transition-colors\">连接钱包</button>;\n}\n"}}],"api":"anthropic-messages","provider":"minimax-portal","model":"MiniMax-M3","usage":{"input":58,"output":417,"cacheRead":60350,"cacheWrite":0,"totalTokens":60825,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1780547619169,"responseId":"0670332326ee6cbb36eb7ab952c877d9"}}
{"type":"message","id":"61422022","parentId":"5a3aa845","timestamp":"2026-06-04T04:33:48.517Z","message":{"role":"toolResult","toolCallId":"call_function_zxtw8sprvdfl_1","toolName":"write","content":[{"type":"text","text":"Successfully wrote 1177 bytes to /home/node/.openclaw/workspace/outputs/echo-v2/src/components/WalletBar.jsx"}],"isError":false,"timestamp":1780547628514}}
{"type":"message","id":"4c2b8084","parentId":"61422022","timestamp":"2026-06-04T04:34:48.220Z","message":{"role":"assistant","content":[{"type":"text","text":"现在 P0-1：重写 JingPage 用新的 API client + 归一化类型。"},{"type":"toolCall","id":"call_function_f4xl617ig4r5_1","name":"write","arguments":{"path":"/home/node/.openclaw/workspace/outputs/echo-v2/src/pages/JingPage.jsx","content":"import { useRef, useEffect, useState } from 'react';\nimport { fetchPotential } from '../utils/api';\nimport { PHASE_NAMES, PHASE_DESCS } from '../contracts/types';\nimport { ECHO_VERSION } from '../utils/runtimeConfig';\nimport { checkVersionCompatibility, ALPHA_7_CONSTRAINT } from '../utils/versionCompat';\n\nconst PHASES = PHASE_NAMES.map((name, i) => ({ name, desc: PHASE_DESCS[i], shiPosition: i }));\n\nfunction PotentialChart({ history }) {\n  const canvasRef = useRef(null);\n  useEffect(() => {\n    const canvas = canvasRef.current;\n    if (!canvas || !history || history.length === 0) return;\n    const parent = canvas.parentElement;\n    if (!parent) return;\n    const w = parent.clientWidth;\n    const h = 112;\n    canvas.width = w * 2;\n    canvas.height = h * 2;\n    canvas.style.width = w + 'px';\n    canvas.style.height = h + 'px';\n    const ctx = canvas.getContext('2d');\n    ctx.scale(2, 2);\n    ctx.clearRect(0, 0, w, h);\n\n    const values = history.map(h => h.potential);\n    const max = Math.max(...values, 0.01);\n    const min = Math.min(...values, 0);\n    const range = max - min || 0.01;\n\n    ctx.strokeStyle = 'rgba(168,163,154,0.2)';\n    ctx.lineWidth = 0.5;\n    for (let i = 1; i < 5; i++) {\n      const y = (i / 5) * h;\n      ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(w, y); ctx.stroke();\n    }\n\n    ctx.beginPath();\n    ctx.strokeStyle = '#c45c48';\n    ctx.lineWidth = 2;\n    values.forEach((v, i) => {\n      const x = (i / Math.max(values.length - 1, 1)) * w;\n      const y = (1 - (v - min) / range) * h;\n      i === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);\n    });\n    ctx.stroke();\n\n    values.forEach((v, i) => {\n      const x = (i / Math.max(values.length - 1, 1)) * w;\n      const y = (1 - (v - min) / range) * h;\n      ctx.beginPath();\n      ctx.fillStyle = '#c45c48';\n      ctx.arc(x, y, 3, 0, Math.PI * 2);\n      ctx.fill();\n    });\n\n    if (values.length <= 10) {\n      ctx.fillStyle = '#78716c';\n      ctx.font = '10px sans-serif';\n      ctx.textAlign = 'center';\n      values.forEach((v, i) => {\n        const x = (i / Math.max(values.length - 1, 1)) * w;\n        const y = (1 - (v - min) / range) * h;\n        ctx.fillText(v.toFixed(2), x, y - 8);\n      });\n    }\n  }, [history]);\n\n  return (\n    <div className=\"w-full h-28\">\n      <canvas ref={canvasRef} className=\"w-full h-full bg-[#faf9f7] rounded\" />\n    </div>\n  );\n}\n\nfunction EdgeList({ edges }) {\n  if (!edges || edges.length === 0) return <div className=\"text-[#6b6b6b]\">无边数据</div>;\n  return (\n    <div className=\"space-y-2\">\n      {edges.map((e, i) => {\n        const compat = e.versionConstraint\n          ? checkVersionCompatibility(ECHO_VERSION, e.versionConstraint)\n          : checkVersionCompatibility(ECHO_VERSION, ALPHA_7_CONSTRAINT);\n        return (\n          <div key={i} className={`bg-[#faf9f7] rounded border p-3 text-sm ${compat?.compatible === false ? 'border-red-300' : 'border-[#e5e2dc]'}`}>\n            <div className=\"flex justify-between mb-1\">\n              <span className=\"text-[#6b6b6b]\">{e.fromNode?.slice(0,8) || '?'}… → {e.toNode?.slice(0,8) || '?'}…</span>\n              {compat && (\n                <span className={`text-xs ${compat.compatible ? 'text-emerald-600' : 'text-red-500'}`}>\n                  {compat.compatible ? '✅ 兼容' : `❌ ${compat.reason}`}\n                </span>\n              )}\n            </div>\n            {e.versionConstraint && typeof e.versionConstraint === 'object' ? (\n              <div className=\"text-xs text-[#c45c48]\">\n                v{e.versionConstraint.minVersion}~v{e.versionConstraint.maxVersion}\n                <span className=\"text-[#6b6b6b] ml-2\">({e.versionConstraint.constraintType})</span>\n                <span className=\"text-[#9a9a9a] ml-2\">blk#{e.versionConstraint.declaredAtBlock}</span>\n              </div>\n            ) : (\n              <div className=\"text-xs text-[#9a9a9a]\">\n                {typeof e.versionConstraint === 'string' ? e.versionConstraint : 'v1.0.0~v2.0.0 (ALPHA-7 默认约束)'}\n              </div>\n            )}\n          </div>\n        );\n      })}\n    </div>\n  );\n}\n\nexport default function JingPage() {\n  const [nodes, setNodes] = useState([]);\n  const [loading, setLoading] = useState(true);\n  const [error, setError] = useState(null);\n  const [activePhase, setActivePhase] = useState(null);\n  const [updatedAt, setUpdatedAt] = useState(null);\n\n  useEffect(() => {\n    let cancelled = false;\n    setLoading(true);\n    setError(null);\n    fetchPotential(8000)\n      .then(data => {\n        if (cancelled) return;\n        setNodes(data.nodes);\n        setUpdatedAt(data.updatedAt);\n        setLoading(false);\n      })\n      .catch(err => {\n        if (cancelled) return;\n        setError(err.message);\n        setLoading(false);\n      });\n    return () => { cancelled = true; };\n  }, []);\n\n  if (loading) return (\n    <div className=\"min-h-screen bg-[#faf9f7] text-[#1a1a1a] p-8\">\n      <div className=\"max-w-5xl mx-auto\">\n        <h1 className=\"text-4xl font-bold mb-2 text-[#1a1a1a]\">境</h1>\n        <p className=\"text-[#6b6b6b] mb-6\">势位如川，共识如流。六相呼吸，动态呈现。</p>\n        <div className=\"text-[#9a9a9a] mb-4\">加载节点数据中…</div>\n        <div className=\"grid grid-cols-3 md:grid-cols-6 gap-3 mb-6\">\n          {PHASES.map((p) => (\n            <div key={p.shiPosition} className=\"rounded p-3 text-center border border-[#e5e2dc] bg-white opacity-50\">\n              <div className=\"text-lg font-bold text-[#1a1a1a]\">{p.name}</div>\n              <div className=\"text-xs text-[#6b6b6b]\">{p.desc}</div>\n            </div>\n          ))}\n        </div>\n      </div>\n    </div>\n  );\n  if (error) return (\n    <div className=\"min-h-screen bg-[#faf9f7] text-[#1a1a1a] p-8\">\n      <div className=\"max-w-5xl mx-auto\">\n        <h1 className=\"text-4xl font-bold mb-2 text-[#1a1a1a]\">境</h1>\n        <p className=\"text-[#6b6b6b] mb-6\">势位如川，共识如流。六相呼吸，动态呈现。</p>\n        <div className=\"bg-red-50 border border-red-200 rounded p-4 text-red-600 mb-4\">\n          <div className=\"font-bold mb-2\">API 错误</div>\n          <div>{error}</div>\n        </div>\n      </div>\n    </div>\n  );\n  if (nodes.length === 0) return (\n    <div className=\"min-h-screen bg-[#faf9f7] text-[#1a1a1a] p-8\">\n      <div className=\"max-w-5xl mx-auto\">\n        <h1 className=\"text-4xl font-bold mb-2 text-[#1a1a1a]\">境</h1>\n        <p className=\"text-[#6b6b6b] mb-6\">势位如川，共识如流。六相呼吸，动态呈现。</p>\n        <div className=\"text-[#9a9a9a]\">无节点数据</div>\n      </div>\n    </div>\n  );\n\n  const allHistory = nodes\n    .flatMap(n => n.potentialHistory || [])\n    .sort((a, b) => a.timestamp - b.timestamp);\n\n  const phaseNodes = activePhase !== null\n    ? nodes.filter(n => n.phase === activePhase)\n    : nodes;\n\n  const phaseHistory = activePhase !== null\n    ? phaseNodes.flatMap(n => n.potentialHistory || []).sort((a, b) => a.timestamp - b.timestamp)\n    : allHistory;\n\n  const edges = phaseNodes.flatMap(n => (n.edges || []).map(e => ({\n    fromNode: n.nodeId,\n    toNode: e.toNode,\n    versionConstraint: 'v1.0.0~v2.0.0 (ALPHA-7)',\n  })));\n\n  const latestNode = nodes[0];\n  const fourRights = latestNode?.fourRights || {};\n\n  return (\n    <div className=\"min-h-screen bg-[#faf9f7] text-[#1a1a1a] p-8\">\n      <div className=\"max-w-5xl mx-auto\">\n        <div className=\"mb-16\">\n          <div className=\"flex justify-between items-end\">\n            <div>\n              <h1 className=\"text-4xl font-bold tracking-wide text-[#1a1a1a] mb-3\">境</h1>\n              <p className=\"text-[#6b6b6b] text-lg\">势位如川，共识如流</p>\n            </div>\n          </div>\n          <div className=\"mt-6 h-px bg-[#d4d0c8]\" />\n        </div>\n\n        {allHistory.length > 0 && (\n          <div className=\"mb-6\">\n            <div className=\"text-sm text-[#6b6b6b] mb-2\">\n              {activePhase !== null ? `${PHASE_NAMES[activePhase]} 势位曲线` : '全六相势位曲线'}\n              <span className=\"text-[#9a9a9a] ml-2\">（{allHistory.length} 个数据点）</span>\n            </div>\n            <PotentialChart history={phaseHistory} />\n          </div>\n        )}\n\n        <div className=\"grid grid-cols-3 md:grid-cols-6 gap-3 mb-6\">\n          {PHASES.map((p) => {\n            const count = nodes.filter(n => n.phase === p.shiPosition).length;\n            return (\n              <div key={p.shiPosition} onClick={() => setActivePhase(activePhase === p.shiPosition ? null : p.shiPosition)}\n                className={`cursor-pointer rounded p-3 text-center transition-all duration-200 border ${activePhase === p.shiPosition ? 'border-[#c45c48] bg-[#c45c48]/5' : 'border-[#e5e2dc] bg-white hover:border-[#d4d0c8]'}`}>\n                <div className=\"text-lg font-bold text-[#1a1a1a]\">{p.name}</div>\n                <div className=\"text-xs text-[#6b6b6b]\">{p.desc}</div>\n                <div className=\"text-xs text-[#c45c48] mt-1\">相位{p.shiPosition}</div>\n                <div className=\"text-xs text-[#9a9a9a] mt-1\">{count} 节点</div>\n              </div>\n            );\n          })}\n        </div>\n\n        {phaseNodes.length > 0 && (\n          <div className=\"mb-6\">\n            <div className=\"text-sm text-[#6b6b6b] mb-2\">\n              {activePhase !== null ? `${PHASE_NAMES[activePhase]} 节点` : '全部节点'}\n              <span className=\"text-[#9a9a9a] ml-2\">（{phaseNodes.length} 个）</span>\n            </div>\n            <div className=\"space-y-3\">\n              {phaseNodes.map((node, i) => (\n                <div key={node.nodeId || i} className=\"bg-white rounded border border-[#e5e2dc] p-4\">\n                  <div className=\"flex justify-between items-start mb-2\">\n                    <div className=\"text-sm font-bold text-[#1a1a1a]\">\n                      节点 {i + 1} · {node.nodeId?.slice(0, 16)}…\n                    </div>\n                    <div className={`text-xs px-2 py-1 rounded ${node.phase === 0 ? 'bg-emerald-50 text-emerald-600' : 'bg-[#faf9f7] text-[#6b6b6b]'}`}>\n                      {PHASE_NAMES[node.phase] || '未设'} · 相位{node.phase}\n                    </div>\n                  </div>\n                  <div className=\"grid grid-cols-2 md:grid-cols-4 gap-3 text-sm mb-2\">\n                    <div>\n                      <div className=\"text-xs text-[#9a9a9a]\">当前势值</div>\n                      <div className=\"font-bold text-[#c45c48]\">{node.potential.toFixed(2)}</div>\n                    </div>\n                    <div>\n                      <div className=\"text-xs text-[#9a9a9a]\">相位</div>\n                      <div className=\"font-bold\">{PHASE_NAMES[node.phase] || '—'}</div>\n                    </div>\n                    <div>\n                      <div className=\"text-xs text-[#9a9a9a]\">出度 / 入度</div>\n                      <div className=\"font-bold\">{node.outDegree} / {node.inDegree}</div>\n                    </div>\n                    <div>\n                      <div className=\"text-xs text-[#9a9a9a]\">创世区块</div>\n                      <div className=\"font-bold\">#{node.createdAtBlock || '—'}</div>\n                    </div>\n                  </div>\n                  {node.creator && (\n                    <div className=\"text-xs text-[#9a9a9a]\">创建者：{node.creator}</div>\n                  )}\n                  {node.edges && node.edges.length > 0 && (\n                    <div className=\"text-xs text-[#9a9a9a] mt-1\">\n                      出边：{node.edges.length} 条 → {node.edges.map(e => e.toNode?.slice(0, 8) || '?').join(', ')}…\n                    </div>\n                  )}\n                </div>\n              ))}\n            </div>\n          </div>\n        )}\n\n        {edges.length > 0 && (\n          <div className=\"mb-6\">\n            <div className=\"text-sm text-[#6b6b6b] mb-2\">边 — 伦理承诺的技术肉身</div>\n            <EdgeList edges={edges} />\n          </div>\n        )}\n\n        <div className=\"bg-white rounded border border-[#e5e2dc] p-4\">\n          <div className=\"text-sm text-[#6b6b6b] mb-3\">节点四权配置（最新节点）</div>\n          <div className=\"grid grid-cols-4 gap-4\">\n            {['usage', 'derive', 'expand', 'benefit'].map(right => (\n              <div key={right} className=\"text-center\">\n                <div className=\"text-xs text-[#6b6b6b] uppercase mb-1\">{right}</div>\n                <div className=\"text-2xl font-bold text-[#1a1a1a]\">{fourRights[right] ?? 0}</div>\n              </div>\n            ))}\n          </div>\n        </div>\n\n        <div className=\"mt-6 text-xs text-[#9a9a9a]\">\n          数据来源：/api/potential · 更新于 {updatedAt ? new Date(updatedAt).toLocaleString('zh-CN') : '—'}\n        </div>\n      </div>\n    </div>\n  );\n}\n"}}],"api":"anthropic-messages","provider":"minimax-portal","model":"MiniMax-M3","usage":{"input":59,"output":3894,"cacheRead":60811,"cacheWrite":0,"totalTokens":64764,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1780547628518,"responseId":"0670332d50fd4e1f467bb8b5f9fad2bd"}}
{"type":"message","id":"6fdecad0","parentId":"4c2b8084","timestamp":"2026-06-04T04:34:48.372Z","message":{"role":"toolResult","toolCallId":"call_function_f4xl617ig4r5_1","toolName":"write","content":[{"type":"text","text":"Successfully wrote 12369 bytes to /home/node/.openclaw/workspace/outputs/echo-v2/src/pages/JingPage.jsx"}],"isError":false,"timestamp":1780547688368}}
{"type":"message","id":"166dedf4","parentId":"6fdecad0","timestamp":"2026-06-04T04:35:38.506Z","message":{"role":"assistant","content":[{"type":"text","text":"现在 P0-1：DianPage 接 API + 持久化 + 落印。"},{"type":"toolCall","id":"call_function_hld7mhhb8d8h_1","name":"write","arguments":{"path":"/home/node/.openclaw/workspace/outputs/echo-v2/src/pages/DianPage.jsx","content":"import { useState, useEffect } from 'react';\nimport { useWalletContext } from '../contexts/WalletContext';\nimport { fetchNodes, fetchEdges, API_BASE } from '../utils/api';\nimport { FOUR_SEALS, isSealEnabled, normalizeEdges } from '../contracts/types';\n\nconst STORAGE_KEY = 'echo-d…y-v1';\n\nfunction loadHistory() {\n  try {\n    const raw = localStorage.getItem(STORAGE_KEY);\n    if (!raw) return [];\n    const arr = JSON.parse(raw);\n    return Array.isArray(arr) ? arr : [];\n  } catch { return []; }\n}\n\nfunction saveHistory(arr) {\n  try { localStorage.setItem(STORAGE_KEY, JSON.stringify(arr.slice(0, 50))); }\n  catch (e) { console.warn('localStorage 写入失败:', e); }\n}\n\nexport default function DianPage() {\n  const { address, isConnected } = useWalletContext();\n  const [showCreate, setShowCreate] = useState(false);\n  const [history, setHistory] = useState(() => loadHistory());\n  const [nodes, setNodes] = useState([]);\n  const [edges, setEdges] = useState([]);\n  const [loading, setLoading] = useState(true);\n  const [error, setError] = useState(null);\n\n  // 拉后端节点+边，用真实 fourRights 初始化 4 印状态\n  useEffect(() => {\n    let cancelled = false;\n    setLoading(true);\n    Promise.all([fetchNodes(8000), fetchEdges(8000)])\n      .then(([n, e]) => {\n        if (cancelled) return;\n        setNodes(n.nodes);\n        setEdges(e.edges);\n        setLoading(false);\n      })\n      .catch(err => {\n        if (cancelled) return;\n        setError(err.message);\n        setLoading(false);\n      });\n    return () => { cancelled = true; };\n  }, []);\n\n  // 4 印配置 — 用最新节点的 fourRights 初始化\n  const latestNode = nodes[0];\n  const [configs, setConfigs] = useState(() =>\n    FOUR_SEALS.map(r => ({\n      ...r,\n      enabled: false,\n      scope: 'all',\n      royalty: 5,\n      duration: 'perpetual',\n    })),\n  );\n\n  // 节点数据到达后，回填 enabled 状态\n  useEffect(() => {\n    if (!latestNode) return;\n    setConfigs(prev => prev.map(c => ({\n      ...c,\n      enabled: isSealEnabled(latestNode, c.key),\n    })));\n  }, [latestNode]);\n\n  const updateConfig = (key, field, value) => {\n    setConfigs(prev => prev.map(c => c.key === key ? { ...c, [field]: value } : c));\n  };\n\n  const handleSave = (key) => {\n    const config = configs.find(c => c.key === key);\n    const newEntry = {\n      action: '契印',\n      seal: config.name,\n      detail: `范围: ${config.scope}, 分润: ${config.royalty}%, 契期: ${config.duration}`,\n      timestamp: new Date().toLocaleString('zh-CN', { hour12: false }),\n      onChain: false, // 暂时无 on-chain 落印合约可调\n      txHash: null,\n    };\n    setHistory(prev => {\n      const next = [newEntry, ...prev].slice(0, 50);\n      saveHistory(next);\n      return next;\n    });\n  };\n\n  const clearHistory = () => {\n    if (!confirm('清空契印谱？此操作不可撤销。')) return;\n    setHistory([]);\n    saveHistory([]);\n  };\n\n  return (\n    <div className=\"min-h-screen bg-[#faf9f7] text-[#1a1a1a] p-8\">\n      <div className=\"max-w-5xl mx-auto\">\n        <div className=\"mb-16\">\n          <div className=\"flex justify-between items-end\">\n            <div>\n              <h1 className=\"text-4xl font-bold tracking-wide text-[#1a1a1a] mb-3\">契</h1>\n              <p className=\"text-[#6b6b6b] text-lg\">铸印为信，确权为据</p>\n            </div>\n            <button\n              onClick={() => setShowCreate(true)}\n              className=\"px-6 py-2.5 bg-[#c45c48] hover:bg-[#b54e3a] text-white text-sm tracking-widest transition-colors\"\n              style={{ borderRadius: '2px' }}\n            >\n              新铸\n            </button>\n          </div>\n          <div className=\"mt-6 h-px bg-[#d4d0c8]\" />\n        </div>\n\n        {error && (\n          <div className=\"mb-6 bg-red-50 border border-red-200 rounded p-4 text-red-600 text-sm\">\n            <div className=\"font-bold mb-1\">后端错误</div>\n            <div>{error}</div>\n            <div className=\"text-xs text-[#9a9a9a] mt-2\">API: {API_BASE}</div>\n          </div>\n        )}\n\n        {!isConnected && !loading && nodes.length === 0 && !error && (\n          <div className=\"mb-6 bg-[#FAF9F7] border border-[#E5E2DC] rounded p-4 text-sm text-[#6B665C]\">\n            连接钱包后，将自动加载你已铸的契印。也可以连接任意地址查看公共契印状态。\n          </div>\n        )}\n\n        {loading && (\n          <div className=\"mb-6 text-[#9a9a9a] text-sm\">加载链上契印状态中…</div>\n        )}\n\n        {!loading && nodes.length > 0 && (\n          <div className=\"mb-6 text-xs text-[#9a9a9a]\">\n            链上节点 {nodes.length} 个 · 边 {edges.length} 条 · 当前四权来自最新节点\n          </div>\n        )}\n\n        <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-8\">\n          {configs.map((config, index) => (\n            <div key={config.key} className=\"group\">\n              <div className=\"flex items-center justify-between mb-6\">\n                <div className=\"flex items-baseline gap-4\">\n                  <span className=\"text-sm text-[#9a9a9a] font-serif\">{String(index + 1).padStart(2, '0')}</span>\n                  <div>\n                    <h3 className=\"text-xl font-bold tracking-wide\">{config.name}</h3>\n                    <p className=\"text-sm text-[#6b6b6b] mt-1\">{config.desc}</p>\n                    <p className=\"text-xs text-[#9a9a9a] mt-1\">{config.detail}</p>\n                  </div>\n                </div>\n                <button\n                  onClick={() => updateConfig(config.key, 'enabled', !config.enabled)}\n                  className={`px-4 py-1.5 text-sm tracking-wider transition-all ${\n                    config.enabled \n                      ? 'bg-[#c45c48] text-white' \n                      : 'border border-[#d4d0c8] text-[#6b6b6b] hover:border-[#c45c48] hover:text-[#c45c48]'\n                  }`}\n                  style={{ borderRadius: '2px' }}\n                >\n                  {config.enabled ? '已契' : '未契'}\n                </button>\n              </div>\n\n              {config.enabled && (\n                <div className=\"pl-10 space-y-5\">\n                  <div className=\"h-px bg-[#e5e2dc]\" />\n                  \n                  <div className=\"grid grid-cols-3 gap-6\">\n                    <div>\n                      <label className=\"text-xs text-[#9a9a9a] tracking-wider mb-2 block\">照临范围</label>\n                      <select\n                        value={config.scope}\n                        onChange={(e) => updateConfig(config.key, 'scope', e.target.value)}\n                        className=\"w-full p-2 bg-[#faf9f7] border-b border-[#d4d0c8] text-sm focus:border-[#c45c48] focus:outline-none transition-colors\"\n                      >\n                        <option value=\"all\">天下</option>\n                        <option value=\"region\">一方</option>\n                        <option value=\"private\">独照</option>\n                      </select>\n                    </div>\n                    <div>\n                      <label className=\"text-xs text-[#9a9a9a] tracking-wider mb-2 block\">分润 (%)</label>\n                      <input\n                        type=\"number\"\n                        value={config.royalty}\n                        onChange={(e) => updateConfig(config.key, 'royalty', Number(e.target.value))}\n                        className=\"w-full p-2 bg-[#faf9f7] border-b border-[#d4d0c8] text-sm focus:border-[#c45c48] focus:outline-none transition-colors\"\n                        min=\"0\"\n                        max=\"100\"\n                      />\n                    </div>\n                    <div>\n                      <label className=\"text-xs text-[#9a9a9a] tracking-wider mb-2 block\">契期</label>\n                      <select\n                        value={config.duration}\n                        onChange={(e) => updateConfig(config.key, 'duration', e.target.value)}\n                        className=\"w-full p-2 bg-[#faf9f7] border-b border-[#d4d0c8] text-sm focus:border-[#c45c48] focus:outline-none transition-colors\"\n                      >\n                        <option value=\"perpetual\">永续</option>\n                        <option value=\"1year\">一载</option>\n                        <option value=\"5years\">五载</option>\n                        <option value=\"10years\">十载</option>\n                      </select>\n                    </div>\n                  </div>\n\n                  <button\n                    onClick={() => handleSave(config.key)}\n                    className=\"px-8 py-2 border border-[#c45c48] text-[#c45c48] hover:bg-[#c45c48] hover:text-white text-sm tracking-widest transition-all\"\n                    style={{ borderRadius: '2px' }}\n                  >\n                    落印\n                  </button>\n                </div>\n              )}\n\n              <div className=\"mt-8 h-px bg-[#e5e2dc]\" />\n            </div>\n          ))}\n        </div>\n\n        {history.length > 0 && (\n          <div className=\"mt-16\">\n            <div className=\"flex items-center gap-4 mb-6\">\n              <h2 className=\"text-xl font-bold tracking-wide\">契印谱</h2>\n              <div className=\"flex-1 h-px bg-[#d4d0c8]\" />\n              <button\n                onClick={clearHistory}\n                className=\"text-xs text-[#9a9a9a] hover:text-[#c45c48] transition-colors\"\n              >\n                清空\n              </button>\n            </div>\n            <div className=\"space-y-0\">\n              {history.slice(0, 10).map((h, i) => (\n                <div key={i} className=\"flex justify-between items-center py-4 border-b border-[#e5e2dc]\">\n                  <div className=\"flex items-baseline gap-6\">\n                    <span className=\"text-sm text-[#9a9a9a]\">{h.timestamp}</span>\n                    <div>\n                      <span className=\"font-medium\">{h.seal}</span>\n                      <span className=\"text-sm text-[#6b6b6b] ml-3\">{h.detail}</span>\n                    </div>\n                  </div>\n                  <div className=\"flex items-center gap-3\">\n                    <span className=\"text-xs text-[#9a9a9a]\">\n                      {h.onChain ? '⛓️ 已上链' : '📝 本地'}\n                    </span>\n                    <span className=\"text-xs text-[#c45c48] tracking-wider\">{h.action}</span>\n                  </div>\n                </div>\n              ))}\n            </div>\n            <div className=\"mt-4 text-xs text-[#9a9a9a]\">\n              共 {history.length} 条 · 最多保留 50 条 · 存储于浏览器 localStorage\n            </div>\n          </div>\n        )}\n      </div>\n    </div>\n  );\n}\n"}}],"api":"anthropic-messages","provider":"minimax-portal","model":"MiniMax-M3","usage":{"input":59,"output":2855,"cacheRead":64750,"cacheWrite":0,"totalTokens":67664,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1780547688373,"responseId":"067033698c97f65ae48753711d4c4320"}}
{"type":"message","id":"9d6105d1","parentId":"166dedf4","timestamp":"2026-06-04T04:35:38.592Z","message":{"role":"toolResult","toolCallId":"call_function_hld7mhhb8d8h_1","toolName":"write","content":[{"type":"text","text":"Successfully wrote 10249 bytes to /home/node/.openclaw/workspace/outputs/echo-v2/src/pages/DianPage.jsx"}],"isError":false,"timestamp":1780547738588}}
{"type":"message","id":"d7a67bc4","parentId":"9d6105d1","timestamp":"2026-06-04T04:36:23.657Z","message":{"role":"assistant","content":[{"type":"text","text":"现在 P0-2：YuanPage 接 `/api/nodes` + `/api/edges`，从真实数据生成\"源流谱\"——每条边就是一个版本的衍生。"},{"type":"toolCall","id":"call_function_3nxar73umm4w_1","name":"write","arguments":{"path":"/home/node/.openclaw/workspace/outputs/echo-v2/src/pages/YuanPage.jsx","content":"import { useState, useEffect, useMemo } from 'react';\nimport { fetchNodes, fetchEdges } from '../utils/api';\nimport { PHASE_NAMES } from '../contracts/types';\n\nfunction timeAgo(tsSec) {\n  if (!tsSec) return '—';\n  const diff = Date.now() / 1000 - tsSec;\n  if (diff < 60) return `${Math.floor(diff)}秒前`;\n  if (diff < 3600) return `${Math.floor(diff / 60)}分钟前`;\n  if (diff < 86400) return `${Math.floor(diff / 3600)}小时前`;\n  if (diff < 86400 * 30) return `${Math.floor(diff / 86400)}天前`;\n  if (diff < 86400 * 365) return `${Math.floor(diff / 86400 / 30)}月前`;\n  return `${Math.floor(diff / 86400 / 365)}年前`;\n}\n\nfunction shortAddr(addr) {\n  if (!addr) return '—';\n  return `${addr.slice(0, 6)}…${addr.slice(-4)}`;\n}\n\nexport default function YuanPage() {\n  const [nodes, setNodes] = useState([]);\n  const [edges, setEdges] = useState([]);\n  const [loading, setLoading] = useState(true);\n  const [error, setError] = useState(null);\n  const [selectedNode, setSelectedNode] = useState(null);\n\n  useEffect(() => {\n    let cancelled = false;\n    setLoading(true);\n    Promise.all([fetchNodes(8000), fetchEdges(8000)])\n      .then(([n, e]) => {\n        if (cancelled) return;\n        setNodes(n.nodes);\n        setEdges(e.edges);\n        setLoading(false);\n      })\n      .catch(err => {\n        if (cancelled) return;\n        setError(err.message);\n        setLoading(false);\n      });\n    return () => { cancelled = true; };\n  }, []);\n\n  // 从节点+边推导\"著录\"：每个节点是一部\"作品\"\n  const works = useMemo(() => {\n    return nodes.map((n, i) => ({\n      id: n.nodeId,\n      name: `节点 ${i + 1} · ${shortAddr(n.nodeId)}`,\n      version: `v${n.phase}.${n.outDegree + n.inDegree}`,\n      state: n.outDegree > 0 ? '流变' : '封卷',\n      milestone: PHASE_NAMES[n.phase] || '未设',\n      sealedAt: timeAgo(n.timestamp),\n      block: n.createdAtBlock,\n      txHash: n.txHash,\n    }));\n  }, [nodes]);\n\n  // \"源流谱\"：每条边就是一次衍生，按声明区块排序\n  const sourceTree = useMemo(() => {\n    return edges\n      .slice()\n      .sort((a, b) => (a.declaredAtBlock || 0) - (b.declaredAtBlock || 0))\n      .map((e, i) => {\n        const fromIdx = nodes.findIndex(n => n.nodeId === e.fromNode);\n        const toIdx = nodes.findIndex(n => n.nodeId === e.toNode);\n        const fromShort = fromIdx >= 0 ? `节点 ${fromIdx + 1}` : shortAddr(e.fromNode);\n        const toShort = toIdx >= 0 ? `节点 ${toIdx + 1}` : shortAddr(e.toNode);\n        return {\n          id: e.txHash || `${i}`,\n          version: `e${i + 1}`,\n          author: shortAddr(e.declarer),\n          date: `区块 #${e.declaredAtBlock}`,\n          note: `${fromShort} → ${toShort}`,\n          branch: '支',\n        };\n      });\n  }, [edges, nodes]);\n\n  // \"纪年\"：节点按时间倒序\n  const timeline = useMemo(() => {\n    return nodes\n      .slice()\n      .sort((a, b) => (b.timestamp || 0) - (a.timestamp || 0))\n      .map((n, i) => {\n        const idx = nodes.indexOf(n);\n        return {\n          id: n.nodeId,\n          milestone: PHASE_NAMES[n.phase] || '未设',\n          name: `节点 ${idx + 1} · ${shortAddr(n.nodeId)}`,\n          sealedAt: timeAgo(n.timestamp),\n          block: n.createdAtBlock,\n        };\n      });\n  }, [nodes]);\n\n  if (loading) return (\n    <div className=\"min-h-screen bg-[#faf9f7] text-[#1a1a1a] p-8\">\n      <div className=\"max-w-5xl mx-auto\">\n        <h1 className=\"text-4xl font-bold tracking-wide text-[#1a1a1a] mb-3\">源</h1>\n        <p className=\"text-[#6b6b6b] text-lg\">版本如铸，源流可溯</p>\n        <div className=\"mt-8 text-[#9a9a9a]\">加载源流数据中…</div>\n      </div>\n    </div>\n  );\n\n  if (error) return (\n    <div className=\"min-h-screen bg-[#faf9f7] text-[#1a1a1a] p-8\">\n      <div className=\"max-w-5xl mx-auto\">\n        <h1 className=\"text-4xl font-bold tracking-wide text-[#1a1a1a] mb-3\">源</h1>\n        <p className=\"text-[#6b6b6b] text-lg\">版本如铸，源流可溯</p>\n        <div className=\"mt-8 bg-red-50 border border-red-200 rounded p-4 text-red-600 text-sm\">\n          <div className=\"font-bold mb-1\">后端错误</div>\n          <div>{error}</div>\n        </div>\n      </div>\n    </div>\n  );\n\n  return (\n    <div className=\"min-h-screen bg-[#faf9f7] text-[#1a1a1a] p-8\">\n      <div className=\"max-w-5xl mx-auto\">\n        <div className=\"mb-16\">\n          <div className=\"flex justify-between items-end\">\n            <div>\n              <h1 className=\"text-4xl font-bold tracking-wide text-[#1a1a1a] mb-3\">源</h1>\n              <p className=\"text-[#6b6b6b] text-lg\">版本如铸，源流可溯</p>\n            </div>\n            <div className=\"text-xs text-[#9a9a9a]\">\n              {works.length} 节点 · {sourceTree.length} 边\n            </div>\n          </div>\n          <div className=\"mt-6 h-px bg-[#d4d0c8]\" />\n        </div>\n\n        {works.length === 0 && (\n          <div className=\"mb-16 text-[#9a9a9a]\">链上暂无节点数据</div>\n        )}\n\n        {/* 著录 */}\n        {works.length > 0 && (\n          <div className=\"mb-16\">\n            <div className=\"flex items-center gap-4 mb-8\">\n              <h2 className=\"text-xl font-bold tracking-wide\">著录</h2>\n              <div className=\"flex-1 h-px bg-[#d4d0c8]\" />\n              <span className=\"text-sm text-[#9a9a9a]\">{works.length} 件</span>\n            </div>\n\n            <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-8\">\n              {works.map((work, index) => (\n                <div\n                  key={work.id}\n                  onClick={() => setSelectedNode(selectedNode === work.id ? null : work.id)}\n                  className=\"group cursor-pointer\"\n                >\n                  <div className=\"flex items-start justify-between\">\n                    <div className=\"flex items-baseline gap-4\">\n                      <span className=\"text-sm text-[#9a9a9a] font-serif\">{String(index + 1).padStart(2, '0')}</span>\n                      <div>\n                        <h3 className=\"text-lg font-bold tracking-wide\">{work.name}</h3>\n                        <p className=\"text-sm text-[#6b6b6b] mt-1\">{work.milestone} · {work.sealedAt}</p>\n                      </div>\n                    </div>\n                    <span className={`px-3 py-1 text-xs tracking-wider ${\n                      work.state === '封卷' \n                        ? 'bg-[#c45c48] text-white' \n                        : 'border border-[#3b5998] text-[#3b5998]'\n                    }`} style={{ borderRadius: '2px' }}>\n                      {work.state}\n                    </span>\n                  </div>\n\n                  {selectedNode === work.id && (\n                    <div className=\"mt-4 pl-10\">\n                      <div className=\"h-px bg-[#e5e2dc] mb-4\" />\n                      <div className=\"grid grid-cols-2 gap-4 text-sm\">\n                        <div>\n                          <span className=\"text-[#9a9a9a]\">版本</span>\n                          <p className=\"font-medium mt-1\">{work.version}</p>\n                        </div>\n                        <div>\n                          <span className=\"text-[#9a9a9a]\">创世区块</span>\n                          <p className=\"font-medium mt-1\">#{work.block || '—'}</p>\n                        </div>\n                        <div className=\"col-span-2\">\n                          <span className=\"text-[#9a9a9a]\">交易哈希</span>\n                          <p className=\"font-mono text-xs mt-1 break-all\">{work.txHash || '—'}</p>\n                        </div>\n                      </div>\n                    </div>\n                  )}\n\n                  <div className=\"mt-6 h-px bg-[#e5e2dc]\" />\n                </div>\n              ))}\n            </div>\n          </div>\n        )}\n\n        {/* 源流谱 */}\n        {sourceTree.length > 0 && (\n          <div className=\"mb-16\">\n            <div className=\"flex items-center gap-4 mb-8\">\n              <h2 className=\"text-xl font-bold tracking-wide\">源流谱</h2>\n              <div className=\"flex-1 h-px bg-[#d4d0c8]\" />\n            </div>\n\n            <div className=\"space-y-0\">\n              {sourceTree.map((node, index) => (\n                <div key={node.id} className=\"flex items-start gap-6 py-5 border-b border-[#e5e2dc]\">\n                  <span className=\"text-sm px-2 py-1 text-[#3b5998]\">\n                    {node.branch}\n                  </span>\n                  <div className=\"flex-1\">\n                    <div className=\"flex items-baseline gap-4\">\n                      <span className=\"font-bold\">第 {index + 1} 衍</span>\n                      <span className=\"text-sm text-[#6b6b6b]\">{node.note}</span>\n                    </div>\n                    <div className=\"mt-1 text-sm text-[#9a9a9a]\">\n                      {node.author} · {node.date}\n                    </div>\n                  </div>\n                </div>\n              ))}\n            </div>\n          </div>\n        )}\n\n        {/* 纪年 */}\n        {timeline.length > 0 && (\n          <div>\n            <div className=\"flex items-center gap-4 mb-8\">\n              <h2 className=\"text-xl font-bold tracking-wide\">纪年</h2>\n              <div className=\"flex-1 h-px bg-[#d4d0c8]\" />\n            </div>\n\n            <div className=\"relative\">\n              <div className=\"absolute left-4 top-0 bottom-0 w-px bg-[#d4d0c8]\" />\n              \n              <div className=\"space-y-8\">\n                {timeline.map((item) => (\n                  <div key={item.id} className=\"flex items-start gap-6 pl-10 relative\">\n                    <div className=\"absolute left-2 top-2 w-3 h-3 rounded-full bg-[#c45c48]\" />\n                    <div>\n                      <div className=\"font-bold\">{item.milestone}</div>\n                      <div className=\"text-sm text-[#6b6b6b] mt-1\">{item.name}</div>\n                      <div className=\"text-xs text-[#9a9a9a] mt-1\">\n                        {item.sealedAt} · 区块 #{item.block}\n                      </div>\n                    </div>\n                  </div>\n                ))}\n              </div>\n            </div>\n          </div>\n        )}\n      </div>\n    </div>\n  );\n}\n"}}],"api":"anthropic-messages","provider":"minimax-portal","model":"MiniMax-M3","usage":{"input":59,"output":2953,"cacheRead":67650,"cacheWrite":0,"totalTokens":70662,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1780547738594,"responseId":"0670339bbc190158dcbf7b1c5d1a70c3"}}
{"type":"message","id":"93389b9f","parentId":"d7a67bc4","timestamp":"2026-06-04T04:36:23.762Z","message":{"role":"toolResult","toolCallId":"call_function_3nxar73umm4w_1","toolName":"write","content":[{"type":"text","text":"Successfully wrote 9809 bytes to /home/node/.openclaw/workspace/outputs/echo-v2/src/pages/YuanPage.jsx"}],"isError":false,"timestamp":1780547783753}}
{"type":"message","id":"68f9dc22","parentId":"93389b9f","timestamp":"2026-06-04T04:37:15.262Z","message":{"role":"assistant","content":[{"type":"text","text":"现在 P0-3：JingCompPage — **从 `/api/game/rounds` 拉真数据**，根据 roundId 显示对应 round 的 options + bets，淘汰假 RANKING + 假按钮。"},{"type":"toolCall","id":"call_function_c2r3etdrdyzj_1","name":"write","arguments":{"path":"/home/node/.openclaw/workspace/outputs/echo-v2/src/pages/JingCompPage.jsx","content":"import { useState, useEffect } from 'react';\nimport { fetchRounds, fetchRound, fetchGameStats, API_BASE } from '../utils/api';\n\nfunction shortAddr(addr) {\n  if (!addr) return '—';\n  return `${addr.slice(0, 6)}…${addr.slice(-4)}`;\n}\n\nfunction timeAgo(tsSec) {\n  if (!tsSec) return '—';\n  const diff = Date.now() / 1000 - tsSec;\n  if (diff < 60) return `${Math.floor(diff)}秒前`;\n  if (diff < 3600) return `${Math.floor(diff / 60)}分钟前`;\n  if (diff < 86400) return `${Math.floor(diff / 3600)}小时前`;\n  if (diff < 86400 * 30) return `${Math.floor(diff / 86400)}天前}`;\n  return `${Math.floor(diff / 86400)}天前`;\n}\n\nfunction isRoundActive(round) {\n  if (!round) return false;\n  const now = Date.now() / 1000;\n  return now >= round.startTime && now <= round.endTime && !round.settled;\n}\n\nexport default function JingCompPage() {\n  const [rounds, setRounds] = useState([]);\n  const [currentRound, setCurrentRound] = useState(null);\n  const [bets, setBets] = useState([]);\n  const [loading, setLoading] = useState(true);\n  const [error, setError] = useState(null);\n  const [stats, setStats] = useState(null);\n  const [roundIdx, setRoundIdx] = useState(0);\n\n  // 拉所有 rounds 列表\n  useEffect(() => {\n    let cancelled = false;\n    setLoading(true);\n    Promise.all([fetchRounds(8000), fetchGameStats(8000)])\n      .then(([r, s]) => {\n        if (cancelled) return;\n        setRounds(r.rounds);\n        setStats(s);\n        setLoading(false);\n      })\n      .catch(err => {\n        if (cancelled) return;\n        setError(err.message);\n        setLoading(false);\n      });\n    return () => { cancelled = true; };\n  }, []);\n\n  // 当前 round 切换时拉详情（含 bets）\n  useEffect(() => {\n    if (rounds.length === 0) return;\n    const r = rounds[roundIdx];\n    if (!r) return;\n    let cancelled = false;\n    setCurrentRound(null);\n    setBets([]);\n    fetchRound(r.roundId, 6000)\n      .then(data => {\n        if (cancelled) return;\n        setCurrentRound(data.round);\n        setBets(data.bets || []);\n      })\n      .catch(err => {\n        if (cancelled) return;\n        setError(err.message);\n      });\n    return () => { cancelled = true; };\n  }, [rounds, roundIdx]);\n\n  // 统计每个 option 的押注数（无金额数据时用押注数当排名依据）\n  const ranking = (() => {\n    if (!currentRound || !currentRound.options) return [];\n    const counts = new Array(currentRound.options.length).fill(0);\n    bets.forEach(b => {\n      // bet 结构未知，按选项位置保守处理：尝试 optionIndex / option / choice\n      const idx = b.optionIndex ?? b.choice ?? b.option;\n      if (typeof idx === 'number' && idx >= 0 && idx < counts.length) {\n        counts[idx] += 1;\n      } else if (typeof b.option === 'string') {\n        const i = currentRound.options.indexOf(b.option);\n        if (i >= 0) counts[i] += 1;\n      }\n    });\n    return currentRound.options\n      .map((name, i) => ({ name, count: counts[i] }))\n      .sort((a, b) => b.count - a.count);\n  })();\n\n  const goPrev = () => setRoundIdx(i => Math.max(0, i - 1));\n  const goNext = () => setRoundIdx(i => Math.min(rounds.length - 1, i + 1));\n\n  if (loading) return (\n    <div className=\"min-h-screen bg-[#faf9f7] text-[#1a1a1a] p-8\">\n      <div className=\"max-w-5xl mx-auto\">\n        <h1 className=\"text-4xl font-bold tracking-wide text-[#1a1a1a] mb-3\">竞</h1>\n        <p className=\"text-[#6b6b6b] text-lg\">势如峰峦，位如座次</p>\n        <div className=\"mt-8 text-[#9a9a9a]\">加载对战数据中…</div>\n      </div>\n    </div>\n  );\n\n  if (error) return (\n    <div className=\"min-h-screen bg-[#faf9f7] text-[#1a1a1a] p-8\">\n      <div className=\"max-w-5xl mx-auto\">\n        <h1 className=\"text-4xl font-bold tracking-wide text-[#1a1a1a] mb-3\">竞</h1>\n        <p className=\"text-[#6b6b6b] text-lg\">势如峰峦，位如座次</p>\n        <div className=\"mt-8 bg-red-50 border border-red-200 rounded p-4 text-red-600 text-sm\">\n          <div className=\"font-bold mb-1\">后端错误</div>\n          <div>{error}</div>\n        </div>\n      </div>\n    </div>\n  );\n\n  if (rounds.length === 0) return (\n    <div className=\"min-h-screen bg-[#faf9f7] text-[#1a1a1a] p-8\">\n      <div className=\"max-w-5xl mx-auto\">\n        <h1 className=\"text-4xl font-bold tracking-wide text-[#1a1a1a] mb-3\">竞</h1>\n        <p className=\"text-[#6b6b6b] text-lg\">势如峰峦，位如座次</p>\n        <div className=\"mt-8 text-[#9a9a9a]\">链上暂无对战回合</div>\n      </div>\n    </div>\n  );\n\n  return (\n    <div className=\"min-h-screen bg-[#faf9f7] text-[#1a1a1a] p-8\">\n      <div className=\"max-w-5xl mx-auto\">\n        <div className=\"mb-16\">\n          <div className=\"flex justify-between items-end\">\n            <div>\n              <h1 className=\"text-4xl font-bold tracking-wide text-[#1a1a1a] mb-3\">竞</h1>\n              <p className=\"text-[#6b6b6b] text-lg\">势如峰峦，位如座次</p>\n            </div>\n            <div className=\"text-xs text-[#9a9a9a]\">\n              {rounds.length} 回合 · {stats?.totalBets ?? 0} 押注\n            </div>\n          </div>\n          <div className=\"mt-6 h-px bg-[#d4d0c8]\" />\n        </div>\n\n        {/* 局况 */}\n        {stats && (\n          <div className=\"mb-16\">\n            <div className=\"flex items-center gap-4 mb-8\">\n              <h2 className=\"text-xl font-bold tracking-wide\">局况</h2>\n              <div className=\"flex-1 h-px bg-[#d4d0c8]\" />\n            </div>\n\n            <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-8\">\n              <div className=\"text-center py-8\">\n                <div className=\"text-3xl font-bold text-[#c45c48]\">{stats.totalRounds ?? 0}</div>\n                <div className=\"text-sm text-[#6b6b6b] mt-2 tracking-wider\">总回合</div>\n              </div>\n              <div className=\"text-center py-8\">\n                <div className=\"text-3xl font-bold text-[#1a1a1a]\">{stats.activeRounds ?? 0}</div>\n                <div className=\"text-sm text-[#6b6b6b] mt-2 tracking-wider\">进行中</div>\n              </div>\n              <div className=\"text-center py-8\">\n                <div className=\"text-3xl font-bold text-[#3b5998]\">{stats.totalBets ?? 0}</div>\n                <div className=\"text-sm text-[#6b6b6b] mt-2 tracking-wider\">总押注</div>\n              </div>\n            </div>\n          </div>\n        )}\n\n        {/* 势位榜 */}\n        <div className=\"mb-16\">\n          <div className=\"flex items-center gap-4 mb-8\">\n            <h2 className=\"text-xl font-bold tracking-wide\">势位榜</h2>\n            <div className=\"flex-1 h-px bg-[#d4d0c8]\" />\n            {rounds.length > 1 && (\n              <div className=\"flex gap-2\">\n                <button \n                  onClick={goPrev}\n                  disabled={roundIdx === 0}\n                  className=\"px-3 py-1 text-sm border border-[#d4d0c8] text-[#6b6b6b] hover:border-[#c45c48] hover:text-[#c45c48] transition-colors disabled:opacity-30 disabled:cursor-not-allowed\"\n                  style={{ borderRadius: '2px' }}\n                >\n                  上一轮\n                </button>\n                <button \n                  onClick={goNext}\n                  disabled={roundIdx >= rounds.length - 1}\n                  className=\"px-3 py-1 text-sm border border-[#d4d0c8] text-[#6b6b6b] hover:border-[#c45c48] hover:text-[#c45c48] transition-colors disabled:opacity-30 disabled:cursor-not-allowed\"\n                  style={{ borderRadius: '2px' }}\n                >\n                  下一轮\n                </button>\n              </div>\n            )}\n          </div>\n\n          {currentRound && (\n            <div className=\"mb-4 bg-[#FAF9F7] border border-[#E5E2DC] rounded p-4\">\n              <div className=\"flex items-start justify-between gap-4\">\n                <div>\n                  <div className=\"text-sm text-[#9a9a9a] mb-1\">第 {currentRound.roundId} 回合</div>\n                  <div className=\"text-base text-[#1a1a1a] font-medium\">{currentRound.question}</div>\n                  <div className=\"text-xs text-[#9a9a9a] mt-2\">\n                    开始 {timeAgo(currentRound.startTime)} · 截止 {timeAgo(currentRound.endTime)}\n                  </div>\n                </div>\n                <div className=\"flex flex-col items-end gap-1\">\n                  {currentRound.settled ? (\n                    <span className=\"px-3 py-1 text-xs bg-[#1a1a1a] text-white\" style={{ borderRadius: '2px' }}>\n                      已结算\n                    </span>\n                  ) : isRoundActive(currentRound) ? (\n                    <span className=\"px-3 py-1 text-xs bg-emerald-50 text-emerald-600\" style={{ borderRadius: '2px' }}>\n                      押注中\n                    </span>\n                  ) : (\n                    <span className=\"px-3 py-1 text-xs border border-[#d4d0c8] text-[#6b6b6b]\" style={{ borderRadius: '2px' }}>\n                      未开始\n                    </span>\n                  )}\n                  <div className=\"text-xs text-[#9a9a9a]\">奖池 {currentRound.totalPool} MEER</div>\n                </div>\n              </div>\n              {currentRound.creator && (\n                <div className=\"text-xs text-[#9a9a9a] mt-3\">发起人：{shortAddr(currentRound.creator)}</div>\n              )}\n            </div>\n          )}\n\n          {ranking.length > 0 ? (\n            <div className=\"space-y-0\">\n              {ranking.map((item, index) => (\n                <div key={item.name} className=\"flex items-center gap-6 py-5 border-b border-[#e5e2dc]\">\n                  <span className=\"text-sm text-[#9a9a9a] font-serif w-8\">\n                    {String(index + 1).padStart(2, '0')}\n                  </span>\n                  <div className=\"flex-1\">\n                    <div className=\"font-bold tracking-wide\">{item.name}</div>\n                    <div className=\"text-xs text-[#9a9a9a] mt-1\">{item.count} 押注</div>\n                  </div>\n                  <div className=\"text-right\">\n                    <div className=\"font-bold text-lg\">\n                      {currentRound?.winningOption >= 0 && currentRound.options?.[currentRound.winningOption] === item.name\n                        ? '🏆'\n                        : `${item.count}`}\n                    </div>\n                  </div>\n                </div>\n              ))}\n            </div>\n          ) : (\n            <div className=\"text-[#9a9a9a] text-sm\">本回合无选项</div>\n          )}\n\n          {bets.length > 0 && (\n            <div className=\"mt-6\">\n              <div className=\"text-sm text-[#6b6b6b] mb-2\">最近押注（最多 10 条）</div>\n              <div className=\"space-y-1\">\n                {bets.slice(0, 10).map((b, i) => (\n                  <div key={i} className=\"text-xs text-[#9a9a9a] flex justify-between border-b border-[#e5e2dc] py-2\">\n                    <span>{shortAddr(b.bettor || b.user || b.address)}</span>\n                    <span>选项 {b.optionIndex ?? b.choice ?? b.option ?? '—'}</span>\n                    <span>{b.amount ? `${b.amount} MEER` : '—'}</span>\n                  </div>\n                ))}\n              </div>\n            </div>\n          )}\n        </div>\n\n        <div className=\"mt-6 text-xs text-[#9a9a9a]\">\n          数据来源：{API_BASE}/api/game/rounds · {bets.length} 押注已索引\n        </div>\n      </div>\n    </div>\n  );\n}\n"}}],"api":"anthropic-messages","provider":"minimax-portal","model":"MiniMax-M3","usage":{"input":65,"output":3385,"cacheRead":70642,"cacheWrite":0,"totalTokens":74092,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1780547783763,"responseId":"067033c8f2c7bd9d77bc35cbfff394b2"}}

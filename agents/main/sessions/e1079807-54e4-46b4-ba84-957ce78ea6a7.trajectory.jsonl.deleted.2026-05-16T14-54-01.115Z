ion":"Design and implement automation workflows to save time and scale operations as a solopreneur. Use when identifying repetitive tasks to automate, building workflows across tools, setting up triggers and actions, or optimizing existing automations. Covers automation opportunity identification, workflow design, tool selection (Zapier, Make, n8n), testing, and maintenance. Trigger on \"automate\", \"automation\", \"workflow automation\", \"save time\", \"reduce manual work\", \"automate my business\", \"no-code automation\".","filePath":"$OPENCLAW_STATE_DIR/skills/automation-workflows/SKILL.md","baseDir":"$OPENCLAW_STATE_DIR/skills/automation-workflows","source":"openclaw-managed","sourceInfo":{"baseDir":"$OPENCLAW_STATE_DIR/skills/automation-workflows","origin":"top-level","path":"$OPENCLAW_STATE_DIR/skills/automation-workflows/SKILL.md","scope":"project","source":"openclaw-managed"},"disableModelInvocation":false,"available":true},{"id":"binance-hunter","name":"binance-hunter","description":"The Hunter: Professional Binance Trading Skill. Features AI market analysis, auto-risk calculation, and 125x leverage support.","filePath":"$OPENCLAW_STATE_DIR/workspace/skills/binance-hunter/SKILL.md","baseDir":"$OPENCLAW_STATE_DIR/workspace/skills/binance-hunter","source":"openclaw-workspace","sourceInfo":{"baseDir":"$OPENCLAW_STATE_DIR/workspace/skills/binance-hunter","origin":"top-level","path":"$OPENCLAW_STATE_DIR/workspace/skills/binance-hunter/SKILL.md","scope":"project","source":"openclaw-workspace"},"disableModelInvocation":false,"available":true},{"id":"Blockchain","name":"Blockchain","description":"Understand blockchain technology, interact with smart contracts, and evaluate when distributed ledgers solve real problems.","filePath":"$OPENCLAW_STATE_DIR/workspace/skills/blockchain/SKILL.md","baseDir":"$OPENCLAW_STATE_DIR/workspace/skills/blockchain","source":"openclaw-workspace","sourceInfo":{"baseDir":"$OPENCLAW_STATE_DIR/workspace/skills/blockchain","origin":"top
mber; delayMs?: number; onRetry?: (n: number, err: ChainError) => void } = {}\n): Promise<T> {\n  const { retries = 3, delayMs = 1000, onRetry } = options;\n  let lastErr: ChainError | null = null;\n  for (let i = 0; i < retries; i++) {\n    try {\n      return await fn();\n    } catch (e: any) {\n      lastErr = classifyError(e);\n      if (!lastErr.retryable || i === retries - 1) throw lastErr;\n      onRetry?.(i + 1, lastErr);\n      await new Promise(r => setTimeout(r, delayMs * (i + 1)));\n    }\n  }\n  throw lastErr!;\n}\n\nexport function errorMessage(e: any): string {\n  if (e instanceof ChainError) {\n    const icon = e.code === 'RPC_DOWN' ? '🌐' : e.code === 'TIMEOUT' ? '⏱' : e.code === 'INVALID_BATTLE' ? '❌' : '⚠️';\n    return `${icon} ${e.code}: ${e.message}`;\n  }\n  return `❓ ${e?.message || '未知错误'}`;\n}\nEOF\necho \"✅ utils/error-handler.ts 写完\"\nwc -l frontend-integration/src/utils/error-handler.ts\necho \"\"\n\n# 同步到本地\nmkdir -p /home/node/.openclaw/workspace/echo/frontend-integration/src/utils\ncp frontend-integration/src/utils/error-handler.ts /home/node/.openclaw/workspace/echo/frontend-integration/src/utils/\n\necho \"=== 2. add + commit + push ===\"\ngit add frontend-integration/src/utils/error-handler.ts frontend-integration/src/chain-reader/reader.ts\ngit status -s\ngit commit -m \"feat(frontend-integration): v0.7 — error handling + retry layer (Talus Agent)\n\n哪吒 9:49 拍板继续推进, 错误处理 v0.7:\n\n新增 src/utils/error-handler.ts (78 行):\n1️⃣ ChainError class (code: RPC_DOWN/INVALID_BATTLE/TIMEOUT/PARSE_ERROR/UNKNOWN)\n2️⃣ classifyError(e) — 错误分类\n3️⃣ withRetry(fn, {retries, delayMs, onRetry}) — 指数退避重试\n4️⃣ errorMessage(e) — 用户友好提示 (🌐/⏱/❌/⚠️)\n\nreader.ts 加重试:\n1️⃣ import withRetry + classifyError\n2️⃣ getBattle() 包装 withRetry (3 次, 500ms 起步)\n3️⃣ catch 用 classifyError 分类 + 抛出 (不静默 null)\n\n🤖 Agent: Talus (听风)\n📋 Task: v0.7 错误处理层\" 2>&1 | head -5\necho \"\"\n\ngit push origin master:main 2>&1 | tail -3\necho \"\"\n\ngit fetch origin main 2>&1 | tail -2
_POOL: 4,\n    PLATFORM: 5,\n    AMBASSADOR: 6,\n    GATE: 7,\n    UPGRADE: 8,\n    RESERVE: 9,\n  },\n} as const;\n\n// 事件签名(用于 eth_getLogs filter topics)\nexport const EVENT_SIGNATURES = {\n  REVENUE_DISTRIBUTED: 'RevenueDistributed(bytes32,uint8,address,bytes32,uint256)',\n  BATTLE_CREATED: 'BattleCreated(bytes32,address,address,bytes32,bytes32,uint256)',\n  BATTLE_ENDED: 'BattleEnded(bytes32,address)',\n  REVENUE_CLAIMED: 'RevenueClaimed(address,uint256)',\n} as const;\n"}}],"api":"anthropic-messages","provider":"minimax-portal","model":"MiniMax-M3","usage":{"input":1803,"output":987,"cacheRead":70482,"cacheWrite":0,"totalTokens":73272,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1780552203797,"responseId":"0670450c4a6d0d0bab687e854ed5242b"}}

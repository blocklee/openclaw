{"type":"message","id":"c4ecd152","parentId":"2417a77f","timestamp":"2026-06-04T05:49:50.055Z","message":{"role":"assistant","content":[{"type":"text","text":"**找到关键证据——源码第 57 行**：\n\n```\nuint8 shareType; // 1=creator, 2=edge, 3=reviewer, 4=public, 5=platform, 6=ambassador, 7=gate, 8=upgrade\n```\n\n**shareType 2 = EDGE！但合约实际触发了 shareType=7 (GATE) 和 shareType=8 (UPGRADE)**——**shareType 数字对调了！**\n\n等等，让我重看：\n- 7=gate, 8=upgrade\n- 9=reserve (从源码 244 行 `_recordDistribution(battleId, ..., reserveAmount, 9)`)\n- 但 shareType 注释 1-8 不包括 reserve！reserve 是 shareType=9\n\n所以 9 个 shareType 是：1=creator, 2=edge, 3=reviewer, 4=public, 5=platform, 6=ambassador, 7=gate, 8=upgrade, 9=reserve\n\n**实际触发的事件**：\n- 1=CREATOR 0.0225 ✓\n- 3=REVIEWER 0.004 ✓\n- 4=PUBLIC 0.004 ✓\n- 5=PLATFORM 0.0025 ✓\n- 6=AMBASSADOR 0.0025 ✓\n- 7=GATE 0.03 ✓\n- 8=UPGRADE 0.02 ✓\n- 9=RESERVE 0.002 ✓\n- **2=EDGE 0.0125 缺失！**\n\n**只剩 EDGE 没分配**。让我看 EDGE 在 distributeRevenue 里怎么处理："},{"type":"toolCall","id":"call_function_ofcd2wb8opr7_1","name":"exec","arguments":{"command":"echo \"=== 完整 distributeRevenue 函数 ===\"\nsed -n '/function distributeRevenue/,/^    function/p' /tmp/battle-revenue-master.sol | head -80\necho \"\"\necho \"=== 查找 EDGE 分配代码 ===\"\ngrep -nB 2 -A 5 \"edge\\|EDGE\\|shareType.*2\\|share, 2\" /tmp/battle-revenue-master.sol | head -50"}}],"api":"anthropic-messages","provider":"minimax-portal","model":"MiniMax-M3","usage":{"input":68608,"output":472,"cacheRead":114,"cacheWrite":0,"totalTokens":69194,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1780552174878,"responseId":"067044efcaf1bb66d784fd97cf296a14"}}
{"type":"message","id":"bc53bda5","parentId":"c4ecd152","timestamp":"2026-06-04T05:49:50.185Z","message":{"role":"toolResult","toolCallId":"call_function_ofcd2wb8opr7_1","toolName":"exec","content":[{"type":"text","text":"=== 完整 distributeRevenue 函数 ===\n    function distributeRevenue(bytes32 battleId) external {\n        Battle storage battle = battles[battleId];\n        require(battle.winner != address(0), \"E007: Battle not ended\");\n        require(!battle.distributed, \"E007: Already distributed\");\n        require(battle.revenuePool > 0, \"E007: Empty pool\");\n        \n        uint256 totalPool = battle.revenuePool;\n        uint256 remaining = totalPool;\n        \n        // === 第一层扣除 ===\n        uint256 gateAmount = totalPool * GATE_FEE_BPS / 10000;\n        uint256 upgradeAmount = totalPool * UPGRADE_POOL_BPS / 10000;\n        remaining -= gateAmount + upgradeAmount;\n        \n        // 记录第一层分配\n        _recordDistribution(battleId, bytes32(0), address(this), gateAmount, 7);\n        _recordDistribution(battleId, bytes32(0), address(this), upgradeAmount, 8);\n        \n        // === 第二层分配（按势位加权）===\n        // 获取获胜牌组中的卡牌\n        bytes32[] memory winnerCards;\n        if (battle.winner == battle.player1) {\n            winnerCards = deckAssembly.getDeck(battle.deck1).cardNodeIds;\n        } else {\n            winnerCards = deckAssembly.getDeck(battle.deck2).cardNodeIds;\n        }\n        \n        // 计算总势位（简化版：用卡牌数量作为权重）\n        uint256 totalPotential = winnerCards.length * 100; // 每张卡基础势位 100\n        \n        // 创作者分配（按势位加权）\n        uint256 creatorPool = remaining * CREATOR_SHARE_BPS / 10000;\n        for (uint i = 0; i < winnerCards.length; i++) {\n            // TODO: 接入 PotentialOracle 获取真实势位\n            uint256 cardPotential = 100; // 占位\n            uint256 share = creatorPool * cardPotential / totalPotential;\n            \n            // 获取卡牌创作者\n            address creator = deckAssembly.cardMinting().getCard(winnerCards[i]).creator;\n            \n            pendingRevenue[creator] += share;\n            _recordDistribution(battleId, winnerCards[i], creator, share, 1);\n        }\n        \n        // 编排者分配\n        uint256 edgePool = remaining * EDGE_SHARE_BPS / 10000;\n        // TODO: 获取编排边信息，分配给编排者\n        // 占位：将编排者份额暂存合约\n        \n        // 其他份额\n        uint256 reviewerAmount = remaining * REVIEWER_SHARE_BPS / 10000;\n        uint256 publicAmount = remaining * PUBLIC_POOL_BPS / 10000;\n        uint256 platformAmount = remaining * PLATFORM_FEE_BPS / 10000;\n        uint256 ambassadorAmount = remaining * AMBASSADOR_BPS / 10000;\n        uint256 reserveAmount = remaining * RESERVE_BPS / 10000;\n        \n        // 记录分配\n        _recordDistribution(battleId, bytes32(0), address(this), reviewerAmount, 3);\n        _recordDistribution(battleId, bytes32(0), address(this), publicAmount, 4);\n        _recordDistribution(battleId, bytes32(0), address(this), platformAmount, 5);\n        _recordDistribution(battleId, bytes32(0), address(this), ambassadorAmount, 6);\n        _recordDistribution(battleId, bytes32(0), address(this), reserveAmount, 9); // 9=reserve\n        \n        battle.distributed = true;\n        totalRevenueDistributed += totalPool;\n    }\n    \n    function _recordDistribution(\n\n=== 查找 EDGE 分配代码 ===\n22-    // 第二层占总池 = 22.5% + 12.5% + 4% + 4% + 2.5% + 2.5% + 2% = 50% ✓\n23-    uint16 public constant CREATOR_SHARE_BPS = 4500;    // 创作者占剩余 45% = 22.5% of total\n24:    uint16 public constant EDGE_SHARE_BPS = 2500;       // 编排者占剩余 25% = 12.5% of total\n25-    uint16 public constant REVIEWER_SHARE_BPS = 800;    // 审查员占剩余 8% = 4% of total\n26-    uint16 public constant PUBLIC_POOL_BPS = 800;       // 公共池占剩余 8% = 4% of total\n27-    uint16 public constant PLATFORM_FEE_BPS = 500;      // 系统占剩余 5% = 2.5% of total\n28-    uint16 public constant AMBASSADOR_BPS = 500;       // 大使占剩余 5% = 2.5% of total\n29-    uint16 public constant RESERVE_BPS = 400;           // 储备占剩余 4% = 2% of total\n--\n55-        address recipient;\n56-        uint256 amount;\n57:        uint8 shareType; // 1=creator, 2=edge, 3=reviewer, 4=public, 5=platform, 6=ambassador, 7=gate, 8=upgrade\n58-    }\n59-    \n60-    // ============ 状态 ============\n61-    mapping(bytes32 => Battle) public battles;\n62-    mapping(bytes32 => Distribution[]) public battleDistributions;\n--\n226-        \n227-        // 编排者分配\n228:        uint256 edgePool = remaining * EDGE_SHARE_BPS / 10000;\n229-        // TODO: 获取编排边信息，分配给编排者\n230-        // 占位：将编排者份额暂存合约\n231-        \n232-        // 其他份额\n233-        uint256 reviewerAmount = remaining * REVIEWER_SHARE_BPS / 10000;"}],"details":{"status":"completed","exitCode":0,"durationMs":59,"aggregated":"=== 完整 distributeRevenue 函数 ===\n    function distributeRevenue(bytes32 battleId) external {\n        Battle storage battle = battles[battleId];\n        require(battle.winner != address(0), \"E007: Battle not ended\");\n        require(!battle.distributed, \"E007: Already distributed\");\n        require(battle.revenuePool > 0, \"E007: Empty pool\");\n        \n        uint256 totalPool = battle.revenuePool;\n        uint256 remaining = totalPool;\n        \n        // === 第一层扣除 ===\n        uint256 gateAmount = totalPool * GATE_FEE_BPS / 10000;\n        uint256 upgradeAmount = totalPool * UPGRADE_POOL_BPS / 10000;\n        remaining -= gateAmount + upgradeAmount;\n        \n        // 记录第一层分配\n        _recordDistribution(battleId, bytes32(0), address(this), gateAmount, 7);\n        _recordDistribution(battleId, bytes32(0), address(this), upgradeAmount, 8);\n        \n        // === 第二层分配（按势位加权）===\n        // 获取获胜牌组中的卡牌\n        bytes32[] memory winnerCards;\n        if (battle.winner == battle.player1) {\n            winnerCards = deckAssembly.getDeck(battle.deck1).cardNodeIds;\n        } else {\n            winnerCards = deckAssembly.getDeck(battle.deck2).cardNodeIds;\n        }\n        \n        // 计算总势位（简化版：用卡牌数量作为权重）\n        uint256 totalPotential = winnerCards.length * 100; // 每张卡基础势位 100\n        \n        // 创作者分配（按势位加权）\n        uint256 creatorPool = remaining * CREATOR_SHARE_BPS / 10000;\n        for (uint i = 0; i < winnerCards.length; i++) {\n            // TODO: 接入 PotentialOracle 获取真实势位\n            uint256 cardPotential = 100; // 占位\n            uint256 share = creatorPool * cardPotential / totalPotential;\n            \n            // 获取卡牌创作者\n            address creator = deckAssembly.cardMinting().getCard(winnerCards[i]).creator;\n            \n            pendingRevenue[creator] += share;\n            _recordDistribution(battleId, winnerCards[i], creator, share, 1);\n        }\n        \n        // 编排者分配\n        uint256 edgePool = remaining * EDGE_SHARE_BPS / 10000;\n        // TODO: 获取编排边信息，分配给编排者\n        // 占位：将编排者份额暂存合约\n        \n        // 其他份额\n        uint256 reviewerAmount = remaining * REVIEWER_SHARE_BPS / 10000;\n        uint256 publicAmount = remaining * PUBLIC_POOL_BPS / 10000;\n        uint256 platformAmount = remaining * PLATFORM_FEE_BPS / 10000;\n        uint256 ambassadorAmount = remaining * AMBASSADOR_BPS / 10000;\n        uint256 reserveAmount = remaining * RESERVE_BPS / 10000;\n        \n        // 记录分配\n        _recordDistribution(battleId, bytes32(0), address(this), reviewerAmount, 3);\n        _recordDistribution(battleId, bytes32(0), address(this), publicAmount, 4);\n        _recordDistribution(battleId, bytes32(0), address(this), platformAmount, 5);\n        _recordDistribution(battleId, bytes32(0), address(this), ambassadorAmount, 6);\n        _recordDistribution(battleId, bytes32(0), address(this), reserveAmount, 9); // 9=reserve\n        \n        battle.distributed = true;\n        totalRevenueDistributed += totalPool;\n    }\n    \n    function _recordDistribution(\n\n=== 查找 EDGE 分配代码 ===\n22-    // 第二层占总池 = 22.5% + 12.5% + 4% + 4% + 2.5% + 2.5% + 2% = 50% ✓\n23-    uint16 public constant CREATOR_SHARE_BPS = 4500;    // 创作者占剩余 45% = 22.5% of total\n24:    uint16 public constant EDGE_SHARE_BPS = 2500;       // 编排者占剩余 25% = 12.5% of total\n25-    uint16 public constant REVIEWER_SHARE_BPS = 800;    // 审查员占剩余 8% = 4% of total\n26-    uint16 public constant PUBLIC_POOL_BPS = 800;       // 公共池占剩余 8% = 4% of total\n27-    uint16 public constant PLATFORM_FEE_BPS = 500;      // 系统占剩余 5% = 2.5% of total\n28-    uint16 public constant AMBASSADOR_BPS = 500;       // 大使占剩余 5% = 2.5% of total\n29-    uint16 public constant RESERVE_BPS = 400;           // 储备占剩余 4% = 2% of total\n--\n55-        address recipient;\n56-        uint256 amount;\n57:        uint8 shareType; // 1=creator, 2=edge, 3=reviewer, 4=public, 5=platform, 6=ambassador, 7=gate, 8=upgrade\n58-    }\n59-    \n60-    // ============ 状态 ============\n61-    mapping(bytes32 => Battle) public battles;\n62-    mapping(bytes32 => Distribution[]) public battleDistributions;\n--\n226-        \n227-        // 编排者分配\n228:        uint256 edgePool = remaining * EDGE_SHARE_BPS / 10000;\n229-        // TODO: 获取编排边信息，分配给编排者\n230-        // 占位：将编排者份额暂存合约\n231-        \n232-        // 其他份额\n233-        uint256 reviewerAmount = remaining * REVIEWER_SHARE_BPS / 10000;","cwd":"/home/node/.openclaw/workspace"},"isError":false,"timestamp":1780552190179}}
{"type":"message","id":"30059588","parentId":"bc53bda5","timestamp":"2026-06-04T05:50:03.676Z","message":{"role":"assistant","content":[{"type":"text","text":"**找到了**——**EDGE 分配是 TODO 状态，源代码 227-230 行**：\n\n```solidity\n// 编排者分配\nuint256 edgePool = remaining * EDGE_SHARE_BPS / 10000;\n// TODO: 获取编排边信息，分配给编排者\n// 占位：将编排者份额暂存合约\n```\n\n**这就是说，EDGE 0.0125 MEER 算出来了，但没分配/没记录事件，留存在合约里**。\n\n**实际分账结论**：\n- **8 个 shareType 都触发了**（1=CREATOR, 3=REVIEWER, 4=PUBLIC, 5=PLATFORM, 6=AMBASSADOR, 7=GATE, 8=UPGRADE, 9=RESERVE）\n- **shareType=2 (EDGE) 算了但没分配**——是源码 TODO 还没实现\n- **总分配 0.0875 MEER** = 0.1 pool - 0.0125 EDGE（留在合约）\n\n**这是 v2.0 的一个已知 TODO**——不是 Seaman_bot 的错，不是合约错误，是**当前 master 分支合约的逻辑就这样**。\n\n**重新切验证器到 9 权（实际 8 权触发 + 1 TODO）**："},{"type":"toolCall","id":"call_function_vrn8ddqjxfkv_1","name":"exec","arguments":{"command":"# 1. 验证验证器要改成 9 权 + 2 层\ncat /home/node/.openclaw/workspace/echo/frontend-integration/src/config.ts | head -50\necho \"---\"\necho \"现在验证器代码:\"\ncat /home/node/.openclaw/workspace/echo/frontend-integration/src/revenue-validator/validator.ts | head -80"}}],"api":"anthropic-messages","provider":"minimax-portal","model":"MiniMax-M3","usage":{"input":1788,"output":380,"cacheRead":68708,"cacheWrite":0,"totalTokens":70876,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1780552190187,"responseId":"067044fe787de7606a5185a020cd9099"}}
{"type":"message","id":"10c78b7d","parentId":"30059588","timestamp":"2026-06-04T05:50:03.795Z","message":{"role":"toolResult","toolCallId":"call_function_vrn8ddqjxfkv_1","toolName":"exec","content":[{"type":"text","text":"/**\n * ECHO BattleRevenue 集成配置\n * QNG 主网配置\n */\n\nexport const CONFIG = {\n  // QNG 主网 WebSocket 端点\n  WS_ENDPOINT: 'wss://qng.rpc.qitmeer.io/ws',\n\n  // BattleRevenue 合约地址\n  BATTLE_REVENUE_ADDRESS: '0xd57806aF985650c002e5E51e203F69c4ca14e4f6',\n\n  // 心跳 ping 间隔(毫秒)- Seaman_bot 建议 30s\n  PING_INTERVAL_MS: 30_000,\n\n  // 断连重试:指数退避 1s → 2s → 4s → 8s,封顶 30s\n  RECONNECT_DELAYS_MS: [1_000, 2_000, 4_000, 8_000, 30_000],\n\n  // HTTP polling fallback 间隔(QNG 约 12s 一个块)\n  POLL_INTERVAL_MS: 12_000,\n\n  // 分账比例（基点 bps，总和 10000 = 100%）\n  // v2.0 7 权版（github main 源码 contracts/battle-of-potential/BattleRevenue.sol, Talus 04:43 UTC grep + RPC 验证）\n  //   CREATOR 45% + EDGE 25% + REVIEWER 8% + PUBLIC_POOL 8% + PLATFORM 5% + AMBASSADOR 5% + RESERVE 4% = 100%\n  // 注意：CREATOR 45% 还要再按 cardPotential/totalPotential 细分给具体创作者\n  // 错误历史：v1.2 4 权（PLATFORM 10%）已废，Seaman_bot \"GATE 30% + UPGRADE 20% 两层\" 源码不存在\n  SHARE_BPS: {\n    CREATOR: 4500,     // 45% — 牌组创作者（再细分）\n    EDGE: 2500,        // 25% — 编排者\n    REVIEWER: 800,     //  8% — 审查员\n    PUBLIC_POOL: 800,  //  8% — 公共池\n    PLATFORM: 500,     //  5% — 系统费\n    AMBASSADOR: 500,   //  5% — 大使\n    RESERVE: 400,      //  4% — 储备\n  },\n\n  // shareType 编号（与合约 _recordDistribution 调用一致）\n  SHARE_TYPE: {\n    CREATOR: 1,\n    EDGE: 2,\n    REVIEWER: 3,\n    PUBLIC_POOL: 4,\n    PLATFORM: 5,\n    AMBASSADOR: 6,\n    RESERVE: 7,\n  },\n} as const;\n\n// 事件签名(用于 eth_getLogs filter topics)\nexport const EVENT_SIGNATURES = {\n---\n现在验证器代码:\n/**\n * 分账验证器 - 验证 BattleRevenue 合约的 7 权分账逻辑\n *\n * 7 个 shareType (从 .sol 源编译提取):\n *   1=CREATOR (45%, 还要按 cardPotential/totalPotential 细分)\n *   2=EDGE (25%)\n *   3=REVIEWER (8%)\n *   4=PUBLIC_POOL (8%)\n *   5=PLATFORM (5%)\n *   6=AMBASSADOR (5%)\n *   7=RESERVE (4%)\n *   合计 100% ✓\n *\n * 4 个验证场景:\n * 1. RevenueDistributed 事件 → 核对 on-chain amount vs 预期计算值\n * 2. claimRevenue 后 getPendingRevenue 应为 0\n * 3. createBattle → joinBattle 流程完整性\n * 4. endBattle 后 revenuePool 累计 vs distributeRevenue 总额一致\n */\n\nimport { Contract, Provider } from 'ethers';\nimport { CONFIG, SHARE_TYPE } from '../config';\nimport { RawLog } from '../event-subscriber/ws-client';\n\nexport interface Distribution {\n  battleId: string;\n  shareType: number;  // 1-7, 见 SHARE_TYPE\n  recipient: string;\n  nodeId: string;\n  amount: bigint;\n}\n\nexport interface BattleSummary {\n  battleId: string;\n  player1: string;\n  player2: string;\n  deck1: string;\n  deck2: string;\n  betAmount: bigint;\n  revenuePool: bigint;\n  winner?: string;\n  endedAt?: number;\n  distributions?: Distribution[];\n}\n\nexport interface ValidationResult {\n  ok: boolean;\n  errors: string[];\n}\n\n// 7 个 shareType 的预期 bps (v2.0 7 权版)\nconst SHARE_BPS_MAP: Record<number, number> = {\n  [SHARE_TYPE.CREATOR]: CONFIG.SHARE_BPS.CREATOR,\n  [SHARE_TYPE.EDGE]: CONFIG.SHARE_BPS.EDGE,\n  [SHARE_TYPE.REVIEWER]: CONFIG.SHARE_BPS.REVIEWER,\n  [SHARE_TYPE.PUBLIC_POOL]: CONFIG.SHARE_BPS.PUBLIC_POOL,\n  [SHARE_TYPE.PLATFORM]: CONFIG.SHARE_BPS.PLATFORM,\n  [SHARE_TYPE.AMBASSADOR]: CONFIG.SHARE_BPS.AMBASSADOR,\n  [SHARE_TYPE.RESERVE]: CONFIG.SHARE_BPS.RESERVE,\n};\n\nexport class RevenueValidator {\n  private contract: Contract;\n\n  constructor(provider: Provider, contractAddress = CONFIG.BATTLE_REVENUE_ADDRESS) {\n    // 占位 ABI,调用方法时由链上/测试桩注入\n    this.contract = new Contract(contractAddress, [], provider);\n  }\n\n  /**\n   * 场景 1：RevenueDistributed 事件金额核对\n   * 期望 amount = revenuePool * bpsShare / 10000\n   * v2.0 7 权模型: CREATOR 45% / EDGE 25% / REVIEWER 8% / PUBLIC_POOL 8% / PLATFORM 5% / AMBASSADOR 5% / RESERVE 4%\n   * 注意：CREATOR 还要再按 cardPotential/totalPotential 细分给具体创作者，\n   *       这里的“CREATOR pool”是分配前的 pool 总额\n   */\n  verifyDistribution(\n    battle: BattleSummary,\n    distribution: Distribution\n  ): ValidationResult {"}],"details":{"status":"completed","exitCode":0,"durationMs":49,"aggregated":"/**\n * ECHO BattleRevenue 集成配置\n * QNG 主网配置\n */\n\nexport const CONFIG = {\n  // QNG 主网 WebSocket 端点\n  WS_ENDPOINT: 'wss://qng.rpc.qitmeer.io/ws',\n\n  // BattleRevenue 合约地址\n  BATTLE_REVENUE_ADDRESS: '0xd57806aF985650c002e5E51e203F69c4ca14e4f6',\n\n  // 心跳 ping 间隔(毫秒)- Seaman_bot 建议 30s\n  PING_INTERVAL_MS: 30_000,\n\n  // 断连重试:指数退避 1s → 2s → 4s → 8s,封顶 30s\n  RECONNECT_DELAYS_MS: [1_000, 2_000, 4_000, 8_000, 30_000],\n\n  // HTTP polling fallback 间隔(QNG 约 12s 一个块)\n  POLL_INTERVAL_MS: 12_000,\n\n  // 分账比例（基点 bps，总和 10000 = 100%）\n  // v2.0 7 权版（github main 源码 contracts/battle-of-potential/BattleRevenue.sol, Talus 04:43 UTC grep + RPC 验证）\n  //   CREATOR 45% + EDGE 25% + REVIEWER 8% + PUBLIC_POOL 8% + PLATFORM 5% + AMBASSADOR 5% + RESERVE 4% = 100%\n  // 注意：CREATOR 45% 还要再按 cardPotential/totalPotential 细分给具体创作者\n  // 错误历史：v1.2 4 权（PLATFORM 10%）已废，Seaman_bot \"GATE 30% + UPGRADE 20% 两层\" 源码不存在\n  SHARE_BPS: {\n    CREATOR: 4500,     // 45% — 牌组创作者（再细分）\n    EDGE: 2500,        // 25% — 编排者\n    REVIEWER: 800,     //  8% — 审查员\n    PUBLIC_POOL: 800,  //  8% — 公共池\n    PLATFORM: 500,     //  5% — 系统费\n    AMBASSADOR: 500,   //  5% — 大使\n    RESERVE: 400,      //  4% — 储备\n  },\n\n  // shareType 编号（与合约 _recordDistribution 调用一致）\n  SHARE_TYPE: {\n    CREATOR: 1,\n    EDGE: 2,\n    REVIEWER: 3,\n    PUBLIC_POOL: 4,\n    PLATFORM: 5,\n    AMBASSADOR: 6,\n    RESERVE: 7,\n  },\n} as const;\n\n// 事件签名(用于 eth_getLogs filter topics)\nexport const EVENT_SIGNATURES = {\n---\n现在验证器代码:\n/**\n * 分账验证器 - 验证 BattleRevenue 合约的 7 权分账逻辑\n *\n * 7 个 shareType (从 .sol 源编译提取):\n *   1=CREATOR (45%, 还要按 cardPotential/totalPotential 细分)\n *   2=EDGE (25%)\n *   3=REVIEWER (8%)\n *   4=PUBLIC_POOL (8%)\n *   5=PLATFORM (5%)\n *   6=AMBASSADOR (5%)\n *   7=RESERVE (4%)\n *   合计 100% ✓\n *\n * 4 个验证场景:\n * 1. RevenueDistributed 事件 → 核对 on-chain amount vs 预期计算值\n * 2. claimRevenue 后 getPendingRevenue 应为 0\n * 3. createBattle → joinBattle 流程完整性\n * 4. endBattle 后 revenuePool 累计 vs distributeRevenue 总额一致\n */\n\nimport { Contract, Provider } from 'ethers';\nimport { CONFIG, SHARE_TYPE } from '../config';\nimport { RawLog } from '../event-subscriber/ws-client';\n\nexport interface Distribution {\n  battleId: string;\n  shareType: number;  // 1-7, 见 SHARE_TYPE\n  recipient: string;\n  nodeId: string;\n  amount: bigint;\n}\n\nexport interface BattleSummary {\n  battleId: string;\n  player1: string;\n  player2: string;\n  deck1: string;\n  deck2: string;\n  betAmount: bigint;\n  revenuePool: bigint;\n  winner?: string;\n  endedAt?: number;\n  distributions?: Distribution[];\n}\n\nexport interface ValidationResult {\n  ok: boolean;\n  errors: string[];\n}\n\n// 7 个 shareType 的预期 bps (v2.0 7 权版)\nconst SHARE_BPS_MAP: Record<number, number> = {\n  [SHARE_TYPE.CREATOR]: CONFIG.SHARE_BPS.CREATOR,\n  [SHARE_TYPE.EDGE]: CONFIG.SHARE_BPS.EDGE,\n  [SHARE_TYPE.REVIEWER]: CONFIG.SHARE_BPS.REVIEWER,\n  [SHARE_TYPE.PUBLIC_POOL]: CONFIG.SHARE_BPS.PUBLIC_POOL,\n  [SHARE_TYPE.PLATFORM]: CONFIG.SHARE_BPS.PLATFORM,\n  [SHARE_TYPE.AMBASSADOR]: CONFIG.SHARE_BPS.AMBASSADOR,\n  [SHARE_TYPE.RESERVE]: CONFIG.SHARE_BPS.RESERVE,\n};\n\nexport class RevenueValidator {\n  private contract: Contract;\n\n  constructor(provider: Provider, contractAddress = CONFIG.BATTLE_REVENUE_ADDRESS) {\n    // 占位 ABI,调用方法时由链上/测试桩注入\n    this.contract = new Contract(contractAddress, [], provider);\n  }\n\n  /**\n   * 场景 1：RevenueDistributed 事件金额核对\n   * 期望 amount = revenuePool * bpsShare / 10000\n   * v2.0 7 权模型: CREATOR 45% / EDGE 25% / REVIEWER 8% / PUBLIC_POOL 8% / PLATFORM 5% / AMBASSADOR 5% / RESERVE 4%\n   * 注意：CREATOR 还要再按 cardPotential/totalPotential 细分给具体创作者，\n   *       这里的“CREATOR pool”是分配前的 pool 总额\n   */\n  verifyDistribution(\n    battle: BattleSummary,\n    distribution: Distribution\n  ): ValidationResult {","cwd":"/home/node/.openclaw/workspace"},"isError":false,"timestamp":1780552203787}}

{"type":"message","id":"7d111e37","parentId":"37eb24ac","timestamp":"2026-06-04T04:35:54.934Z","message":{"role":"toolResult","toolCallId":"call_function_wzsm5geyhyo5_1","toolName":"message","content":[{"type":"text","text":"{\"ok\":true,\"channel\":\"feishu\",\"action\":\"send\",\"messageId\":\"om_x100b6d24446578a8c0189e64856aa2f\",\"chatId\":\"oc_76f7651cb976ad84d66158beb2f29be2\",\"receipt\":{\"primaryPlatformMessageId\":\"om_x100b6d24446578a8c0189e64856aa2f\",\"platformMessageIds\":[\"om_x100b6d24446578a8c0189e64856aa2f\"],\"parts\":[{\"platformMessageId\":\"om_x100b6d24446578a8c0189e64856aa2f\",\"kind\":\"text\",\"index\":0,\"threadId\":\"oc_76f7651cb976ad84d66158beb2f29be2\",\"raw\":{\"channel\":\"feishu\",\"messageId\":\"om_x100b6d24446578a8c0189e64856aa2f\",\"chatId\":\"oc_76f7651cb976ad84d66158beb2f29be2\",\"conversationId\":\"oc_76f7651cb976ad84d66158beb2f29be2\"}}],\"threadId\":\"oc_76f7651cb976ad84d66158beb2f29be2\",\"sentAt\":1780547754778,\"raw\":[{\"channel\":\"feishu\",\"messageId\":\"om_x100b6d24446578a8c0189e64856aa2f\",\"chatId\":\"oc_76f7651cb976ad84d66158beb2f29be2\",\"conversationId\":\"oc_76f7651cb976ad84d66158beb2f29be2\"}]}}"}],"details":{"ok":true,"channel":"feishu","action":"send","messageId":"om_x100b6d24446578a8c0189e64856aa2f","chatId":"oc_76f7651cb976ad84d66158beb2f29be2","receipt":{"primaryPlatformMessageId":"om_x100b6d24446578a8c0189e64856aa2f","platformMessageIds":["om_x100b6d24446578a8c0189e64856aa2f"],"parts":[{"platformMessageId":"om_x100b6d24446578a8c0189e64856aa2f","kind":"text","index":0,"threadId":"oc_76f7651cb976ad84d66158beb2f29be2","raw":{"channel":"feishu","messageId":"om_x100b6d24446578a8c0189e64856aa2f","chatId":"oc_76f7651cb976ad84d66158beb2f29be2","conversationId":"oc_76f7651cb976ad84d66158beb2f29be2"}}],"threadId":"oc_76f7651cb976ad84d66158beb2f29be2","sentAt":1780547754778,"raw":[{"channel":"feishu","messageId":"om_x100b6d24446578a8c0189e64856aa2f","chatId":"oc_76f7651cb976ad84d66158beb2f29be2","conversationId":"oc_
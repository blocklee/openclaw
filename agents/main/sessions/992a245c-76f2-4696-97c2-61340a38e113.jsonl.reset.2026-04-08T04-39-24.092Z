{"type":"message","id":"e65af561","parentId":"f8be396a","timestamp":"2026-04-07T08:56:55.527Z","message":{"role":"assistant","content":[{"type":"toolCall","id":"call_rmyrkyod5i168c9ze79mrg82","name":"write","arguments":{"path":"/home/node/.openclaw/workspace/echonexus/src/components/Footer.tsx","content":"import React from 'react';\nimport { Github, Twitter, Globe, MessageSquare } from 'lucide-react';\n\nexport const Footer: React.FC = () => {\n  return (\n    <footer className=\"bg-dark text-white py-12\">\n      <div className=\"container mx-auto px-4\">\n        <div className=\"flex flex-col md:flex-row justify-between items-center mb-8\">\n          <div className=\"flex items-center gap-2 mb-6 md:mb-0\">\n            <div className=\"w-10 h-10 rounded-lg bg-white flex items-center justify-center text-primary font-bold text-xl\">E</div>\n            <h2 className=\"text-2xl font-bold\">EchoNexus</h2>\n          </div>\n          <div className=\"flex gap-6\">\n            <a href=\"#\" className=\"text-gray-400 hover:text-white transition-colors\">\n              <Github size={24} />\n            </a>\n            <a href=\"#\" className=\"text-gray-400 hover:text-white transition-colors\">\n              <Twitter size={24} />\n            </a>\n            <a href=\"#\" className=\"text-gray-400 hover:text-white transition-colors\">\n              <MessageSquare size={24} />\n            </a>\n            <a href=\"#\" className=\"text-gray-400 hover:text-white transition-colors\">\n              <Globe size={24} />\n            </a>\n          </div>\n        </div>\n        <div className=\"border-t border-gray-700 pt-8 text-center text-gray-400 text-sm\">\n          <p>© 2026 EchoNexus. 能力即资产，调用即分润。</p>\n          <p className=\"mt-2\">\n            <a href=\"#\" className=\"text-primary hover:underline\">文档</a> | \n            <a href=\"#\" className=\"text-primary hover:underline ml-2\">GitHub</a> | \n            <a href=\"#\" className=\"text-primary hover:underline ml-2\">协议</a>\n          </p>\n        </div>\n      </div>\n    </footer>\n  );\n};\n"}}],"api":"openai-completions","provider":"volcengine-plan","model":"ark-code-latest","usage":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"totalTokens":0,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1775552199934,"responseId":"02177555220037176a6743aa0fde56972f5060a904fa2187713e0"}}

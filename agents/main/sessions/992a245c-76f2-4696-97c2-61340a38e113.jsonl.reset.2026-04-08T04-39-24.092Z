{"type":"message","id":"a079ce71","parentId":"4fba490d","timestamp":"2026-04-07T08:57:41.975Z","message":{"role":"assistant","content":[{"type":"toolCall","id":"call_4h5yynxbal2vl6nzeu82fhhy","name":"write","arguments":{"path":"/home/node/.openclaw/workspace/echonexus/src/components/RevenueChart.tsx","content":"import React from 'react';\nimport { LineChart, Line, XAxis, YAxis, CartesianGrid, Tooltip, ResponsiveContainer, AreaChart, Area } from 'recharts';\n\ninterface RevenueChartProps {\n  data: { date: string; revenue: number; uses: number }[];\n}\n\nexport const RevenueChart: React.FC<RevenueChartProps> = ({ data }) => {\n  return (\n    <div className=\"h-64 w-full\">\n      <ResponsiveContainer width=\"100%\" height=\"100%\">\n        <AreaChart data={data}>\n          <defs>\n            <linearGradient id=\"colorRevenue\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n              <stop offset=\"5%\" stopColor=\"#4f46e5\" stopOpacity={0.8}/>\n              <stop offset=\"95%\" stopColor=\"#4f46e5\" stopOpacity={0}/>\n            </linearGradient>\n          </defs>\n          <CartesianGrid strokeDasharray=\"3 3\" />\n          <XAxis dataKey=\"date\" />\n          <YAxis />\n          <Tooltip />\n          <Area \n            type=\"monotone\" \n            dataKey=\"revenue\" \n            stroke=\"#4f46e5\" \n            fillOpacity={1} \n            fill=\"url(#colorRevenue)\" \n          />\n        </AreaChart>\n      </ResponsiveContainer>\n    </div>\n  );\n};\n\nexport const UsageChart: React.FC<RevenueChartProps> = ({ data }) => {\n  return (\n    <div className=\"h-64 w-full\">\n      <ResponsiveContainer width=\"100%\" height=\"100%\">\n        <LineChart data={data}>\n          <CartesianGrid strokeDasharray=\"3 3\" />\n          <XAxis dataKey=\"date\" />\n          <YAxis />\n          <Tooltip />\n          <Line \n            type=\"monotone\" \n            dataKey=\"uses\" \n            stroke=\"#7c3aed\" \n            strokeWidth={2}\n            dot={{ r: 3 }}\n          />\n        </LineChart>\n      </ResponsiveContainer>\n    </div>\n  );\n};\n"}}],"api":"openai-completions","provider":"volcengine-plan","model":"ark-code-latest","usage":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"totalTokens":0,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1775552249572,"responseId":"02177555225000876a6743aa0fde56972f5060a904fa2186d123d"}}

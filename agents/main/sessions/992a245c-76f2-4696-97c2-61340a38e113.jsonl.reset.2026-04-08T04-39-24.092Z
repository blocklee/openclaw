div class=\"md:w-1/2 md:pl-8\">\n                                <!-- Empty for right side -->\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Deployment Section -->\n    <section class=\"py-16 bg-white\">\n        <div class=\"container mx-auto px-4\">\n            <div class=\"max-w-3xl mx-auto mb-12 text-center\">\n                <h2 class=\"text-3xl md:text-4xl font-bold mb-4\">部署信息</h2>\n            </div>\n            <div class=\"grid md:grid-cols-2 gap-8 max-w-5xl mx-auto\">\n                <div class=\"bg-light rounded-xl p-6 shadow-sm border border-indigo-100\">\n                    <h3 class=\"text-xl font-semibold mb-4 flex items-center gap-2\">\n                        <i class=\"fa fa-globe text-primary\"></i> 在线 Demo\n                    </h3>\n                    <ul class=\"space-y-3 text-gray-700\">\n                        <li class=\"flex items-center gap-2\">\n                            <i class=\"fa fa-link text-primary\"></i>\n                            <span>URL: <a href=\"https://pubial7bv6tj.space.minimaxi.com\" target=\"_blank\" class=\"text-primary hover:underline\">https://pubial7bv6tj.space.minimaxi.com</a></span>\n                        </li>\n                        <li class=\"flex items-center gap-2\">\n                            <i class=\"fa fa-tag text-primary\"></i>\n                            <span>版本: v2.0</span>\n                        </li>\n                        <li class=\"flex items-center gap-2\">\n                            <i class=\"fa fa-check-circle text-green-500\"></i>\n                            <span>状态: 生产就绪</span>\n                        </li>\n                    </ul>\n                </div>\n                <div class=\"bg-light rounded-xl p-6 shadow-sm border border-indigo-100\">\n                    <h3 class=\"text-xl font-semibold mb-4 flex items-center gap
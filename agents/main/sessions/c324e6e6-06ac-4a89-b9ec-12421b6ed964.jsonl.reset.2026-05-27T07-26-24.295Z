{"type":"message","id":"485af7f9","parentId":"c15f9750","timestamp":"2026-05-27T00:50:31.537Z","message":{"role":"toolResult","toolCallId":"call_function_9g404q0n0ep5_1","toolName":"message","content":[{"type":"text","text":"[... 856 more characters truncate"}],"details":{"ok":true,"channel":"feishu","action":"send","messageId":"om_x100b6e57768754acc37ae1a51f2a6be","chatId":"oc_76f7651cb976ad84d66158beb2f29be2","receipt":{"primaryPlatformMessageId":"om_x100b6e57768754acc37ae1a51f2a6be","platformMessageIds":["om_x100b6e57768754acc37ae1a51f2a6be"],"parts":[{"platformMessageId":"om_x100b6e57768754acc37ae1a51f2a6be","kind":"text","index":0,"threadId":"oc_76f7651cb976ad84d66158beb2f29be2","raw":{"channel":"feishu","messageId":"om_x100b6e57768754acc37ae1a51f2a6be","chatId":"oc_76f7651cb976ad84d66158beb2f29be2","conversationId":"oc_76f7651cb976ad84d66158beb2f29be2"}}],"threadId":"oc_76f7651cb976ad84d66158beb2f29be2","sentAt":1779839876861,"raw":[{"channel":"feishu","messageId":"om_x100b6e57768754acc37ae1a51f2a6be","chatId":"oc_76f7651cb976ad84d66158beb2f29be2","conversationId":"oc_76f7651cb976ad84d66158beb2f29be2"}]}},"isError":false,"timestamp":1779839876945}}

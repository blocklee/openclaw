          \"appSecret\": \"YXsvQgicI06FJkWenoDpggitFT6TCgVq\",\n          \"name\": \"Lucus\",\n          \"domain\": \"lark\"\n        },\n        \"codus\": {\n          \"appId\": \"cli_a9417983f678de17\",\n          \"appSecret\": \"6FMGvf9k9eUGxQ9c32QRp3e8nTacmB6r\",\n          \"name\": \"Codus\",\n          \"domain\": \"lark\"\n        },\n        \"xiaoye\": {\n          \"appId\": \"cli_a965de5a7b78de17\",\n          \"appSecret\": \"kfNGYuW5vlPEL71PwYsK7f8UrMg31WHB\",\n          \"name\": \"xiaoye\",\n          \"domain\": \"lark\"\n        },\n        \"default\": {\n          \"dmPolicy\": \"pairing\",\n          \"groupPolicy\": \"open\"\n        }\n      },\n      \"connectionMode\": \"websocket\",\n      \"reactionNotifications\": \"own\",\n      \"groupAllowFrom\": [\n        \"oc_76f7651cb976ad84d66158beb2f29be2\"\n      ]\n    },\n    \"openclaw-weixin\": {\n      \"channelConfigUpdatedAt\": \"2026-04-27T06:04:52.593Z\",\n      \"enabled\": true\n    }\n  },\n  \"gateway\": {\n    \"port\": 18789,\n    \"mode\": \"local\",\n    \"bind\": \"loopback\",\n    \"controlUi\": {\n      \"enabled\": true,\n      \"allowedOrigins\": [\n        \"http://localhost:18789\",\n        \"http://127.0.0.1:18789\"\n      ],\n      \"allowInsecureAuth\": true\n    },\n    \"auth\": {\n      \"mode\": \"token\",\n      \"token\": \"12ecb07625acf2468a5a6472abdad19f9cf6e409cd17b60996a3144a85e9209b\"\n    },\n    \"tailscale\": {\n      \"mode\": \"off\",\n      \"resetOnExit\": false\n    },\n    \"nodes\": {\n      \"denyCommands\": [\n        \"camera.snap\",\n        \"camera.clip\",\n        \"screen.record\",\n        \"contacts.add\",\n        \"calendar.add\",\n        \"reminders.add\",\n        \"sms.send\"\n      ]\n    }\n  },\n  \"skills\": {\n    \"install\": {\n      \"nodeManager\": \"npm\"\n    }\n  },\n  \"plugins\": {\n    \"allow\": [\n      \"duckduckgo\",\n      \"feishu\",\n      \"google\",\n      \"memory-core\",\n      \"minimax\",\n      \"n
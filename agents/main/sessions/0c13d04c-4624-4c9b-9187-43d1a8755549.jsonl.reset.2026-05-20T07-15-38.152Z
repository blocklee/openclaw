{"type":"message","id":"13b42a2e","parentId":"db94f34f","timestamp":"2026-05-19T11:27:10.601Z","message":{"role":"toolResult","toolCallId":"call-5f78daf8-79a9-461d-a04e-399d3960f26c","toolName":"exec","content":[{"type":"text","text":"/app/dist/extensions/feishu/skills/feishu-doc/references/block-types.md:1\n# Feishu Block Types Reference\n^"}],"details":{"status":"completed","exitCode":0,"durationMs":201,"aggregated":"/app/dist/extensions/feishu/skills/feishu-doc/references/block-types.md:1\n# Feishu Block Types Reference\n^","cwd":"/home/node/.openclaw/workspace"},"isError":false,"timestamp":1779190030601}}

.openclaw/workspace/skills/web3-docs/SKILL.md</location>\n  </skill>\n</available_skills>","systemPromptReport":{"source":"run","generatedAt":1778937631654,"sessionId":"bed09ac4-eb29-4eda-b1a1-aca46c04b9b6","sessionKey":"agent:main:cron:echo-platform-heartbeat","provider":"nvidia","model":"minimaxai/minimax-m2.7","workspaceDir":"/home/node/.openclaw/workspace","bootstrapMaxChars":12000,"bootstrapTotalMaxChars":60000,"bootstrapTruncation":{"warningMode":"once","warningShown":false,"truncatedFiles":0,"nearLimitFiles":0,"totalNearLimit":false},"sandbox":{"mode":"off","sandboxed":false},"systemPrompt":{"chars":18969,"projectContextChars":0,"nonProjectContextChars":18969},"injectedWorkspaceFiles":[],"skills":{"promptChars":12407,"entries":[{"name":"Agent Browser","blockChars":312},{"name":"automation-workflows","blockChars":744},{"name":"binance-hunter","blockChars":286},{"name":"Blockchain","blockChars":275},{"name":"EnvGuard Secret &amp; Credential Scanner","blockChars":306},{"name":"explain-code","blockChars":197},{"name":"feishu-doc","blockChars":264},{"name":"feishu-drive","blockChars":256},{"name":"feishu-perm","blockChars":278},{"name":"feishu-wiki","blockChars":258},{"name":"find-skills","blockChars":324},{"name":"freeride","blockChars":416},{"name":"github","blockChars":280},{"name":"healthcheck","blockChars":245},{"name":"JavaScript","blockChars":249},{"name":"nano-banana-pro","blockChars":335},{"name":"node-connect","blockChars":246},{"name":"nodejs-security-audit","blockChars":444},{"name":"ontology","blockChars":590},{"name":"openclaw-free-models","blockChars":210},{"name":"proactive-agent","blockChars":383},{"name":"react-expert","blockChars":353},{"name":"security-audit","blockChars":428},{"name":"self-improvement","blockChars":633},{"name":"skill-creator","blockChars":231},{"name":"skill-vetter","blockChars":327},{"name":"Solidity","blockChars":246},{"name":"taskflow","blockChars":246},{"name":"taskflow-inbox-triage","blockChars":256},{"name":"tavily","bl
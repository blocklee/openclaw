{"type":"message","id":"5e24b6df","parentId":"a2274e01","timestamp":"2026-05-27T09:39:19.080Z","message":{"role":"user","content":[{"type":"text","text":"Conversation info (untrusted metadata):\n```json\n{\n  \"chat_id\": \"chat:oc_76f7651cb976ad84d66158beb2f29be2\",\n  \"message_id\": \"om_x100b6e5ff2f454b8b4a3446f09d08d1\",\n  \"sender_id\": \"ou_f02645f6c52eb90b1aa0a82d684e896e\",\n  \"conversation_label\": \"Robot Space 【 多Agent 群聊空间】\",\n  \"sender\": \"ou_f02645f6c52eb90b1aa0a82d684e896e\",\n  \"timestamp\": \"Wed 2026-05-27 09:39 UTC\",\n  \"group_subject\": \"Robot Space 【 多Agent 群聊空间】\",\n  \"is_group_chat\": true,\n  \"was_mentioned\": true\n}\n```\n\nSender (untrusted metadata):\n```json\n{\n  \"label\": \"ou_f02645f6c52eb90b1aa0a82d684e896e\",\n  \"id\": \"ou_f02645f6c52eb90b1aa0a82d684e896e\",\n  \"name\": \"ou_f02645f6c52eb90b1aa0a82d684e896e\"\n}\n```\n\n[message_id: om_x100b6e5ff2f454b8b4a3446f09d08d1]\nou_f02645f6c52eb90b1aa0a82d684e896e: @Talus@X7 📎 完整脚本代码如下，Talus/X7 直接复制保存到 /root/.openclaw/workspace/scripts/feishu\\_post.py：\n\\`\\`\\`python\n\\#\\!/usr/bin/env python3\n\"\"\"\nFeishu 群聊发消息脚本（支持 @ 人）\n用法：python3 feishu\\_post.py <chat\\_id\\> <消息内容\\> <要@的open\\_id\\>\n示例：python3 feishu\\_post.py oc\\_xxx \"你好\" ou\\_xxx\n\n依赖：Python 3.x \\+ urllib\n\"\"\"\n\nimport json\nimport sys\nimport urllib.request\n\n\\# 从 openclaw.json 获取 app\\_id 和 app\\_secret\nCONFIG\\_PATH = \"/root/.openclaw/openclaw.json\"\n\ndef get\\_token\\(\\):\n with open\\(CONFIG\\_PATH\\) as f:\n d = json.load\\(f\\)\n app\\_id = d\\['channels'\\]\\['feishu'\\]\\['appId'\\]\n app\\_secret = d\\['channels'\\]\\['feishu'\\]\\['appSecret'\\]\n\n req = urllib.request.Request\\(\n '[https://open.feishu.cn/open\\-apis/auth/v3/tenant\\_access\\_token/internal](https://open.feishu.cn/open-apis/auth/v3/tenant_access_token/internal)',\n data=json.dumps\\(\\{'app\\_id': app\\_id, 'app\\_secret': app\\_secret\\}\\).encode\\(\\),\n headers=\\{'Content\\-Type': 'application/json'\\}\n \\)\n resp = urllib.request.urlopen\\(req\\)\n return json.loads\\(resp.read\\(\\)\\)\\['tenant\\_access\\_token'\\]\n\ndef send\\_post\\(chat\\_id, text, at\\_open\\_id=None\\):\n token = get\\_token\\(\\)\n\n content\\_blocks = \\[\\]\n if at\\_open\\_id:\n content\\_blocks.append\\(\\{\"tag\": \"at\", \"user\\_id\": at\\_open\\_id\\}\\)\n content\\_blocks.append\\(\\{\"tag\": \"text\", \"text\": \" \" \\+ text\\}\\)\n\n content\\_obj = \\{\n \"zh\\_cn\": \\{\n \"title\": \"\",\n \"content\": \\[content\\_blocks\\]\n \\}\n \\}\n\n payload = \\{\n \"receive\\_id\": chat\\_id,\n \"msg\\_type\": \"post\",\n \"content\": json.dumps\\(content\\_obj, ensure\\_ascii=True\\)\n \\}\n\n req = urllib.request.Request\\(\n f'[https://open.feishu.cn/open\\-apis/im/v1/messages?receive\\_id\\_type=chat\\_id](https://open.feishu.cn/open-apis/im/v1/messages?receive_id_type=chat_id)',\n data=json.dumps\\(payload\\).encode\\(\\),\n headers=\\{\n 'Authorization': f'Bearer \\{token\\}',\n 'Content\\-Type': 'application/json'\n \\}\n \\)\n resp = urllib.request.urlopen\\(req\\)\n result = json.loads\\(resp.read\\(\\)\\)\n\n if result.get\\('code'\\) == 0:\n print\\(f\"✅ 发送成功，消息ID: \\{result\\['data'\\]\\['message\\_id'\\]\\}\"\\)\n mentions = result\\['data'\\].get\\('mentions', \\[\\]\\)\n if mentions:\n print\\(f\" @ 已点亮: \\{mentions\\[0\\].get\\('id', 'unknown'\\)\\}\"\\)\n return True\n else:\n print\\(f\"❌ 发送失败: \\{result.get\\('msg', 'unknown error'\\)\\}\"\\)\n return False\n\nif \\_\\_name\\_\\_ == '\\_\\_main\\_\\_':\n if len\\(sys.argv\\) < 3:\n print\\(\"用法: python3 feishu\\_post.py <chat\\_id\\> <消息内容\\> \\[要@的open\\_id\\]\"\\)\n print\\(\"示例: python3 feishu\\_post.py oc\\_xxx '你好' ou\\_xxx\"\\)\n sys.exit\\(1\\)\n\n chat\\_id = sys.argv\\[1\\]\n text = sys.argv\\[2\\]\n at\\_id = sys.argv\\[3\\] if len\\(sys.argv\\) \\> 3 else None\n\n send\\_post\\(chat\\_id, text, at\\_id\\)\n\n\\`\\`\\`\n\n[System: The content may include mention tags in the form <at user_id=\"...\">name</at>. Treat these as real mentions of Feishu entities (users or bots).]\n[System: If user_id is \"ou_2801ea23f2cb858013a8191ad646d332\", that mention refers to you.]\n\n[System: Feishu users mentioned in the incoming message, for context only: \"X7\". Do not notify or mention these users solely because they are listed here.]"}],"timestamp":1779874759050}}
{"type":"message","id":"af67a991","parentId":"5e24b6df","timestamp":"2026-05-27T09:39:24.990Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"Cat.zhou sent the full script code. Let me save it to the correct location. The code has escaped characters (\\ \\, \\(, etc.) which are display artifacts - the actual code doesn't have those. Let me write the proper script to the file.\n","thinkingSignature":"e5610837d2e6f4949e3a485ab4e67167131c110904f95b72d00fc1d9c07166bb"},{"type":"toolCall","id":"call_function_yvc6c53unv43_1","name":"write","arguments":{"content":"#!/usr/bin/env python3\n\"\"\"\nFeishu 群聊发消息脚本（支持 @ 人）\n用法：python3 feishu_post.py <chat_id> <消息内容> <要@的open_id>\n示例：python3 feishu_post.py oc_xxx \"你好\" ou_xxx\n\n依赖：Python 3.x + urllib\n\"\"\"\n\nimport json\nimport sys\nimport urllib.request\n\n# 从 openclaw.json 获取 app_id 和 app_secret\nCONFIG_PATH = \"/root/.openclaw/openclaw.json\"\n\ndef get_token():\n    with open(CONFIG_PATH) as f:\n        d = json.load(f)\n        app_id = d['channels']['feishu']['appId']\n        app_secret = d['channels']['feishu']['appSecret']\n\n    req = urllib.request.Request(\n        'https://open.feishu.cn/open-apis/auth/v3/tenant_access_token/internal',\n        data=json.dumps({'app_id': app_id, 'app_secret': app_secret}).encode(),\n        headers={'Content-Type': 'application/json'}\n    )\n    resp = urllib.request.urlopen(req)\n    return json.loads(resp.read())['tenant_access_token']\n\ndef send_post(chat_id, text, at_open_id=None):\n    token = get_token()\n\n    content_blocks = []\n    if at_open_id:\n        content_blocks.append({\"tag\": \"at\", \"user_id\": at_open_id})\n    content_blocks.append({\"tag\": \"text\", \"text\": \" \" + text})\n\n    content_obj = {\n        \"zh_cn\": {\n            \"title\": \"\",\n            \"content\": [content_blocks]\n        }\n    }\n\n    payload = {\n        \"receive_id\": chat_id,\n        \"msg_type\": \"post\",\n        \"content\": json.dumps(content_obj, ensure_ascii=True)\n    }\n\n    req = urllib.request.Request(\n        'https://open.feishu.cn/open-apis/im/v1/messages?receive_id_type=chat_id',\n        data=json.dumps(payload).encode(),\n        headers={\n            'Authorization': f'Bearer {token}',\n            'Content-Type': 'application/json'\n        }\n    )\n    resp = urllib.request.urlopen(req)\n    result = json.loads(resp.read())\n\n    if result.get('code') == 0:\n        print(f\"✅ 发送成功，消息ID: {result['data']['message_id']}\")\n        mentions = result['data'].get('mentions', [])\n        if mentions:\n            print(f\" @ 已点亮: {mentions[0].get('id', 'unknown')}\")\n        return True\n    else:\n        print(f\"❌ 发送失败: {result.get('msg', 'unknown error')}\")\n        return False\n\nif __name__ == '__main__':\n    if len(sys.argv) < 3:\n        print(\"用法: python3 feishu_post.py <chat_id> <消息内容> [要@的open_id]\")\n        print(\"示例: python3 feishu_post.py oc_xxx '你好' ou_xxx\")\n        sys.exit(1)\n\n    chat_id = sys.argv[1]\n    text = sys.argv[2]\n    at_id = sys.argv[3] if len(sys.argv) > 3 else None\n\n    send_post(chat_id, text, at_id)","path":"/root/.openclaw/workspace/scripts/feishu_post.py"}}],"api":"anthropic-messages","provider":"minimax-portal","model":"MiniMax-M2.7","usage":{"input":1750,"output":780,"cacheRead":59904,"cacheWrite":0,"totalTokens":62434,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1779874759122,"responseId":"0665eec72efe47a34d703e9d974d877e"}}

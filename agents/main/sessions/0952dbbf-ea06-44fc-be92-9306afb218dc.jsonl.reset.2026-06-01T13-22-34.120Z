{"type":"message","id":"cdf198fe","parentId":"b3fa1bd1","timestamp":"2026-05-31T08:02:56.778Z","message":{"role":"toolResult","toolCallId":"call_function_z2vm0c39k0sn_1","toolName":"image_generate","content":[{"type":"text","text":"comfy (default workflow)\n  models: workflow\n  configured: no\n  auth: set COMFY_API_KEY / COMFY_CLOUD_API_KEY to use comfy/*\n  source: static\n  capabilities: editing up to 1 ref\ndeepinfra (default black-forest-labs/FLUX-1-schnell)\n  models: black-forest-labs/FLUX-1-schnell, run-diffusion/Juggernaut-Lightning-Flux, black-forest-labs/FLUX-1-dev, Qwen/Qwen-Image-Max, stabilityai/sdxl-turbo\n  configured: no\n  auth: set DEEPINFRA_API_KEY to use deepinfra/*\n  source: static\n  capabilities: editing up to 1 ref; sizes 512x512, 1024x1024, 1024x1792, 1792x1024\nfal (default fal-ai/flux/dev)\n  models: fal-ai/flux/dev, fal-ai/flux/dev/image-to-image\n  configured: no\n  auth: set FAL_KEY / FAL_API_KEY to use fal/*\n  source: static\n  capabilities: editing up to 10 refs; resolutions 1K/2K/4K; sizes 1024x1024, 1024x1536, 1536x1024, 1024x1792, 1792x1024; aspect ratios 1:1, 4:3, 3:4, 16:9, 9:16; formats png/jpeg\ngoogle (default gemini-3.1-flash-image-preview)\n  models: gemini-3.1-flash-image-preview, gemini-3-pro-image-preview\n  configured: yes\n  auth: set GEMINI_API_KEY / GOOGLE_API_KEY to use google/*\n  source: static\n  capabilities: editing up to 5 refs; resolutions 1K/2K/4K; sizes 1024x1024, 1024x1536, 1536x1024, 1024x1792, 1792x1024; aspect ratios 1:1, 2:3, 3:2, 3:4, 4:3, 4:5, 5:4, 9:16, 16:9, 21:9\nlitellm (default gpt-image-2)\n  models: gpt-image-2\n  configured: no\n  auth: set LITELLM_API_KEY to use litellm/*\n  source: static\n  capabilities: editing up to 5 refs; sizes 256x256, 512x512, 1024x1024, 1024x1536, 1024x1792, 1536x1024, 1792x1024, 2048x2048, 2048x1152, 3840x2160, 2160x3840\nminimax (default image-01)\n  models: image-01\n  configured: yes\n  auth: set MINIMAX_API_KEY to use minimax/*\n  source: static\n  capabilities: editing up to 1 ref; aspect ratios 1:1, 16:9, 4:3, 3:2, 2:3, 3:4, 9:16, 21:9\nminimax-portal (default image-01)\n  models: image-01\n  configured: yes\n  auth: set MINIMAX_OAUTH_TOKEN / MINIMAX_API_KEY to use minimax-portal/*\n  source: static\n  capabilities: editing up to 1 ref; aspect ratios 1:1, 16:9, 4:3, 3:2, 2:3, 3:4, 9:16, 21:9\nopenai (default gpt-image-2)\n  models: gpt-image-2, gpt-image-1.5, gpt-image-1, gpt-image-1-mini\n  configured: yes\n  auth: set OPENAI_API_KEY or configure OpenAI Codex OAuth for openai/gpt-image-2\n  source: static\n  capabilities: editing up to 5 refs; sizes 1024x1024, 1536x1024, 1024x1536, 2048x2048, 2048x1152, 3840x2160, 2160x3840; formats png/jpeg/webp; backgrounds transparent/opaque/auto\nopenrouter (default google/gemini-3.1-flash-image-preview)\n  models: google/gemini-3.1-flash-image-preview, google/gemini-3-pro-image-preview, openai/gpt-5.4-image-2\n  configured: yes\n  auth: set OPENROUTER_API_KEY to use openrouter/*\n  source: static\n  capabilities: editing up to 5 refs; resolutions 1K/2K/4K; aspect ratios 1:1, 2:3, 3:2, 3:4, 4:3, 4:5, 5:4, 9:16, 16:9, 21:9\nvydra (default grok-imagine)\n  models: grok-imagine\n  configured: no\n  auth: set VYDRA_API_KEY to use vydra/*\n  source: static\nxai (default grok-imagine-image)\n  models: grok-imagine-image, grok-imagine-image-quality\n  configured: no\n  auth: set XAI_API_KEY to use xai/*\n  source: static\n  capabilities: editing up to 5 refs; resolutions 1K/2K; aspect ratios 1:1, 16:9, 9:16, 4:3, 3:4, 2:3, 3:2"}],"details":{"persistedDetailsTruncated":true,"originalDetailsBytesAtLeast":8193,"originalDetailKeys":["kind","providers"]},"isError":false,"timestamp":1780214576773}}

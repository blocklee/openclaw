or', console.error);\n  req.write(body);\n  req.end();\n}\n\nmain().catch(console.error);","path":"/home/node/.openclaw/workspace/scripts/create_talus_doc.js"}}],"api":"anthropic-messages","provider":"minimax-portal","model":"MiniMax-M2.7","usage":{"input":250,"output":487,"cacheRead":63478,"cacheWrite":0,"totalTokens":64215,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1779986899462,"responseId":"0667a4d4e57363b0d185c3d50fa2e5b5"}}

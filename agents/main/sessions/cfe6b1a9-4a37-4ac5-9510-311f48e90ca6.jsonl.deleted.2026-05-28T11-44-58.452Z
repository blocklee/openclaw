{"type":"message","id":"cf89359c","parentId":"3955461d","timestamp":"2026-05-25T20:45:36.819Z","message":{"role":"toolResult","toolCallId":"call_function_5o6xzsdne63z_1","toolName":"exec","content":[{"type":"text","text":"{\"threadId\":\"arbitration\",\"messages\":[{\"id\":\"msg_1778975602235_skzwzl\",\"content\":\"**[Heartbeat 23:50 UTC]**\",\"threadId\":\"arbitration\",\"type\":\"message\",\"timestamp\":1778975602235,\"echoAsset\":{\"license\":\"shared\",\"derivativesAllowed\":true,\"version\":1},\"replyTo\":null}],\"total\":773}"}],"details":{"status":"completed","exitCode":0,"durationMs":259,"aggregated":"{\"threadId\":\"arbitration\",\"messages\":[{\"id\":\"msg_1778975602235_skzwzl\",\"content\":\"**[Heartbeat 23:50 UTC]**\",\"threadId\":\"arbitration\",\"type\":\"message\",\"timestamp\":1778975602235,\"echoAsset\":{\"license\":\"shared\",\"derivativesAllowed\":true,\"version\":1},\"replyTo\":null}],\"total\":773}","cwd":"/home/node/.openclaw/workspace"},"isError":false,"timestamp":1779741936815}}

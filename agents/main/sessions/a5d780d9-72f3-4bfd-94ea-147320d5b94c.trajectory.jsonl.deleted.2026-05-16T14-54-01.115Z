/description>\n    <location>~/.openclaw/workspace/skills/web3-docs/SKILL.md</location>\n  </skill>\n</available_skills>","systemPromptReport":{"source":"run","generatedAt":1778919029249,"sessionId":"a5d780d9-72f3-4bfd-94ea-147320d5b94c","sessionKey":"agent:main:cron:echo-platform-heartbeat","provider":"nvidia","model":"minimaxai/minimax-m2.7","workspaceDir":"/home/node/.openclaw/workspace","bootstrapMaxChars":12000,"bootstrapTotalMaxChars":60000,"bootstrapTruncation":{"warningMode":"once","warningShown":false,"truncatedFiles":0,"nearLimitFiles":0,"totalNearLimit":false},"sandbox":{"mode":"off","sandboxed":false},"systemPrompt":{"chars":18969,"projectContextChars":0,"nonProjectContextChars":18969},"injectedWorkspaceFiles":[],"skills":{"promptChars":12407,"entries":[{"name":"Agent Browser","blockChars":312},{"name":"automation-workflows","blockChars":744},{"name":"binance-hunter","blockChars":286},{"name":"Blockchain","blockChars":275},{"name":"EnvGuard Secret &amp; Credential Scanner","blockChars":306},{"name":"explain-code","blockChars":197},{"name":"feishu-doc","blockChars":264},{"name":"feishu-drive","blockChars":256},{"name":"feishu-perm","blockChars":278},{"name":"feishu-wiki","blockChars":258},{"name":"find-skills","blockChars":324},{"name":"freeride","blockChars":416},{"name":"github","blockChars":280},{"name":"healthcheck","blockChars":245},{"name":"JavaScript","blockChars":249},{"name":"nano-banana-pro","blockChars":335},{"name":"node-connect","blockChars":246},{"name":"nodejs-security-audit","blockChars":444},{"name":"ontology","blockChars":590},{"name":"openclaw-free-models","blockChars":210},{"name":"proactive-agent","blockChars":383},{"name":"react-expert","blockChars":353},{"name":"security-audit","blockChars":428},{"name":"self-improvement","blockChars":633},{"name":"skill-creator","blockChars":231},{"name":"skill-vetter","blockChars":327},{"name":"Solidity","blockChars":246},{"name":"taskflow","blockChars":246},{"name":"taskflow-inbox-triage","blockChars":256},{"name":"tavily","blockChars":208},{"name":"ui-ux-pro-max","blockChars":731},{"name":"vitest-testing","blockChars":443},{"name":"weather","blockChars":216},{"name":"web3-docs","blockChars":723}]},"tools":{"listChars":0,"schemaChars":21885,"entries":[{"name":"read","summaryChars":298,"schemaChars":304,"propertiesCount":3},{"name":"edit","summaryChars":326,"schemaChars":834,"propertiesCount":2},{"name":"write","summaryChars":127,"schemaChars":225,"propertiesCount":2},{"name":"exec","summaryChars":446,"schemaChars":1096,"propertiesCount":12},{"name":"process","summaryChars":322,"schemaChars":961,"propertiesCount":12},{"name":"message","summaryChars":321,"schemaChars":6654,"propertiesCount":106},{"name":"image_generate","summaryChars":387,"schemaChars":2169,"propertiesCount":14},{"name":"music_generate","summaryChars":150,"schemaChars":1348,"propertiesCount":11},{"name":"video_generate","summaryChars":225,"schemaChars":3841,"propertiesCount":21},{"name":"sessions_list","summaryChars":225,"schemaChars":432,"propertiesCount":9},{"name":"sessions_history","summaryChars":180,"schemaChars":161,"propertiesCount":3},{"name":"sessions_send","summaryChars":208,"schemaChars":274,"propertiesCount":5},{"name":"sessions_spawn","summaryChars":466,"schemaChars":1559,"propertiesCount":19},{"name":"sessions_yield","summaryChars":97,"schemaChars":60,"propertiesCount":1},{"name":"subagents","summaryChars":105,"schemaChars":191,"propertiesCount":4},{"name":"session_status","summaryChars":336,"schemaChars":89,"propertiesCount":2},{"name":"web_search","summaryChars":93,"schemaChars":425,"propertiesCount":4},{"name":"web_fetch","summaryChars":129,"schemaChars":374,"propertiesCount":3},{"name":"image","summaryChars":201,"schemaChars":342,"propertiesCount":6},{"name":"memory_search","summaryChars":605,"schemaChars":297,"propertiesCount":4},{"name":"memory_get","summaryChars":239,"schemaChars":249,"propertiesCount":4}]}}},"redaction":{"config":{"mode":"redactConfigObject","secretsMask
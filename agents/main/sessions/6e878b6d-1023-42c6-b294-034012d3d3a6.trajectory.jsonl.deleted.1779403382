g up test coverage. Triggers on describe, it, expect, vi.mock, vi.fn, beforeEach, afterEach, vitest.</description>\n    <location>~/.openclaw/workspace/skills/vitest-testing/SKILL.md</location>\n  </skill>\n  <skill>\n    <name>weather</name>\n    <description>Current weather and forecasts with wttr.in via curl for locations, rain, temperature, travel planning.</description>\n    <location>/app/skills/weather/SKILL.md</location>\n  </skill>\n  <skill>\n    <name>web3-docs</name>\n    <description>Up-to-date documentation and code patterns for Solidity, Foundry, Hardhat, Viem, Wagmi, ethers.js, and OpenZeppelin. Use when writing smart contracts, debugging Solidity errors, setting up a Foundry project, writing Viem/Wagmi frontend code, or asking about ERC standards, gas optimization, upgradeable contracts, or any EVM development task. Triggers on: Solidity, Foundry, Hardhat, Viem, Wagmi, ethers.js, OpenZeppelin, ERC-20, ERC-721, ERC-4626, UUPS, proxy patterns, ABI, calldata, smart contract, deploy, cast, forge, anvil, or any EVM/blockchain development question.</description>\n    <location>~/.openclaw/workspace/skills/web3-docs/SKILL.md</location>\n  </skill>\n</available_skills>","systemPromptReport":{"source":"run","generatedAt":1779340418446,"sessionId":"6e878b6d-1023-42c6-b294-034012d3d3a6","sessionKey":"agent:main:feishu:group:oc_76f7651cb976ad84d66158beb2f29be2","provider":"nvidia","model":"minimaxai/minimax-m2.7","workspaceDir":"/home/node/.openclaw/workspace","bootstrapMaxChars":12000,"bootstrapTotalMaxChars":60000,"bootstrapTruncation":{"warningMode":"always","warningShown":false,"truncatedFiles":0,"nearLimitFiles":0,"totalNearLimit":false},"sandbox":{"mode":"off","sandboxed":false},"systemPrompt":{"chars":32671,"projectContextChars":7861,"nonProjectContextChars":24810},"injectedWorkspaceFiles":[{"name":"AGENTS.md","path":"/home/node/.openclaw/workspace/AGENTS.md","missing":false,"rawChars":1940,"injectedChars":1940,"truncated":false},{"name":"SOUL.md","path"
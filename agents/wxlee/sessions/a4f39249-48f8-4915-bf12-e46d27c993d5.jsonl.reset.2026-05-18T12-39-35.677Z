 \"[managed-by=memory-core.short-term-promotion] Promote weighted short-term recalls into MEMORY.md (limit=10, minScore=0.800, minRecallCount=3, minUniqueQueries=3, recencyHalfLifeDays=14, maxAgeDays=30).\",\n      \"enabled\": true,\n      \"createdAtMs\": 1776096382076,\n      \"schedule\": {\n        \"kind\": \"cron\",\n        \"expr\": \"0 3 * * *\",\n        \"tz\": \"Asia/Shanghai\"\n      },\n      \"sessionTarget\": \"isolated\",\n      \"wakeMode\": \"now\",\n      \"payload\": {\n        \"kind\": \"agentTurn\",\n        \"message\": \"__openclaw_memory_core_short_term_promotion_dream__\",\n        \"lightContext\": true\n      },\n      \"delivery\": {\n        \"mode\": \"none\"\n      },\n      \"state\": {}\n    },\n    {\n      \"id\": \"echo-platform-heartbeat\",\n      \"name\": \"ECHO Platform Heartbeat\",\n      \"description\": \"每5分钟检查ECHO协作平台，发现新消息则自动回应\",\n      \"enabled\": true,\n      \"createdAtMs\": 1778862000000,"}],"details":{"status":"completed","exitCode":0,"durationMs":32,"aggregated":"{\n  \"version\": 1,\n  \"jobs\": [\n    {\n      \"id\": \"1c3a7bd5-d835-41d8-a14a-d2970f13d503\",\n      \"name\": \"daily-backup\",\n      \"enabled\": true,\n      \"createdAtMs\": 1774507489594,\n      \"schedule\": {\n        \"kind\": \"cron\",\n        \"expr\": \"0 0 * * *\",\n        \"staggerMs\": 0\n      },\n      \"sessionTarget\": \"isolated\",\n      \"wakeMode\": \"now\",\n      \"payload\": {\n        \"kind\": \"agentTurn\",\n        \"message\": \"执行备份：cd ~/.openclaw && git add -A && git commit -m \\\"auto backup $(date +\\\\%Y-\\\\%m-\\\\%d)\\\" && git push && echo \\\"备份完成\\\"\"\n      },\n      \"delivery\": {\n        \"mode\": \"announce\",\n        \"channel\": \"feishu\",\n        \"to\": \"user:ou_cb5c7afa7e77cafdeaeae1620a2a383a\",\n        \"accountId\": \"lucus\"\n      },\n      \"state\": {}\n    },\n    {\n      \"id\": \"config-backup-8am\",\n      \"name\": \"config-backup-8am\",\n      \"enabled\": true,\n      \"
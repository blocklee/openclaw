│ ├── models/ # 模型管理页面 │ ├── sessions/ # 会话管理页面 │ ├── skills/ # 技能管理页面 │ ├── stats/ # 统计数据页面 │ ├── alerts/ # 告警中心页面 │ └── pixel-office/ # 像素办公室页面 ├── ...\\n<<<END_EXTERNAL_UNTRUSTED_CONTENT id=\\\"4aaf8d1408c1f4a1\\\">>>\",\n      \"siteName\": \"openclawapi.org\"\n    },\n    {\n      \"title\": \"\\n<<<EXTERNAL_UNTRUSTED_CONTENT id=\\\"16ae15b9cc5c6a1a\\\">>>\\nSource: Web Search\\n---\\nOpenClaw and GitHub automation for PR reviews and CI monitoring\\n<<<END_EXTERNAL_UNTRUSTED_CONTENT id=\\\"16ae15b9cc5c6a1a\\\">>>\",\n      \"url\": \"https://lumadock.com/tutorials/openclaw-github-automation-pr-reviews-ci-monitoring\",\n      \"snippet\": \"\\n<<<EXTERNAL_UNTRUSTED_CONTENT id=\\\"f2b967dd810e4513\\\">>>\\nSource: Web Search\\n---\\nUse OpenClaw with GitHub CLI webhooks and Actions to review PRs triage issues monitor CI and post alerts to chat.\\n<<<END_EXTERNAL_UNTRUSTED_CONTENT id=\\\"f2b967dd810e4513\\\">>>\",\n      \"siteName\": \"lumadock.com\"\n    },\n    {\n      \"title\": \"\\n<<<EXTERNAL_UNTRUSTED_CONTENT id=\\\"651c28ac58041f35\\\">>>\\nSource: Web Search\\n---\\nBuilding an AI PR Review Agent with OpenClaw\\n<<<END_EXTERNAL_UNTRUSTED_CONTENT id=\\\"651c28ac58041f35\\\">>>\",\n      \"url\": \"https://pub.towardsai.net/building-an-ai-pr-review-agent-with-openclaw-9787759e9e46\",\n      \"snippet\": \"\\n<<<EXTERNAL_UNTRUSTED_CONTENT id=\\\"1f5202758eafcd41\\\">>>\\nSource: Web Search\\n---\\nCodex excels at code generation. GitHub Copilot completes your lines. OpenClaw does something different: it orchestrates. You define what you want built, and OpenClaw spawns specialized subagents, hands them tools, and coordinates their work. For this project, I started by spawning a subagent and saying, \\\"Build me a PR review tool.\\n<<<END_EXTERNAL_UNTRUSTED_CONTENT id=\\\"1f5202758eafcd41\\\">>>\",\n      \"siteName\": \"pub.towardsai.net\"\n    },\n    {\n      \"title\": \"\\n<<<EXTERNAL_UNTRUSTED_CONTENT id=\\\"b9058f3f8e5ab178\\\">>>\\nSource: Web Search
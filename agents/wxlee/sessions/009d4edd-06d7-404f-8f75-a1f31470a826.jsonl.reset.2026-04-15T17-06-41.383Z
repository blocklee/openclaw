Dashboard, path: '/', description: '系统总览和数据分析' },\\n  { id: 'executor', label: '执行器', icon: Play, path: '/executor', description: 'AI Agent 能力执行和调度' },\\n  { id: 'market', label: '市场', icon: ShoppingCart, path: '/market', description: '能力资产交易和租赁' },\\n  { id: 'settings', label: '设置', icon: Settings, path: '/settings', description: '系统配置和管理' },\\n]\\n\\nconst App: React.FC = () => {\\n  return (\\n    <BrowserRouter>\\n      <div className=\\\"flex h-screen bg-gray-50\\\">\\n        {/* 侧边栏 */}\\n        <aside className=\\\"w-64 bg-white border-r border-gray-200 flex flex-col\\\">\\n          {/* Logo 区域 */}\\n          <div className=\\\"p-6 border-b border-gray-200\\\">\\n            <h1 className=\\\"text-xl font-bold text-gray-900\\\">EchoNexus</h1>\\n            <p className=\\\"text-sm text-gray-500 mt-1\\\">AI Agent 能力资产化平台</p>\\n          </div>\\n\\n          {/* 导航菜单 */}\\n          <nav className=\\\"flex-1 p-4 space-y-2\\\">\\n            {sidebarItems.map((item) => {\\n              const Icon = item.icon\\n              const location = useLocation()\\n              const isActive = location.pathname === item.path\\n\\n              return (\\n                <Link\\n                  key={item.id}\\n                  to={item.path}\\n                  className={`w-full flex items-start p-3 text-left rounded-lg transition-colors ${\\n                    isActive\\n                      ? 'bg-blue-50 text-blue-700 border border-blue-200'\\n                      : 'text-gray-600 hover:bg-gray-50 border border-transparent'\\n                  }`}\\n                >\\n                  <Icon className=\\\"h-5 w-5 mr-3 flex-shrink-0 mt-0.5\\\" />\\n                  <div className=\\\"flex-1\\\">\\n                    <div className=\\\"font-medium\\\">{item.label}</div>\\n                    <div className=\\\"text-xs text-gray-500 mt-0.5\\\">\\n                      {item.description}\\n                    </div>\\n                  </div>\\n                </Link>\\n              )\\n            })}\\n          </nav>\\n\\n          {/* 用户信息 */}\\n          <div className=\\\"p-4 border-t border-gray-200\\\">\\n            <div className=\\\"flex items-center\\\">\\n              <div className=\\\"flex-shrink-0\\\">\\n                <div className=\\\"h-10 w-10 rounded-full bg-blue-100 flex items-center justify-center\\\">\\n                  <Users className=\\\"h-5 w-5 text-blue-600\\\" />\\n                </div>\\n              </div>\\n              <div className=\\\"ml-3\\\">\\n                <p className=\\\"text-sm font-medium text-gray-900\\\">开发者</p>\\n                <p className=\\\"text-xs text-gray-500\\\">0x7a25...488d</p>\\n              </div>\\n            </div>\\n          </div>\\n        </aside>\\n\\n        {/* 主内容区域 */}\\n        <main className=\\\"flex-1 flex flex-col overflow-hidden\\\">\\n          {/* 顶部导航栏 */}\\n          <header className=\\\"bg-white border-b border-gray-200 px-6 py-4 flex items-center justify-between\\\">\\n            <div className=\\\"flex items-center\\\">\\n              <h2 className=\\\"text-lg font-medium text-gray-900\\\">\\n                {sidebarItems.find(item => {\\n                  const location = useLocation()\\n                  return item.path === location.pathname\\n                })?.label}\\n              </h2>\\n            </div>\\n            <div className=\\\"flex items-center space-x-4\\\">\\n              <div className=\\\"relative\\\">\\n                <input\\n                  type=\\\"text\\\"\\n                  placeholder=\\\"搜索...\\\"\\n                  className=\\\"pl-10 pr-4 py-2 rounded-full text-sm border border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent\\\"\\n                />\\n                <div className=\\\"absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none\\\">\\n                  <svg\\n                    className=\\\"h-5 w-5 text-gray-400\
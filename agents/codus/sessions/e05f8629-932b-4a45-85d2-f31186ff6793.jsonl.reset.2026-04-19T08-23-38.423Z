bility-cookbook.md\n-rw-r--r--  1 node node 11022 Apr 13 12:36 clawhub.md\n-rw-r--r--  1 node node  2202 Apr 13 12:36 code-execution.md\n-rw-r--r--  1 node node  3939 Apr 13 12:36 creating-skills.md\n-rw-r--r--  1 node node 13032 Apr 13 12:36 diffs.md\n-rw-r--r--  1 node node  2993 Apr 13 12:36 duckduckgo-search.md\n-rw-r--r--  1 node node  4373 Apr 13 12:36 elevated.md\n-rw-r--r--  1 node node  4490 Apr 13 12:36 exa-search.md\n-rw-r--r--  1 node node 29104 Apr 13 12:36 exec-approvals.md\n-rw-r--r--  1 node node 12646 Apr 13 12:36 exec.md\n-rw-r--r--  1 node node  4048 Apr 13 12:36 firecrawl.md\n-rw-r--r--  1 node node  2659 Apr 13 12:36 gemini-search.md\n-rw-r--r--  1 node node  2658 Apr 13 12:36 grok-search.md\n-rw-r--r--  1 node node  8214 Apr 13 12:36 image-generation.md\n-rw-r--r--  1 node node 11317 Apr 13 12:36 index.md\n-rw-r--r--  1 node node  2830 Apr 13 12:36 kimi-search.md\n-rw-r--r--  1 node node  2695 Apr 13 12:36 llm-task.md\n-rw-r--r--  1 node node 11036 Apr 13 12:36 lobster.md\n-rw-r--r--  1 node node  2973 Apr 13 12:36 loop-detection.md\n-rw-r--r--  1 node node  5084 Apr 13 12:36 media-overview.md\n-rw-r--r--  1 node node  2681 Apr 13 12:36 minimax-search.md\n-rw-r--r--  1 node node  9939 Apr 13 12:36 multi-agent-sandbox-tools.md\n-rw-r--r--  1 node node 12547 Apr 13 12:36 music-generation.md\n-rw-r--r--  1 node node  2259 Apr 13 12:36 ollama-search.md\n-rw-r--r--  1 node node  5454 Apr 13 12:36 pdf.md\n-rw-r--r--  1 node node  6121 Apr 13 12:36 perplexity-search.md\n-rw-r--r--  1 node node 14783 Apr 13 12:36 plugin.md\n-rw-r--r--  1 node node  2729 Apr 13 12:36 reactions.md\n-rw-r--r--  1 node node  3801 Apr 13 12:36 searxng-search.md\n-rw-r--r--  1 node node  5022 Apr 13 12:36 skills-config.md\n-rw-r--r--  1 node node 16492 Apr 13 12:36 skills.md\n-rw-r--r--  1 node node 21560 Apr 13 12:36 slash-commands.md\n-rw-r--r--  1 node node 18996 Apr 13 12:36 subagents.md\n-rw-r--r--  1 node node  4903 Apr 13 12:36 tavily.md\n-rw-r--r--  1 node node  8076
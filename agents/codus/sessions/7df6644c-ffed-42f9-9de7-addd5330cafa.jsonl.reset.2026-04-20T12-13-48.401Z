{"type":"message","id":"6ae7911f","parentId":"818247cf","timestamp":"2026-04-19T15:33:24.969Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"继续创建 TEE 仿真实现。","thinkingSignature":"reasoning_content"},{"type":"toolCall","id":"call_4xfo901tkvpyzrarjcw8xng5","name":"write","arguments":{"path":"/home/node/.openclaw/workspace-codus/skill-tee-prototype/enclave-sim/sgx-simulator.ts","content":"/**\n * SGX 仿真器 - 用于在没有真实 SGX 硬件的情况下开发和测试\n * \n * 注意：这只是一个仿真，用于原型开发\n * 生产环境请使用真实的 Intel SGX 硬件\n */\n\nimport * as crypto from 'crypto';\nimport {\n  EnclaveConfig,\n  AttestationReport,\n  SealedData,\n  EncryptedSkill,\n  SkillExecutionResult\n} from './types';\n\nexport class SGXSimulator {\n  private config: EnclaveConfig;\n  private enclaveId: string;\n  private mrenclave: string;\n  private mrsigner: string;\n  private sealedKeys: Map<string, Buffer> = new Map();\n  private isDebugMode: boolean;\n\n  constructor(config: EnclaveConfig = {}) {\n    this.config = config;\n    this.isDebugMode = config.debug ?? true;\n    \n    // 生成仿真的 Enclave ID 和测量值\n    this.enclaveId = crypto.randomBytes(16).toString('hex');\n    this.mrenclave = this.generateMRENCLAVE();\n    this.mrsigner = this.generateMRSIGNER();\n    \n    console.log(`[SGX-SIM] Enclave created (ID: ${this.enclaveId})`);\n    console.log(`[SGX-SIM] MRENCLAVE: ${this.mrenclave}`);\n    console.log(`[SGX-SIM] MRSIGNER: ${this.mrsigner}`);\n    console.log(`[SGX-SIM] Debug mode: ${this.isDebugMode}`);\n  }\n\n  /**\n   * 生成仿真的 MRENCLAVE (Enclave 代码测量值)\n   */\n  private generateMRENCLAVE(): string {\n    // 在真实 SGX 中，这是 Enclave 代码的 SHA-256 哈希\n    const hash = crypto.createHash('sha256');\n    hash.update('skill-enclave-v1.0.0-simulation');\n    return hash.digest('hex');\n  }\n\n  /**\n   * 生成仿真的 MRSIGNER (签名者测量值)\n   */\n  private generateMRSIGNER(): string {\n    // 在真实 SGX 中，这是签名者公钥的哈希\n    const hash = crypto.createHash('sha256');\n    hash.update('skill-developer-public-key');\n    return hash.digest('hex');\n  }\n\n  /**\n   * 获取远程证明报告\n   */\n  async getAttestation(challenge?: Buffer): Promise<AttestationReport> {\n    // 在真实 SGX 中，这里会调用 Intel 的 quoting enclave\n    const nonce = challenge ?? crypto.randomBytes(32);\n    \n    const reportData = Buffer.concat([\n      nonce,\n      Buffer.from(this.mrenclave, 'hex'),\n      Buffer.from(this.enclaveId)\n    ]);\n    \n    // 仿真签名\n    const signature = crypto\n      .createHmac('sha256', 'simulated-quote-key')\n      .update(reportData)\n      .digest('hex');\n\n    return {\n      mrenclave: this.mrenclave,\n      mrsigner: this.mrsigner,\n      isDebuggable: this.isDebugMode,\n      timestamp: Date.now(),\n      quote: reportData.toString('base64'),\n      signature\n    };\n  }\n\n  /**\n   * 验证远程证明报告\n   */\n  async verifyAttestation(report: AttestationReport): Promise<boolean> {\n    // 在真实场景中，这里会验证 Intel CA 的签名\n    // 并检查 MRENCLAVE 是否在白名单中\n    \n    if (report.mrenclave !== this.mrenclave) {\n      console.error('[SGX-SIM] MRENCLAVE mismatch');\n      return false;\n    }\n    \n    if (report.isDebuggable && !this.isDebugMode) {\n      console.warn('[SGX-SIM] Attestation indicates debug mode');\n    }\n    \n    return true;\n  }\n\n  /**\n   * 密封数据 (Sealing)\n   */\n  async seal(\n    data: Buffer,\n    policy: 'MRENCLAVE' | 'MRSIGNER' = 'MRENCLAVE'\n  ): Promise<SealedData> {\n    // 生成密封密钥\n    const sealKey = this.deriveSealKey(policy);\n    const iv = crypto.randomBytes(12);\n    \n    // 加密数据\n    const cipher = crypto.createCipheriv('aes-256-gcm', sealKey, iv);\n    let ciphertext = cipher.update(data);\n    ciphertext = Buffer.concat([ciphertext, cipher.final()]);\n    const authTag = cipher.getAuthTag();\n    \n    const keyId = crypto.randomBytes(8).toString('hex');\n    this.sealedKeys.set(keyId, sealKey);\n    \n    return {\n      ciphertext: ciphertext.toString('base64'),\n      policy,\n      keyId,\n      iv: iv.toString('base64'),\n      authTag: authTag.toString('base64')\n    };\n  }\n\n  /**\n   * 解封数据\n   */\n  async unseal(sealed: SealedData): Promise<Buffer> {\n    // 获取密封密钥\n    const sealKey = this.sealedKeys.get(sealed.keyId);\n    if (!sealKey) {\n      throw new Error('Sealed key not found - wrong enclave?');\n    }\n    \n    // 验证策略\n    if (!this.verifySealPolicy(sealed.policy)) {\n      throw new Error('Seal policy verification failed');\n    }\n    \n    // 解密\n    const iv = Buffer.from(sealed.iv, 'base64');\n    const authTag = Buffer.from(sealed.authTag, 'base64');\n    const ciphertext = Buffer.from(sealed.ciphertext, 'base64');\n    \n    const decipher = crypto.createDecipheriv('aes-256-gcm', sealKey, iv);\n    decipher.setAuthTag(authTag);\n    \n    let plaintext = decipher.update(ciphertext);\n    plaintext = Buffer.concat([plaintext, decipher.final()]);\n    \n    return plaintext;\n  }\n\n  /**\n   * 派生密封密钥\n   */\n  private deriveSealKey(policy: 'MRENCLAVE' | 'MRSIGNER'): Buffer {\n    const material = policy === 'MRENCLAVE' \n      ? this.mrenclave \n      : this.mrsigner;\n    \n    return crypto\n      .createHash('sha256')\n      .update(material + 'seal-key-salt')\n      .digest();\n  }\n\n  /**\n   * 验证密封策略\n   */\n  private verifySealPolicy(policy: 'MRENCLAVE' | 'MRSIGNER'): boolean {\n    // 在真实 SGX 中，硬件会验证策略\n    // 这里简化为总是返回 true (仿真)\n    return true;\n  }\n\n  /**\n   * 加密 Skill (供开发者使用)\n   */\n  async encryptSkillForEnclave(\n    skillCode: string,\n    targetMrenclave: string\n  ): Promise<EncryptedSkill> {\n    // 生成对称密钥\n    const symmetricKey = crypto.randomBytes(32);\n    const iv = crypto.randomBytes(12);\n    \n    // 加密 Skill 代码\n    const cipher = crypto.createCipheriv('aes-256-gcm', symmetricKey, iv);\n    let ciphertext = cipher.update(skillCode, 'utf8');\n    ciphertext = Buffer.concat([ciphertext, cipher.final()]);\n    const authTag = cipher.getAuthTag();\n    \n    // 仿真：用 Enclave 的公钥加密对称密钥\n    // 在真实场景中，通过 RA 获取 Enclave 公钥\n    const encryptedKey = crypto\n      .publicEncrypt(\n        {\n          key: this.getEnclavePublicKey(),\n          padding: crypto.constants.RSA_PKCS1_OAEP_PADDING,\n          oaepHash: 'sha256'\n        },\n        symmetricKey\n      )\n      .toString('base64');\n    \n    return {\n      ciphertext: ciphertext.toString('base64'),\n      iv: iv.toString('base64'),\n      authTag: authTag.toString('base64'),\n      encryptedKey,\n      mrenclave: targetMrenclave\n    };\n  }\n\n  /**\n   * 在 Enclave 内执行 Skill\n   */\n  async executeSkill(\n    encrypted: EncryptedSkill,\n    input: any\n  ): Promise<SkillExecutionResult> {\n    const startTime = Date.now();\n    \n    try {\n      // 验证 MRENCLAVE\n      if (encrypted.mrenclave !== this.mrenclave) {\n        throw new Error('Skill encrypted for different enclave');\n      }\n      \n      // 解密 Skill (在真实 Enclave 中，这一步在安全区域内)\n      const skillCode = await this.decryptSkillInEnclave(encrypted);\n      \n      // 执行 Skill (沙箱隔离)\n      const output = await this.sandboxExecute(skillCode, input);\n      \n      const executionTime = Date.now() - startTime;\n      \n      return {\n        success: true,\n        output,\n        executionTime\n      };\n    } catch (error) {\n      return {\n        success: false,\n        error: error instanceof Error ? error.message : 'Unknown error',\n        executionTime: Date.now() - startTime\n      };\n    }\n  }\n\n  /**\n   * 在 Enclave 内解密 Skill\n   */\n  private async decryptSkillInEnclave(encrypted: EncryptedSkill): Promise<string> {\n    // 仿真：解密对称密钥\n    const symmetricKey = crypto.privateDecrypt(\n      {\n        key: this.getEnclavePrivateKey(),\n        padding: crypto.constants.RSA_PKCS1_OAEP_PADDING,\n        oaepHash: 'sha256'\n      },\n      Buffer.from(encrypted.encryptedKey, 'base64')\n    );\n    \n    // 解密 Skill 代码\n    const iv = Buffer.from(encrypted.iv, 'base64');\n    const authTag = Buffer.from(encrypted.authTag, 'base64');\n    const ciphertext = Buffer.from(encrypted.ciphertext, 'base64');\n    \n    const decipher = crypto.createDecipheriv('aes-256-gcm', symmetricKey, iv);\n    decipher.setAuthTag(authTag);\n    \n    let plaintext = decipher.update(ciphertext);\n    plaintext = Buffer.concat([plaintext, decipher.final()]);\n    \n    return plaintext.toString('utf8');\n  }\n\n  /**\n   * 沙箱执行 Skill\n   */\n  private async sandboxExecute(code: string, input: any): Promise<any> {\n    // 警告：这只是一个简单的仿真\n    // 生产环境需要使用真正的沙箱 (vm2, isolate, 或真实 TEE)\n    \n    console.log('[SGX-SIM] Executing skill in sandbox...');\n    \n    // 创建一个安全的上下文\n    const context = {\n      input,\n      console: { log: (...args: any[]) => console.log('[Skill]', ...args) }\n    };\n    \n    // 简单的函数执行模式\n    // 假设 Skill 导出一个 default 函数\n    const wrappedCode = `\n      (() => {\n        ${code}\n        \n        // 如果有 default 导出，执行它\n        if (typeof module !== 'undefined' && module.exports) {\n          return typeof module.exports === 'function' \n            ? module.exports(input)\n            : module.exports;\n        }\n        \n        return input;\n      })()\n    `;\n    \n    // 在真实 TEE 中，这里会有硬件级别的隔离\n    // 仿真中我们用 eval (仅用于原型！)\n    const fn = new Function('input', 'console', wrappedCode);\n    return fn(context.input, context.console);\n  }\n\n  /**\n   * 获取 Enclave 公钥 (仿真)\n   */\n  private getEnclavePublicKey(): string {\n    // 在真实场景中，通过远程证明获取\n    return `-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAt7s9876543210abcdef\nghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ1234567890+/=\n-----END PUBLIC KEY-----`;\n  }\n\n  /**\n   * 获取 Enclave 私钥 (仿真)\n   */\n  private getEnclavePrivateKey(): string {\n    // 在真实 SGX 中，私钥永远不会离开 Enclave\n    return `-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQC3uz3zvrkj\n... (仿真密钥) ...\n-----END PRIVATE KEY-----`;\n  }\n\n  /**\n   * 获取当前 MRENCLAVE\n   */\n  getMRENCLAVE(): string {\n    return this.mrenclave;\n  }\n\n  /**\n   * 销毁 Enclave\n   */\n  async destroy(): Promise<void> {\n    this.sealedKeys.clear();\n    console.log(`[SGX-SIM] Enclave ${this.enclaveId} destroyed`);\n  }\n}\n"}}],"api":"openai-completions","provider":"volcengine-plan","model":"doubao-seed-2.0-code","usage":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"totalTokens":0,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1776612744272,"responseId":"02177661274518909495a2a9188cb78a37ff9c09fef68ce7c290b"}}

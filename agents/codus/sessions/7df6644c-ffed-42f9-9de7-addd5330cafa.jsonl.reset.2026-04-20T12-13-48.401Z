{"type":"message","id":"1a5f4725","parentId":"1bfdfd74","timestamp":"2026-04-19T15:35:23.550Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"好的，让我继续创建服务端代码，然后创建一个完整的演示脚本。","thinkingSignature":"reasoning_content"},{"type":"text","text":"现在让我创建后端服务：\n\n\n\n\n"},{"type":"toolCall","id":"call_ja5swvkdnoiwisog1qh0mvh7","name":"write","arguments":{"path":"/home/node/.openclaw/workspace-codus/skill-tee-prototype/services/simulation-server.ts","content":"/**\n * Skill TEE 仿真服务器\n * \n * 这是一个完整的原型服务器，提供以下功能：\n * - Skill 加密/解密\n * - TEE 仿真执行\n * - API 接口\n */\n\nimport express from 'express';\nimport cors from 'cors';\nimport helmet from 'helmet';\nimport { SGXSimulator } from '../enclave-sim/sgx-simulator';\nimport { EncryptedSkill, SkillExecutionResult } from '../enclave-sim/types';\n\nconst app = express();\nconst PORT = process.env.PORT || 3000;\n\n// 中间件\napp.use(helmet());\napp.use(cors());\napp.use(express.json({ limit: '10mb' }));\n\n// 全局 TEE 仿真器实例\nlet enclave: SGXSimulator | null = null;\n\n// ============ 初始化 ============\n\nasync function init() {\n  console.log('=' .repeat(60));\n  console.log('Skill TEE Simulation Server');\n  console.log('=' .repeat(60));\n  \n  // 创建 TEE 仿真器\n  console.log('\\n[1/4] Initializing SGX Simulator...');\n  enclave = new SGXSimulator({ debug: true });\n  \n  // 获取远程证明\n  console.log('\\n[2/4] Getting attestation...');\n  const attestation = await enclave.getAttestation();\n  console.log('✓ Attestation obtained');\n  console.log(`  MRENCLAVE: ${attestation.mrenclave}`);\n  console.log(`  Debug mode: ${attestation.isDebuggable}`);\n  \n  console.log('\\n[3/4] Server ready!');\n  console.log('\\n[4/4] Available endpoints:');\n  console.log('  POST /api/v1/skill/encrypt    - Encrypt a skill');\n  console.log('  POST /api/v1/skill/execute    - Execute a skill');\n  console.log('  GET  /api/v1/enclave/status   - Get enclave status');\n  console.log('  GET  /api/v1/enclave/attestation - Get attestation report');\n  \n  console.log('\\n' + '=' .repeat(60));\n  console.log(`Server running at http://localhost:${PORT}`);\n  console.log('=' .repeat(60) + '\\n');\n}\n\n// ============ API 路由 ============\n\n/**\n * GET /api/v1/enclave/status\n * 获取 Enclave 状态\n */\napp.get('/api/v1/enclave/status', (req, res) => {\n  if (!enclave) {\n    return res.status(500).json({ error: 'Enclave not initialized' });\n  }\n  \n  res.json({\n    success: true,\n    data: {\n      mrenclave: enclave.getMRENCLAVE(),\n      status: 'ready',\n      debug: true\n    }\n  });\n});\n\n/**\n * GET /api/v1/enclave/attestation\n * 获取远程证明报告\n */\napp.get('/api/v1/enclave/attestation', async (req, res) => {\n  if (!enclave) {\n    return res.status(500).json({ error: 'Enclave not initialized' });\n  }\n  \n  try {\n    const challenge = req.query.challenge \n      ? Buffer.from(req.query.challenge as string, 'hex')\n      : undefined;\n      \n    const attestation = await enclave.getAttestation(challenge);\n    \n    res.json({\n      success: true,\n      data: attestation\n    });\n  } catch (error) {\n    res.status(500).json({\n      success: false,\n      error: error instanceof Error ? error.message : 'Unknown error'\n    });\n  }\n});\n\n/**\n * POST /api/v1/skill/encrypt\n * 加密 Skill\n * \n * Request body:\n * {\n *   \"code\": \"function skill(input) { return input; }\",\n *   \"mrenclave\": \"...\" (可选，默认使用当前 Enclave)\n * }\n */\napp.post('/api/v1/skill/encrypt', async (req, res) => {\n  if (!enclave) {\n    return res.status(500).json({ error: 'Enclave not initialized' });\n  }\n  \n  try {\n    const { code, mrenclave } = req.body;\n    \n    if (!code) {\n      return res.status(400).json({\n        success: false,\n        error: 'Skill code is required'\n      });\n    }\n    \n    const targetMrenclave = mrenclave || enclave.getMRENCLAVE();\n    \n    console.log(`[API] Encrypting skill for MRENCLAVE: ${targetMrenclave.substring(0, 16)}...`);\n    \n    const encrypted = await enclave.encryptSkillForEnclave(code, targetMrenclave);\n    \n    res.json({\n      success: true,\n      data: encrypted\n    });\n  } catch (error) {\n    console.error('[API] Encryption error:', error);\n    res.status(500).json({\n      success: false,\n      error: error instanceof Error ? error.message : 'Unknown error'\n    });\n  }\n});\n\n/**\n * POST /api/v1/skill/execute\n * 执行 Skill\n * \n * Request body:\n * {\n *   \"encryptedSkill\": { ... },\n *   \"input\": { ... }\n * }\n */\napp.post('/api/v1/skill/execute', async (req, res) => {\n  if (!enclave) {\n    return res.status(500).json({ error: 'Enclave not initialized' });\n  }\n  \n  try {\n    const { encryptedSkill, input } = req.body;\n    \n    if (!encryptedSkill) {\n      return res.status(400).json({\n        success: false,\n        error: 'Encrypted skill is required'\n      });\n    }\n    \n    console.log('[API] Executing skill in TEE...');\n    console.log(`[API] Input:`, input);\n    \n    const result: SkillExecutionResult = await enclave.executeSkill(\n      encryptedSkill as EncryptedSkill,\n      input\n    );\n    \n    console.log(`[API] Execution complete: ${result.success ? 'success' : 'failed'}`);\n    console.log(`[API] Time: ${result.executionTime}ms`);\n    \n    res.json({\n      success: result.success,\n      data: result.success ? result.output : undefined,\n      error: result.error,\n      executionTime: result.executionTime\n    });\n  } catch (error) {\n    console.error('[API] Execution error:', error);\n    res.status(500).json({\n      success: false,\n      error: error instanceof Error ? error.message : 'Unknown error'\n    });\n  }\n});\n\n/**\n * POST /api/v1/demo/quick\n * 快速演示：加密并立即执行一个 Skill\n */\napp.post('/api/v1/demo/quick', async (req, res) => {\n  if (!enclave) {\n    return res.status(500).json({ error: 'Enclave not initialized' });\n  }\n  \n  try {\n    const { code, input } = req.body;\n    \n    // 默认演示 Skill\n    const defaultCode = `\n// 示例 Skill：处理输入数据\nmodule.exports = function(input) {\n  console.log('Skill received input:', input);\n  \n  // 示例：简单的数据处理\n  const result = {\n    processed: true,\n    input: input,\n    transformed: input ? Object.keys(input).map(k => ({\n      key: k,\n      value: input[k],\n      uppercase: typeof input[k] === 'string' ? input[k].toUpperCase() : input[k]\n    })) : [],\n    timestamp: Date.now()\n  };\n  \n  console.log('Skill output:', result);\n  return result;\n};\n`;\n    \n    const skillCode = code || defaultCode;\n    const skillInput = input || { name: 'test', value: 123 };\n    \n    console.log('[DEMO] Running quick demo...');\n    \n    // 1. 加密\n    console.log('[DEMO] Step 1: Encrypting skill...');\n    const encrypted = await enclave.encryptSkillForEnclave(\n      skillCode,\n      enclave.getMRENCLAVE()\n    );\n    \n    // 2. 执行\n    console.log('[DEMO] Step 2: Executing in TEE...');\n    const result = await enclave.executeSkill(encrypted, skillInput);\n    \n    res.json({\n      success: true,\n      data: {\n        encrypted,\n        execution: result\n      }\n    });\n  } catch (error) {\n    console.error('[DEMO] Error:', error);\n    res.status(500).json({\n      success: false,\n      error: error instanceof Error ? error.message : 'Unknown error'\n    });\n  }\n});\n\n// 健康检查\napp.get('/health', (req, res) => {\n  res.json({ status: 'ok', timestamp: Date.now() });\n});\n\n// 启动服务器\nasync function startServer() {\n  await init();\n  \n  app.listen(PORT, () => {\n    // 服务器已启动\n  });\n}\n\nstartServer().catch(console.error);\n\n// 优雅关闭\nprocess.on('SIGINT', async () => {\n  console.log('\\nShutting down...');\n  if (enclave) {\n    await enclave.destroy();\n  }\n  process.exit(0);\n});\n"}}],"api":"openai-completions","provider":"volcengine-plan","model":"doubao-seed-2.0-code","usage":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"totalTokens":0,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1776612869110,"responseId":"02177661287136509495a2a9188cb78a37ff9c09fef68ce8e71b8"}}

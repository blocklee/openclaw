{"type":"message","id":"6aeb2c90","parentId":"a58bd317","timestamp":"2026-04-19T15:36:24.977Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"好的，现在让我创建一个演示脚本和部署脚本。","thinkingSignature":"reasoning_content"},{"type":"text","text":"现在让我创建演示脚本和部署脚本：\n\n\n\n\n\n"},{"type":"toolCall","id":"call_secnbw3qxgcs1fixi5m8g2ik","name":"write","arguments":{"path":"/home/node/.openclaw/workspace-codus/skill-tee-prototype/scripts/demo.ts","content":"#!/usr/bin/env ts-node\n\n/**\n * Skill TEE 原型演示脚本\n * \n * 运行方法：\n *   npm install\n *   npx ts-node scripts/demo.ts\n */\n\nimport { SGXSimulator } from '../enclave-sim/sgx-simulator';\nimport { EncryptedSkill } from '../enclave-sim/types';\n\n// 演示用的示例 Skill\nconst EXAMPLE_SKILLS = {\n  // 简单的计算器 Skill\n  calculator: `\n// 计算器 Skill\nmodule.exports = function(input) {\n  const { a, b, operation } = input;\n  \n  console.log('Calculating:', a, operation, b);\n  \n  let result;\n  switch (operation) {\n    case 'add': result = a + b; break;\n    case 'subtract': result = a - b; break;\n    case 'multiply': result = a * b; break;\n    case 'divide': result = b !== 0 ? a / b : 'Error: division by zero'; break;\n    default: result = 'Unknown operation';\n  }\n  \n  return {\n    input,\n    result,\n    timestamp: Date.now()\n  };\n};\n`,\n\n  // 字符串处理 Skill\n  stringProcessor: `\n// 字符串处理 Skill\nmodule.exports = function(input) {\n  const { text, transform } = input;\n  \n  console.log('Processing text:', text);\n  \n  let result = text;\n  switch (transform) {\n    case 'uppercase': result = text.toUpperCase(); break;\n    case 'lowercase': result = text.toLowerCase(); break;\n    case 'reverse': result = text.split('').reverse().join(''); break;\n    case 'count': result = { text, length: text.length, words: text.split('\\\\s+').length }; break;\n    default: result = text;\n  }\n  \n  return {\n    original: text,\n    transformed: result,\n    operation: transform,\n    timestamp: Date.now()\n  };\n};\n`,\n\n  // 简单的数据加密 Skill (演示用)\n  dataProcessor: `\n// 数据处理 Skill\nmodule.exports = function(input) {\n  const { data, action } = input;\n  \n  console.log('Processing data with action:', action);\n  \n  // 简单的\"加密\"演示 (仅用于演示，非真实加密)\n  const fakeEncrypt = (str: string) => \n    str.split('').map(c => String.fromCharCode(c.charCodeAt(0) + 1)).join('');\n  \n  const fakeDecrypt = (str: string) => \n    str.split('').map(c => String.fromCharCode(c.charCodeAt(0) - 1)).join('');\n  \n  let result;\n  switch (action) {\n    case 'encrypt':\n      result = typeof data === 'string' ? fakeEncrypt(data) : data;\n      break;\n    case 'decrypt':\n      result = typeof data === 'string' ? fakeDecrypt(data) : data;\n      break;\n    case 'hash':\n      result = 'hash_' + JSON.stringify(data).length;\n      break;\n    default:\n      result = data;\n  }\n  \n  return {\n    action,\n    input: data,\n    output: result,\n    processedInEnclave: true,\n    timestamp: Date.now()\n  };\n};\n`\n};\n\nasync function runDemo() {\n  console.log('=' .repeat(70));\n  console.log('🛡️  Skill TEE 原型演示');\n  console.log('=' .repeat(70));\n  console.log();\n\n  // ============ 阶段 1：初始化 TEE ============\n  console.log('📦 阶段 1：初始化 TEE 仿真环境');\n  console.log('-'.repeat(70));\n  \n  const enclave = new SGXSimulator({ debug: true });\n  \n  // 获取远程证明\n  console.log('\\n📜 获取远程证明报告...');\n  const attestation = await enclave.getAttestation();\n  console.log('✓ 远程证明获取成功');\n  console.log('  MRENCLAVE:', attestation.mrenclave.substring(0, 32) + '...');\n  console.log('  Debug 模式:', attestation.isDebuggable);\n  \n  // ============ 阶段 2：加密 Skill ============\n  console.log('\\n\\n🔐 阶段 2：加密 Skill 代码');\n  console.log('-'.repeat(70));\n  \n  // 选择要演示的 Skill\n  const skillName = 'calculator';\n  const skillCode = EXAMPLE_SKILLS[skillName as keyof typeof EXAMPLE_SKILLS];\n  \n  console.log(`\\n📝 使用 Skill: ${skillName}`);\n  console.log('  代码长度:', skillCode.length, 'bytes');\n  \n  // 加密 Skill\n  console.log('\\n🔒 加密 Skill (使用 Enclave 公钥)...');\n  const encrypted = await enclave.encryptSkillForEnclave(\n    skillCode,\n    enclave.getMRENCLAVE()\n  );\n  \n  console.log('✓ Skill 加密成功');\n  console.log('  加密后大小:', encrypted.ciphertext.length, 'bytes');\n  console.log('  密钥已加密:', encrypted.encryptedKey.substring(0, 40) + '...');\n  \n  // ============ 阶段 3：在 TEE 中执行 ============\n  console.log('\\n\\n⚡ 阶段 3：在 TEE 中执行 Skill');\n  console.log('-'.repeat(70));\n  \n  // 准备输入数据\n  const testInputs = [\n    { name: '计算器-加法', input: { a: 42, b: 58, operation: 'add' } },\n    { name: '计算器-乘法', input: { a: 7, b: 8, operation: 'multiply' } }\n  ];\n  \n  for (const { name, input } of testInputs) {\n    console.log(`\\n▶️  执行: ${name}`);\n    console.log('   输入:', JSON.stringify(input));\n    \n    const result = await enclave.executeSkill(encrypted as EncryptedSkill, input);\n    \n    if (result.success) {\n      console.log('   ✓ 执行成功');\n      console.log('   输出:', JSON.stringify(result.output, null, 6));\n      console.log('   耗时:', result.executionTime, 'ms');\n    } else {\n      console.log('   ✗ 执行失败:', result.error);\n    }\n  }\n  \n  // ============ 阶段 4：测试其他 Skill ============\n  console.log('\\n\\n🧪 阶段 4：测试更多 Skill');\n  console.log('-'.repeat(70));\n  \n  // 测试字符串处理 Skill\n  console.log('\\n📝 测试字符串处理 Skill');\n  const stringEncrypted = await enclave.encryptSkillForEnclave(\n    EXAMPLE_SKILLS.stringProcessor,\n    enclave.getMRENCLAVE()\n  );\n  \n  const stringResult = await enclave.executeSkill(stringEncrypted as EncryptedSkill, {\n    text: 'Hello, TEE World!',\n    transform: 'uppercase'\n  });\n  \n  if (stringResult.success) {\n    console.log('✓ 字符串处理结果:', stringResult.output);\n  }\n  \n  // ============ 阶段 5：密封数据 ============\n  console.log('\\n\\n🔐 阶段 5：Sealing (密钥密封) 演示');\n  console.log('-'.repeat(70));\n  \n  const secretData = Buffer.from('这是需要密封的敏感数据！');\n  console.log('\\n📦 原始数据:', secretData.toString());\n  \n  // 密封数据\n  console.log('🔒 密封数据 (MRENCLAVE 策略)...');\n  const sealed = await enclave.seal(secretData, 'MRENCLAVE');\n  console.log('✓ 数据已密封');\n  console.log('  Key ID:', sealed.keyId);\n  console.log('  密文:', sealed.ciphertext.substring(0, 50) + '...');\n  \n  // 解封数据\n  console.log('\\n🔓 解封数据...');\n  const unsealed = await enclave.unseal(sealed);\n  console.log('✓ 数据已解封');\n  console.log('  结果:', unsealed.toString());\n  \n  // ============ 完成 ============\n  console.log('\\n\\n' + '=' .repeat(70));\n  console.log('✅ 演示完成！');\n  console.log('=' .repeat(70));\n  console.log('\\n📋 总结：');\n  console.log('  ✓ TEE 仿真环境初始化成功');\n  console.log('  ✓ 远程证明 (RA) 工作正常');\n  console.log('  ✓ Skill 加密/解密功能正常');\n  console.log('  ✓ Skill 在 TEE 中执行成功');\n  console.log('  ✓ 数据密封 (Sealing) 功能正常');\n  console.log('\\n🚀 下一步：');\n  console.log('  1. 启动服务端: npm run start:simulation');\n  console.log('  2. 部署智能合约: 参考 contracts/ 目录');\n  console.log('  3. 真实硬件部署: 使用支持 SGX 的云服务器');\n  \n  // 清理\n  await enclave.destroy();\n}\n\n// 运行演示\nrunDemo().catch(error => {\n  console.error('\\n❌ 演示出错:', error);\n  process.exit(1);\n});\n"}}],"api":"openai-completions","provider":"volcengine-plan","model":"doubao-seed-2.0-code","usage":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"totalTokens":0,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1776612923561,"responseId":"02177661292448209495a2a9188cb78a37ff9c09fef68ce354c49"}}

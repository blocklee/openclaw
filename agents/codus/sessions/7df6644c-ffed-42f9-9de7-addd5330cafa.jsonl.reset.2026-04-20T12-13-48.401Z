{"type":"message","id":"1b1bd8ae","parentId":"28d7291a","timestamp":"2026-04-19T15:34:29.100Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"好的，现在让我创建智能合约部分。","thinkingSignature":"reasoning_content"},{"type":"text","text":"现在让我创建智能合约部分：\n\n\n\n\n\n"},{"type":"toolCall","id":"call_dvp3r6q2v0m4ynw3zr5avodt","name":"write","arguments":{"path":"/home/node/.openclaw/workspace-codus/skill-tee-prototype/contracts/SkillRegistry.sol","content":"// SPDX-License-Identifier: MIT\npragma solidity ^0.8.20;\n\nimport \"@openzeppelin/contracts/token/ERC721/ERC721.sol\";\nimport \"@openzeppelin/contracts/token/ERC721/extensions/ERC721URIStorage.sol\";\nimport \"@openzeppelin/contracts/security/Pausable.sol\";\nimport \"@openzeppelin/contracts/access/Ownable.sol\";\n\n/**\n * @title SkillRegistry\n * @dev Skill NFT Registry with permission management and usage tracking\n * \n * Simplified version for prototype - production version should include:\n * - Payment handling (USDC/ETH)\n * - Royalty distribution\n * - More fine-grained permissions\n * - Emergency pause\n */\ncontract SkillRegistry is ERC721, ERC721URIStorage, Pausable, Ownable {\n    \n    // ============ Structs ============\n    \n    struct Skill {\n        uint256 id;\n        string name;\n        address author;\n        string mrenclave;      // Enclave measurement\n        string ipfsCid;        // Encrypted skill on IPFS\n        uint256 usageFee;      // Usage fee in wei (0 = free)\n        uint256 royaltyBps;    // Royalty in basis points (100 = 1%)\n        bool isActive;\n        uint256 totalUses;\n    }\n    \n    enum PermissionType {\n        USE,        // Can use the skill\n        DERIVE,     // Can create derivative works\n        EXTEND      // Can extend/modify the skill\n    }\n    \n    struct Permission {\n        address grantee;\n        PermissionType ptype;\n        uint256 expiresAt;     // 0 = permanent\n        bool isValid;\n    }\n    \n    // ============ State ============\n    \n    mapping(uint256 => Skill) public skills;\n    mapping(uint256 => Permission[]) public permissions;\n    mapping(address => uint256[]) public authorSkills;\n    uint256 public skillCounter;\n    \n    // ============ Events ============\n    \n    event SkillRegistered(\n        uint256 indexed skillId,\n        address indexed author,\n        string name,\n        string mrenclave\n    );\n    \n    event PermissionGranted(\n        uint256 indexed skillId,\n        address indexed grantee,\n        PermissionType ptype,\n        uint256 expiresAt\n    );\n    \n    event PermissionRevoked(\n        uint256 indexed skillId,\n        address indexed grantee,\n        PermissionType ptype\n    );\n    \n    event SkillUsed(\n        uint256 indexed skillId,\n        address indexed user,\n        uint256 fee,\n        uint256 timestamp\n    );\n    \n    // ============ Constructor ============\n    \n    constructor() ERC721(\"SkillNFT\", \"SKILL\") Ownable(msg.sender) {}\n    \n    // ============ Skill Registration ============\n    \n    /**\n     * @dev Register a new skill and mint NFT\n     */\n    function registerSkill(\n        string memory name,\n        string memory mrenclave,\n        string memory ipfsCid,\n        uint256 usageFee,\n        uint256 royaltyBps,\n        string memory tokenURI\n    ) external whenNotPaused returns (uint256) {\n        require(royaltyBps <= 10000, \"Royalty too high (max 100%)\");\n        require(bytes(name).length > 0, \"Name required\");\n        require(bytes(mrenclave).length > 0, \"MRENCLAVE required\");\n        require(bytes(ipfsCid).length > 0, \"IPFS CID required\");\n        \n        skillCounter++;\n        uint256 skillId = skillCounter;\n        \n        skills[skillId] = Skill({\n            id: skillId,\n            name: name,\n            author: msg.sender,\n            mrenclave: mrenclave,\n            ipfsCid: ipfsCid,\n            usageFee: usageFee,\n            royaltyBps: royaltyBps,\n            isActive: true,\n            totalUses: 0\n        });\n        \n        authorSkills[msg.sender].push(skillId);\n        \n        // Mint NFT to author\n        _safeMint(msg.sender, skillId);\n        _setTokenURI(skillId, tokenURI);\n        \n        emit SkillRegistered(skillId, msg.sender, name, mrenclave);\n        \n        return skillId;\n    }\n    \n    // ============ Permission Management ============\n    \n    /**\n     * @dev Grant permission to use/derive/extend a skill\n     */\n    function grantPermission(\n        uint256 skillId,\n        address grantee,\n        PermissionType ptype,\n        uint256 durationSeconds\n    ) external whenNotPaused {\n        require(_isAuthorized(msg.sender, skillId), \"Not authorized\");\n        require(skills[skillId].isActive, \"Skill not active\");\n        require(grantee != address(0), \"Invalid grantee\");\n        \n        uint256 expiresAt = durationSeconds > 0 \n            ? block.timestamp + durationSeconds \n            : 0;\n        \n        permissions[skillId].push(Permission({\n            grantee: grantee,\n            ptype: ptype,\n            expiresAt: expiresAt,\n            isValid: true\n        }));\n        \n        emit PermissionGranted(skillId, grantee, ptype, expiresAt);\n    }\n    \n    /**\n     * @dev Revoke a previously granted permission\n     */\n    function revokePermission(\n        uint256 skillId,\n        address grantee,\n        PermissionType ptype\n    ) external {\n        require(_isAuthorized(msg.sender, skillId), \"Not authorized\");\n        \n        Permission[] storage perms = permissions[skillId];\n        for (uint256 i = 0; i < perms.length; i++) {\n            if (perms[i].grantee == grantee && \n                perms[i].ptype == ptype && \n                perms[i].isValid) {\n                perms[i].isValid = false;\n                emit PermissionRevoked(skillId, grantee, ptype);\n                break;\n            }\n        }\n    }\n    \n    /**\n     * @dev Check if an address has a specific permission\n     */\n    function hasPermission(\n        uint256 skillId,\n        address user,\n        PermissionType ptype\n    ) public view returns (bool) {\n        Skill memory skill = skills[skillId];\n        \n        // Author or NFT owner has all permissions\n        if (skill.author == user || _isAuthorized(user, skillId)) {\n            return true;\n        }\n        \n        // Check explicit permissions\n        Permission[] memory perms = permissions[skillId];\n        for (uint256 i = 0; i < perms.length; i++) {\n            Permission memory perm = perms[i];\n            if (perm.grantee == user && \n                perm.ptype == ptype && \n                perm.isValid &&\n                (perm.expiresAt == 0 || perm.expiresAt > block.timestamp)) {\n                return true;\n            }\n        }\n        \n        return false;\n    }\n    \n    // ============ Skill Usage ============\n    \n    /**\n     * @dev Record skill usage (called by TEE service)\n     */\n    function recordUsage(\n        uint256 skillId,\n        address user\n    ) external payable whenNotPaused returns (bool) {\n        Skill storage skill = skills[skillId];\n        \n        require(skill.isActive, \"Skill not active\");\n        require(hasPermission(skillId, user, PermissionType.USE), \"No permission\");\n        \n        // Check fee (prototype simplified - production needs proper payment handling)\n        if (skill.usageFee > 0) {\n            require(msg.value >= skill.usageFee, \"Insufficient fee\");\n            \n            // Send royalty to author\n            if (skill.royaltyBps > 0) {\n                uint256 royalty = (msg.value * skill.royaltyBps) / 10000;\n                (bool success, ) = skill.author.call{value: royalty}(\"\");\n                require(success, \"Royalty transfer failed\");\n            }\n        }\n        \n        skill.totalUses++;\n        \n        emit SkillUsed(skillId, user, msg.value, block.timestamp);\n        \n        return true;\n    }\n    \n    // ============ Skill Management ============\n    \n    /**\n     * @dev Toggle skill active status\n     */\n    function setSkillActive(uint256 skillId, bool isActive) external {\n        require(_isAuthorized(msg.sender, skillId), \"Not authorized\");\n        skills[skillId].isActive = isActive;\n    }\n    \n    /**\n     * @dev Update skill metadata\n     */\n    function updateSkill(\n        uint256 skillId,\n        string memory ipfsCid,\n        uint256 usageFee,\n        uint256 royaltyBps\n    ) external {\n        require(_isAuthorized(msg.sender, skillId), \"Not authorized\");\n        require(royaltyBps <= 10000, \"Royalty too high\");\n        \n        skills[skillId].ipfsCid = ipfsCid;\n        skills[skillId].usageFee = usageFee;\n        skills[skillId].royaltyBps = royaltyBps;\n    }\n    \n    // ============ Queries ============\n    \n    /**\n     * @dev Get skill details\n     */\n    function getSkill(uint256 skillId) external view returns (Skill memory) {\n        return skills[skillId];\n    }\n    \n    /**\n     * @dev Get all skills by author\n     */\n    function getAuthorSkills(address author) external view returns (uint256[] memory) {\n        return authorSkills[author];\n    }\n    \n    /**\n     * @dev Get all permissions for a skill\n     */\n    function getPermissions(uint256 skillId) external view returns (Permission[] memory) {\n        return permissions[skillId];\n    }\n    \n    // ============ Admin ============\n    \n    function pause() public onlyOwner {\n        _pause();\n    }\n    \n    function unpause() public onlyOwner {\n        _unpause();\n    }\n    \n    // ============ ERC721 Overrides ============\n    \n    function tokenURI(uint256 tokenId)\n        public\n        view\n        override(ERC721, ERC721URIStorage)\n        returns (string memory)\n    {\n        return super.tokenURI(tokenId);\n    }\n    \n    function supportsInterface(bytes4 interfaceId)\n        public\n        view\n        override(ERC721, ERC721URIStorage)\n        returns (bool)\n    {\n        return super.supportsInterface(interfaceId);\n    }\n    \n    // ============ Internal ============\n    \n    /**\n     * @dev Check if address is authorized (owner or approved)\n     */\n    function _isAuthorized(address user, uint256 tokenId) internal view returns (bool) {\n        return user == ownerOf(tokenId) || \n               user == getApproved(tokenId) ||\n               isApprovedForAll(ownerOf(tokenId), user) ||\n               user == skills[tokenId].author;\n    }\n}\n"}}],"api":"openai-completions","provider":"volcengine-plan","model":"doubao-seed-2.0-code","usage":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"totalTokens":0,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1776612804979,"responseId":"02177661280630509495a2a9188cb78a37ff9c09fef68cebad384"}}
